4\u062d\u0635\u0631 \u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0648\u062c\u0631\u062f \u0627\u0644\u0645\u062d\u062a\u0648\u0649.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cb>\u0646\u0642\u0627\u0637 \u062c\u062f\u064a\u0631\u0629 \u0628\u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0629\\x3C/b>\\x3C/p>\\n\\x3Cul>\\n\\x3Cli style=\\\"font-weight: 400;\\\">\\x3Cspan style=\\\"font-weight: 400;\\\">\u062a\u0645\u062d\u0648\u0631\u062a \u0645\u0639\u0638\u0645 \u0645\u0634\u0643\u0644\u0627\u062a \u0627\u0644\u0645\u0648\u0642\u0639 \u062d\u0648\u0644 \u0645\u0634\u0627\u0643\u0644 \u0628\u0646\u064a\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a.\\x3C/span>\\x3C/li>\\n\\x3Cli style=\\\"font-weight: 400;\\\">\\x3Cspan style=\\\"font-weight: 400;\\\">\u0643\u0627\u0646\u062a \u0639\u062f\u0629 \u062a\u0633\u0645\u064a\u0627\u062a \u063a\u064a\u0631 \u0648\u0627\u0636\u062d\u0629 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0645\u0645\u0627 \u062c\u0639\u0644\u0647\u0645 \u064a\u062c\u062f\u0648\u0646 \u0635\u0639\u0648\u0628\u0629 \u0641\u064a \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a.\\x3C/span>\\x3C/li>\\n\\x3Cli style=\\\"font-weight: 400;\\\">\\x3Cspan style=\\\"font-weight: 400;\\\">\u0643\u0627\u0646 \u0641\u064a \u0627\u0644\u0645\u0648\u0642\u0639 \u0639\u062f\u0645 \u0627\u062a\u0633\u0627\u0642 \u0644\u063a\u0648\u064a (\u0631\u0633\u0627\u0644\u0629 \u062e\u0637\u0623 \u0628\u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0641\u064a \u0648\u0627\u062c\u0647\u0629 \u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629) \u0648\u0639\u062f\u0645 \u0627\u062a\u0633\u0627\u0642 \u0628\u064a\u0646 \u0627\u0644\u0648\u0627\u062c\u0647\u0627\u062a \u0639\u0646\u062f \u062a\u0633\u062c\u064a\u0644 \u062f\u062e\u0648\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0648\u0639\u062f\u0645\u0647.\\x3C/span>\\x3C/li>\\n\\x3Cli style=\\\"font-weight: 400;\\\">\\x3Cspan style=\\\"font-weight: 400;\\\">\u0628\u0633\u0628\u0628 \u0627\u0644\u0645\u0634\u0643\u0644\u0627\u062a \u0627\u0644\u0645\u062d\u062a\u0645\u0644\u0629 \u0641\u064a \u0628\u0646\u064a\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0644\u0644\u0645\u0648\u0642\u0639\u060c \u0647\u0646\u0627\u0643 \u062d\u0627\u062c\u0629 \u0644\u0647\u0646\u062f\u0633\u0629 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0644\u0625\u0639\u0627\u062f\u0629 \u062a\u0635\u0645\u064a\u0645\u0647\u0627.\\x3C/span>\\x3C/li>\\n\\x3C/ul>\\n\\x3Cp>&nbsp;\\x3C/p>\\n\\x3Cp>\\x3Cem>\u0641\u064a UXBERT Labs \u0646\u062d\u0646 \u0645\u062a\u062e\u0635\u0635\u0648\u0646 \u0641\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0645\u062a\u0645\u062d\u0648\u0631 \u062d\u0648\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0644\u062a\u0635\u0645\u064a\u0645 \u062a\u062c\u0627\u0631\u0628 \u0645\u0628\u062a\u0643\u0631\u0629 \u0648\u062c\u0645\u064a\u0644\u0629 \u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0639\u0627\u0644\u0645\u064a. \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0633\u062a\u0636\u0627\u0641\u0629 \u0623\u0648\u0644 \u0645\u062e\u062a\u0628\u0631 \u062a\u062c\u0627\u0631\u064a \u0648\u0645\u062a\u0637\u0648\u0631 \u0644\u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u060c \u0648\u0641\u0631\u064a\u0642 \u0645\u0646 \u0628\u0627\u062d\u062b\u064a \u0648\u0645\u0635\u0645\u0645\u064a \u0648\u0645\u0637\u0648\u0631\u064a \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0641\u064a \u0645\u0648\u0642\u0639\u0646\u0627 \u0628\u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0633\u0646\u0633\u0627\u0639\u062f\u0643 \u0641\u064a \u0625\u0646\u0634\u0627\u0621 \u062a\u062c\u0627\u0631\u0628 \u0639\u0645\u0644\u0627\u0621 \u062a\u062c\u0639\u0644 \u0639\u0645\u0644\u0643 \u064a\u062a\u0645\u064a\u0632 \u0648\u062a\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u0639\u0648\u062f\u0629 \u0639\u0645\u0644\u0627\u0626\u0643. \u0625\u0630\u0627 \u0643\u0627\u0646 \u0644\u062f\u064a\u0643 \u0645\u0634\u0631\u0648\u0639 \u062a\u0631\u063a\u0628 \u0641\u064a \u0627\u0644\u0639\u0645\u0644 \u0645\u0639\u0646\u0627 \u0639\u0644\u064a\u0647\u060c \u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 \u0639\u0644\u0649\\x3C/em> \\x3Ca class=\\\"theme\\\" href=\\\"mailto:hello@uxbert.com\\\">hello@uxbert.com\\x3C/a>\\x3C/p>\\n\",protected:!1},excerpt:$R[251]={rendered:\"\\x3Cp>\u064a\u064f\u0638\u0647\u0631 \u0644\u0643 \u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0628\u0627\u0644\u0636\u0628\u0637 \u0623\u064a\u0646 (\u0648\u0644\u0645\u0627\u0630\u0627) \u064a\u0648\u0627\u062c\u0647 \u0639\u0645\u0644\u0627\u0624\u0643 \u0645\u0634\u0627\u0643\u0644 \u0641\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0646\u062a\u062c\u0643. \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0633\u062a\u062b\u0645\u0631 \u0641\u064a \u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u062d\u0642\u0642 \u0639\u0627\u0626\u062f\u0627\u064b \u0645\u0628\u0627\u0634\u0631\u0627\u064b \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631 (ROI) \u0645\u0646 \u062e\u0644\u0627\u0644 \u0632\u064a\u0627\u062f\u0629 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0648\u0627\u0644\u0625\u064a\u0631\u0627\u062f\u0627\u062a\u060c \u0648\u0627\u0646\u062e\u0641\u0627\u0636 \u062a\u0643\u0627\u0644\u064a\u0641 \u0648\u0648\u0642\u062a \u0627\u0644\u062a\u0637\u0648\u064a\u0631\u060c \u0648\u0627\u0646\u062e\u0641\u0627\u0636 \u062a\u0643\u0627\u0644\u064a\u0641 \u0627\u0644\u062f\u0639\u0645\u060c \u0648\u0632\u064a\u0627\u062f\u0629 \u0627\u0644\u0625\u0646\u062a\u0627\u062c\u064a\u0629 \u0648\u0631\u0636\u0627 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646.\\x3C/p>\\n\\x3Cp>\u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0633\u0644\u0633\u0644\u0629\u060c \u0633\u0646\u0642\u0648\u0645 \u0628\u0625\u062c\u0631\u0627\u0621 \u0645\u0627 \u064a\u064f\u0633\u0645\u0649 \\\"\u062c\u0644\u0633\u0627\u062a \u0628\u062d\u062b \u0623\u0648\u0644\u064a\u0629\\\" \u0644\u0625\u062b\u0628\u0627\u062a \u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0631\u0624\u0649 \u0627\u0644\u062a\u064a \u064a\u0645\u0643\u0646 \u062c\u0645\u0639\u0647\u0627 \u062d\u062a\u0649 \u0645\u0646 \u0623\u0628\u0633\u0637 \u0627\u0644\u0623\u0628\u062d\u0627\u062b \u063a\u064a\u0631 \u0627\u0644\u0631\u0633\u0645\u064a\u0629.\\x3C/p>\\n\",protected:!1},author:3,featured_media:10816,comment_status:\"closed\",ping_status:\"closed\",sticky:!1,template:\"\",format:\"standard\",meta:$R[252]={_acf_changed:!1,inline_featured_image:!1,_mi_skip_tracking:!1,footnotes:\"\",_vp_format_video_url:\"\",_vp_image_focal_point:$R[253]=[]},categories:$R[254]=[2,182,164,12],tags:$R[255]=[172,89,103,106,107,200],acf:$R[256]={main:\"/uploads/articles/usability-engineering-saudi-arabia-ministry-of-interior/main.png\",sec:\"/uploads/articles/usability-engineering-saudi-arabia-ministry-of-interior/sec.png\"},category_objects:$R[257]=[$R[258]={id:2,count:3,description:\"\",link:\"/category/case-studies\",name:\"Case Studies\",slug:\"case-studies\",taxonomy:\"category\",parent:0,meta:$R[259]=[]},$R[218],$R[100],$R[102]],tag_objects:$R[260]=[$R[261]={id:172,count:2,description:\"\",link:\"/tag/eye-tracking\",name:\"eye tracking\",slug:\"eye-tracking\",taxonomy:\"post_tag\",meta:$R[262]=[]},$R[263]={id:89,count:5,description:\"\",link:\"/tag/saudi-arabia\",name:\"saudi arabia\",slug:\"saudi-arabia\",taxonomy:\"post_tag\",meta:$R[264]=[]},$R[245],$R[229],$R[133],$R[157]]},$R[265]={id:10736,date:\"2017-07-31T14:27:26\",date_gmt:\"2017-07-31T14:27:26\",guid:$R[266]={rendered:\"/?p=10736\"},modified:\"2025-09-01T08:18:17\",modified_gmt:\"2025-09-01T08:18:17\",slug:\"july-meetup-recap-emotional-design\",status:\"publish\",link:\"/july-meetup-recap-emotional-design\",title:$R[267]={rendered:\"\u0645\u0644\u062e\u0635 \u0644\u0642\u0627\u0621 \u064a\u0648\u0644\u064a\u0648: \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0639\u0627\u0637\u0641\u064a\"},content:$R[268]={rendered:\"\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0643\u0627\u0646 \u0644\u0642\u0627\u0621 \u064a\u0648\u0644\u064a\u0648 \u0627\u0644\u0646\u0633\u0627\u0626\u064a \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u0623\u0645\u0633\u064a\u0629 \u0645\u062b\u064a\u0631\u0629 \u0623\u062e\u0631\u0649 \u0645\u0644\u064a\u0626\u0629 \u0628\u0627\u0644\u0646\u0642\u0627\u0634\u0627\u062a \u0627\u0644\u0645\u062d\u0641\u0632\u0629! \\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0634\u0645\u0644 \u0627\u0644\u062d\u0636\u0648\u0631 \u0645\u0637\u0648\u0631\u0627\u062a \u0648\u0645\u0635\u0645\u0645\u0627\u062a \u0648\u0637\u0627\u0644\u0628\u0627\u062a \u0645\u062d\u0644\u064a\u0627\u062a \u0648\u062f\u0648\u0644\u064a\u0627\u062a \u0643\u0646\u0651 \u0641\u0636\u0648\u0644\u064a\u0627\u062a \u062d\u0648\u0644 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0639\u0627\u0637\u0641\u064a \u0648\u0623\u0647\u0645\u064a\u062a\u0647 \u0641\u064a \u0625\u0646\u0634\u0627\u0621 \u062a\u062c\u0627\u0631\u0628 \u0645\u0633\u062a\u062e\u062f\u0645 \u0631\u0627\u0626\u0639\u0629. \u062a\u0637\u0644\u0639\u0646 \u062c\u0645\u064a\u0639\u0627\u064b \u0644\u0641\u0631\u0635\u0629 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639 \u0623\u0634\u062e\u0627\u0635 \u064a\u0634\u0627\u0631\u0643\u0648\u0646\u0647\u0646 \u0646\u0641\u0633 \u0627\u0644\u0634\u063a\u0641 \u0628\u0640 UX. \\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0643\u0627\u0646\u062a \u0646\u062c\u0645\u0629 UX \u0644\u062f\u064a\u0646\u0627 \u0644\u064a\u0646\u0627 \u0623\u0628\u0648 \u0631\u062d\u0645\u0629 \u0647\u064a \u0627\u0644\u0645\u062a\u062d\u062f\u062b\u0629 \u0641\u064a \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0629. \u0628\u062f\u0623\u062a \u0627\u0644\u0644\u0642\u0627\u0621 \u0628\u0637\u0644\u0628 \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u062d\u0627\u0636\u0631\u0627\u062a \u0628\u0623\u0646\u0641\u0633\u0647\u0646 \u0623\u062b\u0646\u0627\u0621 \u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u0648\u062c\u0628\u0627\u062a \u0627\u0644\u062e\u0641\u064a\u0641\u0629 \u0648\u0627\u0644\u0645\u0634\u0631\u0648\u0628\u0627\u062a \u0627\u0644\u0645\u0642\u062f\u0645\u0629. \u0623\u062b\u0627\u0631 \u0647\u0630\u0627 \u0646\u0642\u0627\u0634\u0627\u064b \u062d\u0648\u0644 \u062e\u0644\u0641\u064a\u0627\u062a \u0627\u0644\u062c\u0645\u064a\u0639 \u0648\u0645\u0627 \u062c\u0630\u0628\u0647\u0646 \u0644\u0647\u0630\u0647 \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0629. \u0628\u0646\u0647\u0627\u064a\u0629 \u0643\u0633\u0631 \u0627\u0644\u062c\u0644\u064a\u062f\u060c \u0633\u0627\u062f \u062c\u0648 \u0645\u0631\u064a\u062d \u0648\u062d\u0645\u064a\u0645 \u0641\u064a \u0627\u0644\u0642\u0627\u0639\u0629. \\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0628\u062f\u0623 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u062a\u0642\u062f\u064a\u0645\u064a \u0628\u0645\u062b\u0627\u0644 \u0645\u0645\u062a\u0639 \u0644\u0634\u0631\u0643\u0629 \u0646\u062c\u062d\u062a \u0641\u064a \u062f\u0645\u062c \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0630\u0643\u064a \u0639\u0627\u0637\u0641\u064a\u0627\u064b \u0641\u064a \u0645\u0648\u0642\u0639\u0647\u0627 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a. \u0639\u0631\u0636\u062a \u0644\u064a\u0646\u0627 \u0639\u0644\u0649 \u0627\u0644\u062c\u0645\u0647\u0648\u0631 \u0628\u0639\u0636 \u0627\u0644\u0627\u0642\u062a\u0628\u0627\u0633\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0648\u0636\u062d \u0641\u0644\u0633\u0641\u0629 \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0634\u0631\u0643\u0629 \u0648\u0637\u0644\u0628\u062a \u0645\u0646\u0647\u0646 \u062a\u062e\u0645\u064a\u0646 \u0627\u0644\u0634\u0631\u0643\u0629. \u0623\u062c\u0627\u0628\u062a \u0627\u0644\u062d\u0627\u0636\u0631\u0627\u062a \u0628\u0623\u062c\u0648\u0628\u0629 \u0645\u062b\u0644 \\\"Google\\\" \u0623\u0648 \\\"Apple\\\" \u0644\u0643\u0646\u0647\u0646 \u0641\u0648\u062c\u0626\u0646 \u0628\u0623\u0646 \u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0643\u0627\u0646\u062a \u0641\u064a \u0627\u0644\u0648\u0627\u0642\u0639 Mint.com.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0628\u0639\u062f \u0623\u0646 \u062c\u0630\u0628\u062a \u0627\u0646\u062a\u0628\u0627\u0647 \u0627\u0644\u062d\u0627\u0636\u0631\u0627\u062a \u0628\u0645\u0642\u062f\u0645\u0629 \u0645\u0645\u062a\u0639\u0629\u060c \u062a\u0639\u0645\u0642\u062a \u0644\u064a\u0646\u0627 \u0641\u064a \u0627\u0644\u0645\u0641\u0627\u0647\u064a\u0645 \u0648\u0627\u0644\u0645\u0628\u0627\u062f\u0626 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0644\u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0648\u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645. \u0623\u0628\u0642\u062a \u0627\u0644\u062d\u0627\u0636\u0631\u0627\u062a \u0627\u0644\u0646\u0642\u0627\u0634 \u0645\u0633\u062a\u0645\u0631\u0627\u064b \u0628\u062a\u062c\u0627\u0631\u0628\u0647\u0646 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0627\u0644\u0645\u0636\u062d\u0643\u0629 \u0639\u0644\u0649 \u0645\u0648\u0627\u0642\u0639 \u0630\u0627\u062a \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0636\u0639\u064a\u0641\u0629. \\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0628\u0639\u062f \u0627\u0633\u062a\u0639\u0631\u0627\u0636 \u0633\u0631\u064a\u0639 \u0644\u0623\u0633\u0627\u0633\u064a\u0627\u062a UX\u060c \u0627\u0646\u062a\u0642\u0644\u062a \u0644\u064a\u0646\u0627 \u0644\u0634\u0631\u062d \u0643\u064a\u0641 \u0623\u0646 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u062c\u0645\u064a\u0644\u0629 \u062a\u062d\u0641\u0632 \u0645\u0634\u0627\u0639\u0631 \u0625\u064a\u062c\u0627\u0628\u064a\u0629 \u0648\u0647\u0630\u0647 \u0627\u0644\u0645\u0634\u0627\u0639\u0631 \u062a\u0624\u062b\u0631 \u0645\u0628\u0627\u0634\u0631\u0629 \u0639\u0644\u0649 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0646\u062a\u062c! \u0627\u0633\u062a\u062e\u062f\u0645\u062a \u0639\u062f\u0629 \u062f\u0631\u0627\u0633\u0627\u062a \u0648\u0623\u0645\u062b\u0644\u0629 \u0645\u0646 \u0645\u0648\u0627\u0642\u0639 \u062d\u0642\u064a\u0642\u064a\u0629 \u0644\u062a\u0648\u0636\u064a\u062d \u0630\u0644\u0643 \u0644\u0644\u062c\u0645\u0647\u0648\u0631. \\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0643\u0627\u0646\u062a \u062d\u0642\u064a\u0642\u0629 \u0623\u0646 \u0627\u0644\u062c\u0645\u0627\u0644\u064a\u0627\u062a \u0648\u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0631\u062a\u0628\u0637\u062a\u0627\u0646 \u0645\u0641\u0647\u0648\u0645\u0627\u064b \u062c\u062f\u064a\u062f\u0627\u064b \u0644\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u062d\u0627\u0636\u0631\u0627\u062a. \u0647\u062f\u0641 \u0628\u0642\u064a\u0629 \u0627\u0644\u0639\u0631\u0636 \u0625\u0644\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u062c\u0645\u0647\u0648\u0631 \u0639\u0644\u0649 \u0641\u0647\u0645 \u0627\u0644\u0646\u0638\u0631\u064a\u0627\u062a \u0627\u0644\u0645\u062e\u062a\u0644\u0641\u0629 \u0644\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0639\u0627\u0637\u0641\u064a \u0648\u0643\u064a\u0641\u064a\u0629 \u062a\u0637\u0628\u064a\u0642\u0647\u0627 \u0641\u064a \u0627\u0644\u062a\u0635\u0645\u064a\u0645. \\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cimg loading=\\\"lazy\\\" decoding=\\\"async\\\" class=\\\"aligncenter size-full wp-image-10737\\\" src=\\\"/uploads/articles/july-meetup-recap-emotional-design/inline-8.jpg\\\" alt=\\\"IMG_6615\\\" width=\\\"5184\\\" height=\\\"3456\\\" srcset=\\\"/uploads/articles/july-meetup-recap-emotional-design/inline-8.jpg 5184w, /uploads/articles/july-meetup-recap-emotional-design/inline-7.jpg 300w, /uploads/articles/july-meetup-recap-emotional-design/inline-3.jpg 768w, /uploads/articles/july-meetup-recap-emotional-design/inline-11.jpg 1024w, /uploads/articles/july-meetup-recap-emotional-design/inline-1.jpg 150w, /uploads/articles/july-meetup-recap-emotional-design/inline-10.jpg 330w, /uploads/articles/july-meetup-recap-emotional-design/inline-9.jpg 900w, /uploads/articles/july-meetup-recap-emotional-design/inline-12.jpg 1800w, /uploads/articles/july-meetup-recap-emotional-design/inline-5.jpg 736w, /uploads/articles/july-meetup-recap-emotional-design/inline-0.jpg 1920w, /uploads/articles/july-meetup-recap-emotional-design/inline-4.jpg 621w, /uploads/articles/july-meetup-recap-emotional-design/inline-2.jpg 1280w, /uploads/articles/july-meetup-recap-emotional-design/inline-6.jpg 414w\\\" sizes=\\\"(max-width: 5184px) 100vw, 5184px\\\" />\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062d\u062f\u064a\u062b \u0639\u0646 \u0646\u0638\u0631\u064a\u0627\u062a \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0639\u0627\u0637\u0641\u064a\u060c \u0623\u062c\u0631\u062a \u0627\u0644\u062d\u0627\u0636\u0631\u0627\u062a \u0646\u0642\u0627\u0634\u0627\u064b \u062d\u0648\u0644 \u0643\u064a\u0641 \u064a\u0645\u0643\u0646 \u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0644\u0644\u0645\u0646\u062a\u062c \u0623\u0646 \u062a\u0633\u0627\u0639\u062f \u0627\u0644\u0634\u062e\u0635 \u0639\u0644\u0649 \u062a\u0637\u0648\u064a\u0631 \u0627\u0631\u062a\u0628\u0627\u0637 \u0639\u0627\u0637\u0641\u064a \u0628\u0647. \u0627\u0633\u062a\u0634\u0647\u062f\u0646 \u0628\u0640 iPhone \u0643\u0645\u062b\u0627\u0644 \u0648\u0642\u0644\u0646 \u0625\u0646 \u0645\u0639\u0638\u0645 \u0627\u0644\u0646\u0627\u0633 \u064a\u0634\u062a\u0631\u0648\u0646 \u0645\u0646\u062a\u062c\u0627\u062a Apple \u0644\u0623\u0646 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0644\u0647\u0627 \u0637\u0627\u0628\u0639 \\\"\u0639\u0635\u0631\u064a\\\" \u0623\u0648 \\\"\u0623\u0646\u064a\u0642\\\". \u0642\u062f\u0645\u062a \u0639\u0627\u0644\u0645\u0629 \u0627\u0644\u0625\u062f\u0631\u0627\u0643 \u0648\u0627\u0644\u0643\u0648\u0645\u064a\u062f\u064a\u0629 \u0627\u0644\u0645\u0642\u064a\u0645\u0629 \u0644\u062f\u064a\u0646\u0627\u060c \u0646\u0627\u062f\u064a\u0646 \u0639\u0644\u0648\u0634\u060c \u0645\u062b\u0627\u0644\u0647\u0627 \u0627\u0644\u062e\u0627\u0635 \u0642\u0627\u0626\u0644\u0629: \\\"\u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0633\u0628\u0628 \u0641\u064a \u0623\u0646\u0646\u064a \u0623\u0634\u062a\u0631\u064a \u062f\u0627\u0626\u0645\u0627\u064b \u0627\u0644\u0645\u0627\u0621 \u0627\u0644\u0630\u064a \u064a\u0642\u0648\u0644 \\\"\u0645\u0627\u0621 \u0643\u0646\u062f\u064a\\\" \u0639\u0644\u0649 \u0627\u0644\u0639\u0628\u0648\u0629. \u0623\u0639\u0644\u0645 \u0623\u0646\u0647 \u0645\u062c\u0631\u062f \u0645\u0627\u0621 \u0639\u0627\u062f\u064a \u0644\u0643\u0646 \u0644\u0627 \u0623\u0633\u062a\u0637\u064a\u0639 \u0645\u0646\u0639 \u0646\u0641\u0633\u064a! \u0623\u0646\u0627 \u0643\u0646\u062f\u064a\u0629! \u0639\u0646\u062f\u0645\u0627 \u0623\u0631\u0627\u0647\u060c \u0623\u062d\u062a\u0627\u062c\u0647 \u0641\u0648\u0631\u0627\u064b!\\\"  \\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0643\u0627\u0646 \u0627\u0644\u062c\u0632\u0621 \u0627\u0644\u0623\u0643\u062b\u0631 \u0625\u062b\u0627\u0631\u0629 \u0641\u064a \u0627\u0644\u0644\u0642\u0627\u0621 \u0647\u0648 \u062a\u062d\u062f\u064a Twitter \u0641\u064a \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0639\u0631\u0636. \u0637\u064f\u0644\u0628 \u0645\u0646 \u0627\u0644\u062d\u0627\u0636\u0631\u0627\u062a \u0634\u0631\u062d \u0627\u0631\u062a\u0628\u0627\u0637\u0647\u0646 \u0628\u0640 Snapchat \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0641\u0627\u0647\u064a\u0645 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0639\u0627\u0637\u0641\u064a. \u0623\u064f\u0639\u0637\u064a\u0646 10 \u062f\u0642\u0627\u0626\u0642 \u0644\u0644\u062a\u063a\u0631\u064a\u062f \\x3C/span>\\x3Ca href=\\\"https://twitter.com/uxbert\\\">\\x3Cspan style=\\\"font-weight: 400;\\\">@uxbert\\x3C/span>\\x3C/a>\\x3Cspan style=\\\"font-weight: 400;\\\"> \u0628\u0625\u062c\u0627\u0628\u0627\u062a\u0647\u0646 \u0639\u0644\u0649 \u0627\u0644\u0633\u0624\u0627\u0644.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0631\u063a\u0645 \u0623\u0646\u0646\u0627 \u062d\u0635\u0644\u0646\u0627 \u0639\u0644\u0649 \u0625\u062c\u0627\u0628\u0627\u062a \u0631\u0627\u0626\u0639\u0629 \u0645\u0646 \u0627\u0644\u062c\u0645\u064a\u0639\u060c \u0625\u0644\u0627 \u0623\u0646 \u0633\u0627\u0631\u0629 (@Sarasization)\\x3C/span>\\x3Cspan style=\\\"font-weight: 400;\\\"> \u0642\u062f\u0645\u062a \u0627\u0644\u0641\u0643\u0631\u0629 \u0627\u0644\u0623\u0643\u062b\u0631 \u0627\u0628\u062a\u0643\u0627\u0631\u0627\u064b \u0648\u0623\u0635\u0627\u0644\u0629 \u0648\u062d\u0635\u0644\u062a \u0639\u0644\u0649 \u0627\u0644\u062c\u0627\u0626\u0632\u0629 \u0627\u0644\u0623\u0648\u0644\u0649. \u0648\u0635\u0641\u062a \u0627\u0644\u0623\u0633\u0628\u0627\u0628 \u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629 \u0648\u0631\u0627\u0621 \u0634\u0639\u0628\u064a\u0629 Snapchat \u0627\u0644\u062e\u0627\u0635\u0629 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629. \u0643\u0627\u0646\u062a \u0627\u0644\u062c\u0627\u0626\u0632\u0629 \u0643\u062a\u0627\u0628 \\\"Emotional Design\\\" \u0644\u0640 Don Norman. \\x3C/span>\\x3C/p>\\n\\x3Cblockquote class=\\\"twitter-tweet\\\" data-lang=\\\"en\\\">\\n\\x3Cp dir=\\\"ltr\\\" lang=\\\"en\\\">\\x3Ca href=\\\"https://twitter.com/uxbert\\\">@uxbert\\x3C/a>\\x3Cbr />\\nSnapchat&#8217;s simplicity, basic functionality, and relation to cultural aspects (privacy) creates a perfect combination. ??\\x3C/p>\\n\\x3Cp>\u2014 Sara Alshim (@Sarasization) \\x3Ca href=\\\"https://twitter.com/Sarasization/status/889905206678495237\\\">July 25, 2017\\x3C/a>\\x3C/p>\\x3C/blockquote>\\n\\x3Cp>\\x3Cscript src=\\\"//platform.twitter.com/widgets.js\\\" async=\\\"\\\" charset=\\\"utf-8\\\">\\x3C/script>\\x3C/p>\\n\\x3Cp>\u0643\u0627\u0646\u062a \u0627\u0644\u062d\u0627\u0636\u0631\u0627\u062a \u0633\u0639\u064a\u062f\u0627\u062a \u062c\u062f\u0627\u064b \u0628\u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0628\u0623\u0643\u0645\u0644\u0647\u0627 \u0648\u0643\u0646\u0651 \u062c\u0645\u064a\u0639\u0627\u064b \u0639\u0644\u0649 \u0627\u0633\u062a\u0639\u062f\u0627\u062f \u0644\u0644\u0639\u0648\u062f\u0629 \u0644\u0644\u0642\u0627\u0621\u0627\u062a \u0645\u0633\u062a\u0642\u0628\u0644\u064a\u0629. \u0635\u0631\u062d\u062a \u0627\u0644\u0633\u064a\u062f\u0627\u062a \u0628\u0623\u0646 \u0645\u0643\u062a\u0628 UXBERT Labs \u064a\u062a\u0645\u062a\u0639 \u0628\u062a\u0635\u0645\u064a\u0645 \u062f\u0627\u062e\u0644\u064a \u0631\u0627\u0626\u0639 \u0648\u0637\u0644\u0628\u0646 \u062c\u0648\u0644\u0629 \u0642\u0628\u0644 \u0627\u0644\u0645\u063a\u0627\u062f\u0631\u0629. \u0628\u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0644\u0642\u0627\u0621 \u062a\u062d\u0648\u0644\u0646\u0627 \u062c\u0645\u064a\u0639\u0627\u064b \u0645\u0646 \u063a\u0631\u0628\u0627\u0621 \u064a\u0634\u062a\u0631\u0643\u0648\u0646 \u0641\u064a \u0627\u0647\u062a\u0645\u0627\u0645\u0627\u062a \u0645\u062a\u0634\u0627\u0628\u0647\u0629 \u0625\u0644\u0649 \u0623\u0635\u062f\u0642\u0627\u0621 \u064a\u062a\u0628\u0627\u062f\u0644\u0648\u0646 \u062a\u062c\u0627\u0631\u0628\u0647\u0645 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0645\u0639\u0627\u064b.\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0646\u062d\u0646 \u0641\u062e\u0648\u0631\u0648\u0646 \u062f\u0627\u0626\u0645\u0627\u064b \u0628\u062c\u0645\u0639 \u0645\u062c\u062a\u0645\u0639 UX \u0648\u0645\u0634\u0627\u0631\u0643\u0629 \u062e\u0628\u0631\u0627\u062a\u0646\u0627 \u0645\u0639\u0627\u064b \u0648\u0627\u0644\u062a\u0639\u0644\u0645 \u0645\u0646 \u0628\u0639\u0636\u0646\u0627 \u0627\u0644\u0628\u0639\u0636. \u062a\u0623\u0643\u062f \u0645\u0646 \u0639\u062f\u0645 \u062a\u0641\u0648\u064a\u062a \u0627\u0644\u0644\u0642\u0627\u0621\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644\u064a\u0629 \u0628\u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645 \u0625\u0644\u0649 \u0645\u062c\u0645\u0648\u0639\u0629 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0639\u0644\u0649 \\x3Ca href=\\\"https://www.meetup.com/User-Experience-Design-Riyadh-UX/\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">meetup.com\\x3C/a> \u0623\u0648 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u0641\u064a \u0627\u0644\u0646\u0634\u0631\u0629 \u0627\u0644\u0628\u0631\u064a\u062f\u064a\u0629 \u0644\u0645\u062f\u0648\u0646\u062a\u0646\u0627.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0646\u062a\u0637\u0644\u0639 \u0644\u0631\u0624\u064a\u0629 \u0627\u0644\u0645\u0632\u064a\u062f \u0648\u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0639\u0634\u0627\u0642 UX \u0641\u064a \u0644\u0642\u0627\u0621\u0627\u062a\u0646\u0627 \u0627\u0644\u0642\u0627\u062f\u0645\u0629!\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0644\u0623\u064a \u0623\u0633\u0626\u0644\u0629 \u0623\u0648 \u062a\u0639\u0644\u064a\u0642\u0627\u062a \u0623\u0648 \u0627\u0642\u062a\u0631\u0627\u062d\u0627\u062a \u0644\u0627 \u062a\u062a\u0631\u062f\u062f \u0641\u064a \u0645\u0631\u0627\u0633\u0644\u062a\u0646\u0627 \u0639\u0644\u0649 [hello@uxbert.com]\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Ci>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0641\u064a UXBERT Labs \u0646\u062a\u062e\u0635\u0635 \u0641\u064a \u062e\u062f\u0645\u0627\u062a \u0628\u062d\u062b \u0648\u062a\u0635\u0645\u064a\u0645 \u0648\u062a\u0637\u0648\u064a\u0631 UX \u0627\u0644\u062a\u064a \u062a\u0642\u062f\u0645 \u062a\u062c\u0627\u0631\u0628 \u0639\u0627\u0644\u0645\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u0648\u0649. \u0645\u0639 \u0645\u0643\u0627\u062a\u0628 \u0641\u064a \u062f\u0628\u064a \u0648\u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0644\u0646\u062f\u0646\u060c \u064a\u0642\u062f\u0645 \u0641\u0631\u064a\u0642\u0646\u0627 \u0645\u0646 \u0628\u0627\u062d\u062b\u064a UX \u0648\u0627\u0644\u0645\u0635\u0645\u0645\u064a\u0646 \u0648\u0627\u0644\u0645\u0637\u0648\u0631\u064a\u0646 \u0628\u0631\u0645\u062c\u064a\u0627\u062a \u0645\u0635\u0645\u0645\u0629 \u0648\u0645\u0628\u0646\u064a\u0629 \u062e\u0635\u064a\u0635\u0627\u064b \u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0646\u062c\u0627\u062d.\\x3C/span>\\x3C/i>\\x3C/p>\\n\\x3Cp>\\x3Cem>\u0645\u0647\u062a\u0645 \u0628\u0627\u0644\u0639\u0645\u0644 \u0645\u0639\u0646\u0627\u061f \u0631\u0627\u0633\u0644\u0646\u0627 \u0639\u0644\u0649 \\x3C/em>hello@uxbert.com\\x3Cem> \u0648\u0623\u062e\u0628\u0631\u0646\u0627 \u0628\u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a\u0643 \u0641\u064a \u0627\u0644\u0628\u062d\u062b \u0623\u0648 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0623\u0648 \u0627\u0644