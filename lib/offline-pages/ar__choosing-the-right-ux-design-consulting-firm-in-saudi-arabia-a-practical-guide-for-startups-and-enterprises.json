u0634\u0631\u0643\u0629 \u0627\u0633\u062a\u0634\u0627\u0631\u0627\u062a \u0631\u0642\u0645\u064a\u0629 \u0646\u0633\u0627\u0639\u062f \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u062a\u0648\u0633\u0639 \u0648\u0627\u0644\u0646\u0645\u0648 \u0641\u064a \u0627\u0644\u0623\u0633\u0648\u0627\u0642 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629\",\"productSuccess\":\"\u062a\u0645\u0643\u064a\u0646 \u0646\u062c\u0627\u062d \u0627\u0644\u0645\u0646\u062a\u062c \u0645\u0646 \u062e\u0644\u0627\u0644 \u0623\u0628\u062d\u0627\u062b \u0645\u062a\u0645\u062d\u0648\u0631\u0629 \u062d\u0648\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0648\u0646\u0645\u0630\u062c\u0629 \u0630\u0643\u064a\u0629\u060c \u0648\u0623\u0646\u0638\u0645\u0629 \u062a\u0635\u0645\u064a\u0645 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u0648\u0633\u0639 \u062a\u062d\u0642\u0642 \u0623\u062b\u0631\u0627\u064b \u062a\u062c\u0627\u0631\u064a\u0627\u064b \u0648\u0627\u0636\u062d\u0627\u064b.\",\"agencyCollaboration\":\"\u0646\u062d\u0646 \u0648\u0643\u0627\u0644\u0629 \u062a\u0635\u0645\u064a\u0645 \u0648\u062a\u0637\u0648\u064a\u0631 \u0646\u062a\u0639\u0627\u0648\u0646 \u0645\u0639 \u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0628\u0645\u062e\u062a\u0644\u0641 \u0623\u062d\u062c\u0627\u0645\u0647\u0627 \u0644\u0628\u0646\u0627\u0621 \u0648\u0644\u0627\u0621 \u0642\u0648\u064a \u0645\u0646 \u062e\u0644\u0627\u0644 \u062a\u062c\u0627\u0631\u0628 \u0631\u0642\u0645\u064a\u0629 \u0627\u0633\u062a\u062b\u0646\u0627\u0626\u064a\u0629.\"},\"about\":{\"productPhilosophy\":\"\u0646\u0624\u0645\u0646 \u0641\u064a \u0648\u0643\u0627\u0644\u062a\u0646\u0627 \u0628\u0623\u0646 \u0643\u0644 \u0645\u0646\u062a\u062c \u0631\u0627\u0626\u0639 \u064a\u0628\u062f\u0623 \u0628\u0641\u0647\u0645 \u0627\u0644\u0646\u0627\u0633. \u0644\u0630\u0644\u0643 \u0646\u062a\u0639\u0645\u0642 \u0641\u064a \u0633\u0644\u0648\u0643 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a\u0647 \u0648\u062a\u0648\u0642\u0639\u0627\u062a\u0647 \u0644\u0646\u0635\u0645\u0645 \u062a\u062c\u0627\u0631\u0628 \u062a\u0628\u0646\u064a \u0631\u0648\u0627\u0628\u0637 \u0639\u0627\u0637\u0641\u064a\u0629 \u0648\u0648\u0638\u064a\u0641\u064a\u0629 \u062d\u0642\u064a\u0642\u064a\u0629. \u062d\u0644\u0648\u0644\u0646\u0627 \u0641\u064a \u0627\u062e\u062a\u0628\u0627\u0631 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0628\u0646\u064a\u0629 \u0639\u0644\u0649 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0645\u062a\u0645\u062d\u0648\u0631\u0629 \u062d\u0648\u0644 \u0627\u0644\u0625\u0646\u0633\u0627\u0646.\"},\"servicesOverview\":{\"strategy\":\"\u0646\u0633\u0639\u0649 \u0625\u0644\u0649 \u0635\u064a\u0627\u063a\u0629 \u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u0627\u062a \u0631\u0642\u0645\u064a\u0629 \u0645\u062a\u0643\u0627\u0645\u0644\u0629 \u062a\u062c\u0633\u0631 \u0627\u0644\u0647\u0648\u0629 \u0628\u064a\u0646 \u0627\u0644\u0625\u0628\u062f\u0627\u0639 \u0648\u0627\u0644\u0648\u0638\u064a\u0641\u0629\u060c \u0648\u062a\u0639\u064a\u062f \u062a\u0634\u0643\u064a\u0644 \u0637\u0631\u064a\u0642\u0629 \u062a\u0641\u0627\u0639\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0645\u0639 \u0639\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629. \u064a\u0639\u062a\u0645\u062f \u0641\u0631\u064a\u0642\u0646\u0627 \u0639\u0644\u0649 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u062a\u0641\u0643\u064a\u0631 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0648\u0627\u0644\u0627\u0628\u062a\u0643\u0627\u0631 \u0644\u0628\u0646\u0627\u0621 \u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u0627\u062a \u0644\u0627 \u062a\u0628\u062f\u0648 \u062c\u064a\u062f\u0629 \u0641\u062d\u0633\u0628\u060c \u0628\u0644 \u062a\u062d\u0642\u0642 \u0623\u062b\u0631\u064b\u0627 \u062d\u0642\u064a\u0642\u064a\u064b\u0627.\",\"training\":\"\u0646\u0642\u062f\u0645 \u0628\u0631\u0627\u0645\u062c \u062a\u062f\u0631\u064a\u0628 \u0627\u062d\u062a\u0631\u0627\u0641\u064a\u0629 \u0648\u0634\u0647\u0627\u062f\u0627\u062a \u0645\u062a\u062e\u0635\u0635\u0629 \u062a\u0645\u0643\u0651\u0646 \u0627\u0644\u0645\u062d\u062a\u0631\u0641\u064a\u0646 \u0645\u0646 \u0625\u062a\u0642\u0627\u0646 \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u062a\u062c\u0627\u0631\u0628 \u0627\u0644\u0631\u0642\u0645\u064a\u0629 \u0627\u0644\u0628\u062f\u064a\u0647\u064a\u0629 \u0648\u0627\u0644\u062c\u0630\u0627\u0628\u0629. \u0648\u0645\u0646 \u062e\u0644\u0627\u0644 \u062c\u0644\u0633\u0627\u062a \u064a\u0642\u0648\u062f\u0647\u0627 \u062e\u0628\u0631\u0627\u0621 \u0648\u0645\u0634\u0627\u0631\u064a\u0639 \u0639\u0645\u0644\u064a\u0629 \u0648\u0627\u0642\u0639\u064a\u0629\u060c \u064a\u0643\u062a\u0633\u0628 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0648\u0646 \u0645\u0647\u0627\u0631\u0627\u062a \u062a\u0637\u0628\u064a\u0642\u064a\u0629 \u0641\u064a \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 (UX) \u0648\u062b\u0642\u0629 \u0623\u0643\u0628\u0631 \u0641\u064a \u062a\u0642\u062f\u064a\u0645 \u062d\u0644\u0648\u0644 \u0627\u0633\u062a\u062b\u0646\u0627\u0626\u064a\u0629.\",\"ar\":\"\u0646\u0642\u062f\u0645 \u062e\u062f\u0645\u0627\u062a \u0648\u0627\u0642\u0639 \u0645\u0639\u0632\u0632 \u0645\u062a\u0642\u062f\u0645\u0629 \u062a\u064f\u062d\u064a\u064a \u0627\u0644\u062a\u062c\u0627\u0631\u0628 \u0627\u0644\u0631\u0642\u0645\u064a\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 \u062d\u0644\u0648\u0644 \u062a\u0641\u0627\u0639\u0644\u064a\u0629 \u0648\u063a\u0646\u064a\u0629 \u062a\u0639\u0632\u0632 \u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0648\u062a\u0631\u0648\u064a \u0642\u0635\u0629 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0628\u0637\u0631\u0642 \u0645\u0628\u062a\u0643\u0631\u0629. \u0646\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0625\u0628\u062f\u0627\u0639 \u0648\u0627\u0644\u062a\u0643\u0646\u0648\u0644\u0648\u062c\u064a\u0627 \u0644\u062a\u0642\u062f\u064a\u0645 \u062a\u062c\u0627\u0631\u0628 AR \u0633\u0644\u0633\u0629 \u0648\u0645\u062a\u0645\u062d\u0648\u0631\u0629 \u062d\u0648\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645.\",\"ai\":\"\u062a\u0633\u0627\u0639\u062f\u0643 \u062d\u0644\u0648\u0644 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0627\u0644\u0645\u062a\u0637\u0648\u0631\u0629 \u0644\u062f\u064a\u0646\u0627 \u0639\u0644\u0649 \u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u0628 \u0627\u0644\u0631\u0642\u0645\u064a\u0629 \u0639\u0628\u0631 \u0627\u0644\u0623\u062a\u0645\u062a\u0629 \u0627\u0644\u0630\u0643\u064a\u0629 \u0648\u0627\u0644\u062a\u062e\u0635\u064a\u0635. \u0646\u062f\u0645\u062c \u062a\u0642\u0646\u064a\u0627\u062a \u0645\u062b\u0644 \u0631\u0648\u0628\u0648\u062a\u0627\u062a \u0627\u0644\u062f\u0631\u062f\u0634\u0629\u060c \u0648\u0627\u0644\u062a\u062d\u0644\u064a\u0644\u0627\u062a \u0627\u0644\u062a\u0646\u0628\u0624\u064a\u0629\u060c \u0648\u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0630\u0643\u064a\u0629 \u0644\u062a\u0639\u0632\u064a\u0632 \u062a\u0641\u0627\u0639\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0648\u0643\u0641\u0627\u0621\u062a\u0647\u0645.\"}}},\"article\":{\"breadcrumbs\":{\"home\":\"\u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629\",\"articles\":\"\u0627\u0644\u0645\u0642\u0627\u0644\u0627\u062a\"},\"minRead\":\"\u0648\u0642\u062a \u0627\u0644\u0642\u0631\u0627\u0621\u0629: {{mins}} \u062f\u0642\u0627\u0626\u0642\",\"callToAction\":{\"intro\":\"\u0647\u0644 \u0623\u0646\u062a \u0645\u0647\u062a\u0645 \u0628\u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0645\u0632\u064a\u0