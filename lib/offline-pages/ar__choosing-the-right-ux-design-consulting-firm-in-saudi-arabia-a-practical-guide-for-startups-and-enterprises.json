enes\":{\"intro\":{\"text\":\"\u0645\u0646\u0630 \u0641\u062c\u0631 \u0627\u0644\u0628\u0634\u0631\u064a\u0629 \u0625\u0644\u0649 \u0639\u0635\u0631 \u0627\u0644\u0631\u0642\u0645\u064a\u0627\u062a\u060c \u0638\u0644 \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u064a\u0635\u0646\u0639 \u0639\u0627\u0644\u0645\u0646\u0627 \u0648\u064a\u0639\u064a\u062f \u0635\u064a\u0627\u063a\u062a\u0647.\"},\"earlyHumans\":{\"title\":\"\u0627\u0644\u0639\u0635\u0631 \u0627\u0644\u062d\u062c\u0631\u064a\",\"text\":\"\u0642\u0628\u0644 \u0632\u0645\u0646\u064d \u0637\u0648\u064a\u0644 \u0645\u0646 \u0627\u0644\u0634\u0627\u0634\u0627\u062a \u0648\u0627\u0644\u0623\u062c\u0647\u0632\u0629\u060c \u0643\u0627\u0646 \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u064a\u0635\u0645\u0651\u0645 \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0648 \u0627\u0644\u0645\u0644\u0627\u062c\u0626 \u0648\u0637\u0631\u0642 \u0627\u0644\u062a\u0648\u0627\u0635\u0644. \u0643\u0644 \u0627\u0628\u062a\u0643\u0627\u0631 \u0648\u064f\u0644\u062f \u0644\u062d\u0644\u0651 \u0645\u0634\u0643\u0644\u0629 \u0648\u062c\u0639\u0644 \u0627\u0644\u062d\u064a\u0627\u0629 \u0623\u0633\u0647\u0644. \u062a\u0644\u0643 \u0627\u0644\u063a\u0631\u064a\u0632\u0629 \u0641\u064a \u0627\u0644\u0625\u0628\u062f\u0627\u0639 \u0645\u0646 \u0623\u062c\u0644 \u0627\u0644\u0622\u062e\u0631\u064a\u0646\u061f \u0647\u0646\u0627 \u0628\u062f\u0623\u062a \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645.\"},\"ancientEgypt\":{\"title\":\"\u0645\u0635\u0631 \u0627\u0644\u0642\u062f\u064a\u0645\u0629\",\"text\":\"\u0627\u0644\u0645\u0635\u0631\u064a\u0648\u0646 \u0627\u0644\u0642\u062f\u0645\u0627\u0621 \u0644\u0645 \u064a\u0628\u0646\u0648\u0627 \u0645\u062c\u0631\u062f \u0622\u062b\u0627\u0631. \u0628\u0644 \u0635\u0645\u0651\u0645\u0648\u0627 \u062a\u062c\u0627\u0631\u0628 \u0643\u0627\u0645\u0644\u0629 \u0645\u0646 \u0627\u0644\u0645\u0639\u0627\u0628\u062f \u0625\u0644\u0649 \u0627\u0644\u0637\u0642\u0648\u0633 \u0628\u0646\u064a\u0629 \u0648\u0627\u0636\u062d\u0629 \u0648\u062f\u0642\u0651\u0629 \u062a\u0644\u0628\u064a \u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0648\u062a\u0628\u0642\u0649 \u0623\u062b\u0631\u0647\u0627 \u0639\u0628\u0631 \u0627\u0644\u0623\u062c\u064a\u0627\u0644.\"},\"ancientChina\":{\"title\":\"\u0627\u0644\u0635\u064a\u0646 \u0627\u0644\u0642\u062f\u064a\u0645\u0629\",\"text\":\"\u0645\u0646 \u0627\u0644\u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0645\u0627\u0626\u064a\u0629 \u0625\u0644\u0649 \u0627\u0644\u062a\u0642\u0648\u064a\u0645\u0627\u062a\u060c \u0642\u062f\u0651\u0645\u062a \u0627\u0644\u0635\u064a\u0646 \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0627\u0628\u062a\u0643\u0627\u0631\u0627\u062a \u0645\u0646\u062d\u062a \u0627\u0644\u062d\u064a\u0627\u0629 \u0646\u0638\u0627\u0645\u064b\u0627 \u0648\u0625\u064a\u0642\u0627\u0639\u064b\u0627. \u0644\u0645 \u062a\u0643\u0646 \u0625\u0646\u062c\u0627\u0632\u0627\u062a \u062a\u0642\u0646\u064a\u0629 \u0641\u062d\u0633\u0628\u060c \u0628\u0644 \u062a\u0635\u0627\u0645\u064a\u0645 \u062a\u062a\u0645\u062d\u0648\u0631 \u062d\u0648\u0644 \u0627\u0644\u0625\u0646\u0633\u0627\u0646\u060c \u0634\u0643\u0651\u0644\u062a \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0639\u064a\u0634 \u0648\u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637 \u0639\u0628\u0631 \u0627\u0644\u0632\u0645\u0646.\"},\"ancientGreece\":{\"title\":\"\u0627\u0644\u064a\u0648\u0646\u0627\u0646 \u0627\u0644\u0642\u062f\u064a\u0645\u0629\",\"text\":\"\u0641\u064a \u0627\u0644\u064a\u0648\u0646\u0627\u0646 \u0627\u0644\u0642\u062f\u064a\u0645\u0629\u060c \u0627\u0644\u062a\u0642\u0649 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0628\u0627\u0644\u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u0629. \u0644\u0645 \u062a\u0643\u0646 \u0627\u0644\u0631\u0645\u0627\u062d \u0648\u0627\u0644\u062f\u0631\u0648\u0639 \u0648\u0627\u0644\u062a\u0634\u0643\u064a\u0644\u0627\u062a \u0623\u062f\u0648\u0627\u062a \u062d\u0631\u0628 \u0641\u0642\u0637\u060c \u0628\u0644 \u0635\u064f\u0646\u0639\u062a \u0628\u062f\u0642\u0629 \u0644\u062a\u062e\u062f\u0645 \u0627\u0644\u062d\u0645\u0627\u064a\u0629 \u0648\u0627\u0644\u063a\u0627\u064a\u0629. \u0645\u062b\u0627\u0644 \u0648\u0627\u0636\u062d \u0639\u0644\u0649 \u062a\u0635\u0645\u064a\u0645 \u064a\u0644\u0628\u064a \u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629.\"},\"islamicGoldenAge\":{\"title\":\"\u0627\u0644\u0639\u0635\u0631 \u0627\u0644\u0630\u0647\u0628\u064a \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a\",\"text\":\"\u062d\u0648\u0651\u0644 \u0627\u0644\u0639\u0635\u0631 \u0627\u0644\u0630\u0647\u0628\u064a \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a \u0627\u0644\u0641\u0636\u0648\u0644 \u0625\u0644\u0649 \u0648\u0636\u0648\u062d. \u0628\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0641\u0644\u0643 \u0648\u0623\u0646\u0638\u0645\u0629 \u0645\u062b\u0644 \u0627\u0644\u062c\u0628\u0631\u060c \u0635\u0645\u0651\u0645 \u0627\u0644\u0645\u0641\u0643\u0631\u0648\u0646 \u062a\u062c\u0627\u0631\u0628 \u062c\u0639\u0644\u062a \u0627\u0644\u0623\u0641\u0643\u0627\u0631 \u0627\u0644\u0645\u0639\u0642\u0651\u062f\u0629 \u0623\u0633\u0647\u0644 \u0644\u0644\u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0648\u0627\u0644\u062a\u0637\u0628\u064a\u0642.\"},\"industrialAge\":{\"title\":\"\u0627\u0644\u0639\u0635\u0631 \u0627\u0644\u0635\u0646\u0627\u0639\u064a\",\"text\":\"\u062c\u0644\u0628 \u0627\u0644\u0639\u0635\u0631 \u0627\u0644\u0635\u0646\u0627\u0639\u064a \u0627\u0644\u0622\u0644\u0627\u062a \u0648\u0627\u0644\u062d\u0631\u0643\u0629 \u0648\u0627\u0644\u0625\u0646\u062a\u0627\u062c \u0627\u0644\u0636\u062e\u0645. \u0623\u0639\u0627\u062f\u062a \u0627\u0644\u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062e\u0627\u0631\u064a\u0629 \u0648\u0627\u0644\u0645\u0635\u0627\u0646\u0639 \u062a\u0634\u0643\u064a\u0644 \u0637\u0631\u064a\u0642\u0629 \u0639\u0645\u0644\u0646\u0627 \u0648\u062d\u064a\u0627\u062a\u0646\u0627\u060c \u0628\u062a\u0635\u0645\u064a\u0645 \u0623\u0646\u0638\u0645\u0629 \u062a\u062e\u062f\u0645 \u0627\u0644\u0646\u0627\u0633\u2026 \u0648\u062a\u062e\u062f\u0645 \u0627\u0644\u062d\u062c\u0645 \u0648\u0627\u0644\u0633\u0631\u0639\u0629.\"},\"waltDisney\":{\"title\":\"\u0648\u0627\u0644\u062a \u062f\u064a\u0632\u0646\u064a\",\"text\":\"\u0641\u064a \u0627\u0644\u0633\u062a\u064a\u0646\u064a\u0627\u062a\u060c \u062d\u0648\u0651\u0644 \u062f\u064a\u0632\u0646\u064a \u0627\u0644\u062e\u064a\u0627\u0644 \u0625\u0644\u0649 \u062a\u0635\u0645\u064a\u0645. \u0644\u0645 \u062a\u0643\u0646 \u062d\u062f\u0627\u0626\u0642\u0647 \u0645\u062c\u0631\u062f \u0645\u0646\u0627\u0637\u0642 \u062c\u0630\u0628 \u0628\u0644 \u0643\u0627\u0646\u062a \u0631\u062d\u0644\u0627\u062a \u0645\u0635\u0645\u0645\u0629 \u0628\u0639\u0646\u0627\u064a\u0629\u060c \u0623\u062b\u0628\u062a\u062a \u0623\u0646 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u064a\u0645\u0643\u0646 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0633\u062d\u0631\u064a\u0629 \u0648\u063a\u0627\u0645\u0631\u0629 \u0648\u0644\u0627 \u062a\u064f\u0646\u0633\u0649.\"},\"steveJobs\":{\"title\":\"\u0633\u062a\u064a\u0641 \u062c\u0648\u0628\u0632\",\"text\":\"\u062b\u0645 \u062c\u0627\u0621 \u0627\u0644\u0622\u064a\u0628\u0648\u062f. \u0628\u0639\u062c\u0644\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0648\u062a\u0635\u0645\u064a\u0645\u0647 \u0627\u0644\u0646\u0638\u064a\u0641\u060c \u0644\u0645 \u064a\u063a\u064a\u0651\u0631 \u0633\u062a\u064a\u0641 \u062c\u0648\u0628\u0632 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0641\u062d\u0633\u0628\u060c \u0628\u0644 \u0623\u0639\u0627\u062f \u062a\u0639\u0631\u064a\u0641 \u0637\u0631\u064a\u0642\u0629 \u062a\u0641\u0627\u0639\u0644\u0646\u0627 \u0645\u0639 \u0627\u0644\u062a\u0643\u0646\u0648\u0644\u0648\u062c\u064a\u0627: \u0628\u0633\u064a\u0637\u0629\u060c \u0623\u0646\u064a\u0642\u0629\u060c \u0648\u0625\u0646\u0633\u0627\u0646\u064a\u0629.\"},\"uxbertLabs\":{\"title\":\"UXBERT Labs\",\"text\":\"\u0645\u0646 \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0625\u0644\u0649 \u0646\u0642\u0627\u0637 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0631\u0642\u0645\u064a\u0629\u060c \u0634\u0643\u0651\u0644\u062a \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0633\u0627\u0631 \u0627\u0644\u062a\u0642\u062f\u0645. \u0641\u064a UXBERT Labs\u060c \u0646\u062d\u0645\u0644 \u0647\u0630\u0627 \u0627\u0644\u0625\u0631\u062b \u0625\u0644\u0649 \u0627\u0644\u0623\u0645\u0627\u0645 \u0628\u062a\u0635\u0645\u064a\u0645 \u062d\u0644\u0648\u0644 \u062a\u062a\u0648\u0627\u0635\u0644 \u062d\u0642\u064b\u0627 \u0645\u0639 \u0627\u0644\u0646\u0627\u0633\u2026 \u0647\u0646\u0627 \u0641\u064a \u0645\u062c\u0627\u0644\u0646\u0627.\"}},\"mobile\":{\"explore\":\"\u0627\u0633\u062a\u0643\u0634\u0641\",\"close\":\"\u0625\u063a\u0644\u0627\u0642\",\"explorePortfolio\":\"\u0627\u0633\u062a\u0643\u0634\u0641 \u0627\u0644\u0623\u0639\u0645\u0627\u0644\",\"closePortfolio\":\"\u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0623\u0639\u0645\u0627\u0644\",\"nav\":{\"1900\":\"\u0661\u0669\u0660\u0660\",\"1960\":\"\u0661\u0669\u0666\u0660\",\"2000\":\"\u0662\u0660\u0660\u0660\",\"2012\":\"\u0662\u0660\u0661\u0662\",\"earlyHumans\":\"\u0627\u0644\u0639\u0635\u0631 \u0627\u0644\u062d\u062c\u0631\u064a\",\"ancientEgypt\":\"\u0645\u0635\u0631 \u0627\u0644\u0642\u062f\u064a\u0645\u0629\",\"ancientChina\":\"\u0627\u0644\u0635\u064a\u0646 \u0627\u0644\u0642\u062f\u064a\u0645\u0629\",\"ancientGreece\":\"\u0627\u0644\u064a\u0648\u0646\u0627\u0646 \u0627\u0644\u0642\u062f\u064a\u0645\u0629\",\"islamicGoldenAge\":\"\u0627\u0644\u0639\u0635\u0631 \u0627\u0644\u0630\u0647\u0628\u064a\"}},\"timeline\":{\"present\":\"\u0627\u0644\u06