39\u0636\u060c \u0644\u0627 \u064a\u064f\u0646\u0638\u0631 \u0625\u0644\u064a\u0647\u0627 \u0639\u0644\u0649 \u0623\u0646\u0647\u0627 \u0648\u062d\u062f\u0629 \u0648\u0627\u062d\u062f\u0629. \u0625\u0646 \u0642\u0631\u0628 \u0627\u0644\u062e\u0637\u0648\u0637 \u0627\u0644\u0645\u0627\u0626\u0644\u0629 \u0647\u0648 \u0645\u0627 \u064a\u0648\u062d\u062f\u0647\u0627 \u0644\u062a\u0643\u0648\u0646 \u0635\u0648\u0631\u0629 \u0648\u0627\u062d\u062f\u0629.\\x3C/span>\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cimg alt=\\\"Adidas Logo\\\" class=\\\"aligncenter wp-image-11630\\\" decoding=\\\"async\\\" height=\\\"171\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 416px) 100vw, 416px\\\" src=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-24.jpg\\\" srcset=\\\"/wp-contentuploads/2018/03/adidaslogo-300x123.jpg 300w, /uploads/articles/ux-psychology-principles-design-ux/inline-2.jpg 330w, /uploads/articles/ux-psychology-principles-design-ux/inline-43.jpg 414w, /uploads/articles/ux-psychology-principles-design-ux/inline-24.jpg 486w\\\" width=\\\"416\\\"/>\\x3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp>\u0648\u0628\u0627\u0644\u0645\u062b\u0644\u060c \u064a\u062a\u0643\u0648\u0646 \u0634\u0639\u0627\u0631 \u0634\u0631\u0643\u0629 \u064a\u0648\u0646\u064a\u0644\u064a\u0641\u0631 \u0645\u0646 \u0639\u062f\u0629 \u0623\u0634\u064a\u0627\u0621 \u0645\u062a\u0645\u064a\u0632\u0629\u060c \u0648\u0644\u0643\u0646 \u064a\u064f\u0646\u0638\u0631 \u0625\u0644\u064a\u0647 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u0639\u0644\u0649 \u0623\u0646\u0647 \u0648\u062d\u062f\u0629 \u0648\u0627\u062d\u062f\u0629 \u0644\u0623\u0646\u0647\u0627 \u0642\u0631\u064a\u0628\u0629 \u0645\u0646 \u0628\u0639\u0636\u0647\u0627 \u0627\u0644\u0628\u0639\u0636 \u0648\u0645\u062a\u0634\u0627\u0628\u0647\u0629 \u0641\u064a \u0627\u0644\u0644\u0648\u0646 \u0648\u0627\u0644\u062d\u062c\u0645.\\x3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp>\\x3Cimg alt=\\\"Unilever Logo\\\" class=\\\"aligncenter wp-image-11631\\\" decoding=\\\"async\\\" height=\\\"177\\\" loading=\\\"lazy\\\" src=\\\"/wp-content/uploads/2018/03/unilever.jpeg\\\" width=\\\"160\\\"/>\\x3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp>\\x3Cb>\\x3Ci>\u0642\u0627\u0646\u0648\u0646 \u0627\u0644\u062a\u0634\u0627\u0628\u0647:\\x3C/i>\\x3C/b>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0639\u0646\u062f \u0648\u0636\u0639\u0647\u0627 \u0639\u0644\u0649 \u0645\u0642\u0631\u0628\u0629 \u0645\u0646 \u0628\u0639\u0636\u0647\u0627 \u0627\u0644\u0628\u0639\u0636\u060c \u063a\u0627\u0644\u0628\u064b\u0627 \u0645\u0627 \u062a\u0631\u062a\u0628\u0637 \u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u0645\u062a\u0634\u0627\u0628\u0647\u0629 \u0628\u0628\u0639\u0636\u0647\u0627 \u0627\u0644\u0628\u0639\u0636. \u064a\u0648\u0636\u062d \u0627\u0644\u0645\u062b\u0627\u0644 \u0623\u062f\u0646\u0627\u0647 \u062f\u0648\u0627\u0626\u0631 \u0645\u062a\u0637\u0627\u0628\u0642\u0629 \u0645\u0648\u0636\u0648\u0639\u0629 \u0628\u062c\u0627\u0646\u0628 \u0628\u0639\u0636\u0647\u0627 \u0627\u0644\u0628\u0639\u0636\u060c \u0648\u0644\u0643\u0646 \u0646\u0638\u0631\u064b\u0627 \u0644\u0623\u0646\u0647\u0627 \u0645\u0644\u0648\u0646\u0629 \u0628\u0634\u0643\u0644 \u0645\u062e\u062a\u0644\u0641\u060c \u064a\u062a\u0645 \u0627\u0639\u062a\u0628\u0627\u0631 \u0643\u0644 \u0635\u0641 \u0643\u0648\u062d\u062f\u0629 \u0648\u0627\u062d\u062f\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp>\\x3Cimg alt=\\\"Law of Similarity\\\" class=\\\"aligncenter wp-image-11632\\\" decoding=\\\"async\\\" height=\\\"175\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 175px) 100vw, 175px\\\" src=\\\"/wp-contentuploads/2018/03/lawofsimilarity.png\\\" srcset=\\\"/wp-contentuploads/2018/03/lawofsimilarity.png 224w, /wp-contentuploads/2018/03/lawofsimilarity-150x150.png 150w, /wp-contentuploads/2018/03/lawofsimilarity-200x200.png 200w\\\" width=\\\"175\\\"/>\\x3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp>\\x3Cb>\\x3Ci>\u0627\u0644\u0634\u0643\u0644 \u0648\u0627\u0644\u0623\u0631\u0636:\\x3C/i>\\x3C/b>\u064a\u0641\u0631\u0642 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0628\u064a\u0646 \u0627\u0644\u0643\u0627\u0626\u0646 (\u0627\u0644\u0634\u0643\u0644) \u0648\u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u0629 \u0628\u0647 (\u0627\u0644\u0623\u0631\u0636) \u0648\u064a\u0645\u0643\u0646\u0647\u0645 \u0627\u0644\u062a\u0628\u062f\u064a\u0644 \u0628\u064a\u0646\u0647\u0645\u0627 \u0644\u0639\u0631\u0636 \u0635\u0648\u0631 \u0645\u062e\u062a\u0644\u0641\u0629. \u064a\u0633\u062a\u0641\u064a\u062f \u0634\u0639\u0627\u0631 \u0645\u0628\u0627\u062f\u0631\u0629 \u0627\u0644\u0623\u0645\u0644 \u0644\u0644\u0623\u0637\u0641\u0627\u0644 \u0627\u0644\u0623\u0641\u0627\u0631\u0642\u0629 \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u0645\u0628\u062f\u0623 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0625\u0628\u062f\u0627\u0639\u064a \u0644\u0644\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0628\u064a\u0636\u0627\u0621 \u0643\u0635\u0648\u0631\u0629 \u0638\u0644\u064a\u0629 \u0644\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0623\u0641\u0631\u064a\u0642\u064a\u0629 \u0623\u062b\u0646\u0627\u0621 \u062a\u0634\u0643\u064a\u0644 \u0635\u0648\u0631\u0629 \u0637\u0641\u0644 \u0648\u0634\u062e\u0635 \u0628\u0627\u0644\u063a \u0645\u0639 \u0627\u0644\u0638\u0644\u0627\u0644 \u0627\u0644\u0628\u0631\u062a\u0642\u0627\u0644\u064a\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u0629.\\x3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp>\\x3Cimg alt=\\\"Hope For African Children Initiative Logo\\\" class=\\\"aligncenter wp-image-11633\\\" decoding=\\\"async\\\" height=\\\"211\\\" loading=\\\"lazy\\\" src=\\\"/wp-content/uploads/2018/03/hopeforafricanchildrenlogo.png\\\" width=\\\"277\\\"/>\\x3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp>\\x3Cb>\\x3Ci>\u0642\u0627\u0646\u0648\u0646 \u0627\u0644\u0625\u063a\u0644\u0627\u0642\\x3C/i>\\x3C/b>\\x3Ci>\\x3Cspan style=\\\"font-weight: 400;\\\">:\\x3C/span>\\x3C/i>