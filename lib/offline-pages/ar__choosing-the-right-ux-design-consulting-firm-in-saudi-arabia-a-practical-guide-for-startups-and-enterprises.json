u062f \u0648\u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u062c\u0633\u0645 \u0622\u062e\u0631. \u0648\u064a\u062a\u0645 \u062a\u062d\u0642\u064a\u0642 \u0630\u0644\u0643 \u063a\u0627\u0644\u0628\u064b\u0627 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0625\u0646\u0634\u0627\u0621 \u062e\u0637\u0648\u0637 \u0645\u0646\u062d\u0646\u064a\u0629\u060c \u0645\u0645\u0627 \u064a\u0633\u0645\u062d \u0644\u0644\u0639\u064a\u0646 \u0628\u0627\u0644\u062a\u062f\u0641\u0642 \u0645\u0639 \u0627\u0644\u062e\u0637. \u0634\u0639\u0627\u0631 \u062c\u0645\u0639\u064a\u0629 \u0627\u0644\u0641\u0646\u0627\u062f\u0642 \u0627\u0644\u0643\u0646\u062f\u064a\u0629 \u064a\u062c\u0639\u0644 \u0639\u064a\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u062a\u062a\u0628\u0639 \u0628\u0634\u0643\u0644 \u0637\u0628\u064a\u0639\u064a \u0627\u0644\u0639\u0627\u0631\u0636\u0629 \u0627\u0644\u0645\u062a\u062f\u0641\u0642\u0629 \u0628\u0633\u0644\u0627\u0633\u0629 \u0639\u0644\u0649 \u0634\u0643\u0644 \u062d\u0631\u0641 \\\"H\\\" \u0648\u0627\u0644\u062a\u064a \u062a\u0624\u062f\u064a \u0645\u0628\u0627\u0634\u0631\u0629 \u0625\u0644\u0649 \u0648\u0631\u0642\u0629 \u0627\u0644\u0642\u064a\u0642\u0628.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cimg alt=\\\"Hotel Association of Canada\\\" class=\\\"aligncenter wp-image-11635\\\" decoding=\\\"async\\\" height=\\\"206\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 205px) 100vw, 205px\\\" src=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-25.jpg\\\" srcset=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-25.jpg 174w, /uploads/articles/ux-psychology-principles-design-ux/inline-42.jpg 150w\\\" width=\\\"205\\\"/>\\x3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp>\\x3Ca name=\\\"psychology_of_persuasion\\\">\\x3C/a>\\x3Cb>3. \u0633\u064a\u0643\u0648\u0644\u0648\u062c\u064a\u0629 \u0627\u0644\u0625\u0642\u0646\u0627\u0639\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0627\u0644\u062a\u0623\u062b\u064a\u0631 \u0639\u0644\u0649 \u0627\u0644\u0622\u062e\u0631\u064a\u0646 \u0647\u0648 \u0639\u0644\u0645 \u0627\u0644\u0633\u0644\u0648\u0643 \u0627\u0644\u0628\u0634\u0631\u064a \u0627\u0644\u0630\u064a \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647 \u0644\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0641\u064a \u062a\u062d\u0633\u064a\u0646 \u0646\u062c\u0627\u062d \u0639\u0645\u0644\u0643.\\x3Cstrong>\u064a\u062c\u0628 \u0623\u0646 \u064a\u0642\u062a\u0646\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0642\u0628\u0644 \u0627\u062a\u062e\u0627\u0630 \u0623\u064a \u0625\u062c\u0631\u0627\u0621 \u0639\u0644\u0649 \u0623\u064a \u0645\u0648\u0642\u0639 \u0648\u064a\u0628.\\x3C/strong> \u0644\u0643\u0633\u0628 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0631\u0627\u0636\u064a\u0646 \u0648\u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u064a\u0647\u0645\u060c \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0639\u0644\u0645 \u0646\u0641\u0633 \u0627\u0644\u0625\u0642\u0646\u0627\u0639 \u0623\u062d\u062f \u0623\u0642\u0648\u0649 \u0627\u0644\u0623\u0633\u0627\u0644\u064a\u0628.\\x3C/span>\\x3C/p>\\n\\x3Cp>\u0627\u0644\u062f\u0643\u062a\u0648\u0631 \u0631\u0648\u0628\u0631\u062a \u0633\u064a\u0627\u0644\u062f\u064a\u0646\u064a \u0641\u064a \u0643\u062a\u0627\u0628\u0647\u060c\\x3Cem>\\\"\u0627\u0644\u062a\u0623\u062b\u064a\u0631: \u0633\u064a\u0643\u0648\u0644\u0648\u062c\u064a\u0629 \u0627\u0644\u0625\u0642\u0646\u0627\u0639\\\"\\x3C/em>\u0635\u0627\u063a\\x3Cstrong>6 \u0645\u0628\u0627\u062f\u0626 \u0627\u0644\u062a\u0623\u062b\u064a\u0631\\x3C/strong> \u0648\u0647\u0645:\\x3C/p>\\n\\x3Cp>\\x3Cb>\\x3Ci>\u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629 \u0628\u0627\u0644\u0645\u062b\u0644\\x3C/i>\\x3C/b>\\x3C/p>\\n\\x3Cp>\u0625\u0646 \u062a\u0642\u062f\u064a\u0645 \u0634\u064a\u0621 \u0630\u064a \u0642\u064a\u0645\u0629 \u0645\u0642\u062f\u0645\u064b\u0627 \u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0643 \u0633\u064a\u062c\u0639\u0644\u0647\u0645 \u064a\u0634\u0639\u0631\u0648\u0646 \u0628\u0623\u0646\u0647\u0645 \u0645\u062f\u064a\u0646\u0648\u0646 \u0644\u0643 \u0648\u0623\u0643\u062b\u0631 \u0644\u0627\u062a\u062e\u0627\u0630 \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0645\u0637\u0644\u0648\u0628. \u0645\u0646 \u0627\u0644\u0623\u0645\u062b\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629 \u0639\u0644\u0649 \u0630\u0644\u0643 \u062a\u0642\u062f\u064a\u0645 \u0643\u062a\u0628 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0645\u062c\u0627\u0646\u064a\u0629 \u0623\u0648 \u0645\u0646\u0634\u0648\u0631\u0627\u062a \u0645\u062f\u0648\u0646\u0629 \u0623\u0648 \u0645\u0644\u0641\u0627\u062a \u0628\u0648\u062f\u0643\u0627\u0633\u062a \u0623\u0648 \u0623\u064a \u0645\u062d\u062a\u0648\u0649 \u0645\u062c\u0627\u0646\u064a \u0622\u062e\u0631 \u0645\u0642\u0627\u0628\u0644 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645.\\x3C/p>\\n\\x3Cdiv class=\\\"wp-caption aligncenter\\\" id=\\\"attachment_11637\\\" style=\\\"width: 478px\\\">\\x3Cimg alt=\\\"everydaycarry.com law of reciprocation\\\" aria-describedby=\\\"caption-attachment-11637\\\" class=\\\"size-full wp-image-11637\\\" decoding=\\\"async\\\" height=\\\"620\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 468px) 100vw, 468px\\\" src=\\\"/wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.13.09-PM.png\\\" srcset=\\\"/wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.13.09-PM.png 468w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.13.09-PM-226x300.png 226w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.13.09-PM-196x260.png 196w, /uploads/articles/ux-psychology-principles-design-ux/inline-32.png 313w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.13.09-PM-414x548.png 414w\\\" width=\\\"468\\\"/>\\x3Cp class=\\\"wp-caption-text\\\" id=\\\"caption-attachment-11637\\\">\\x3Cem>\u064a\u0642\u062f\u0645 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639 \u0631\u0633\u0627\u0626\u0644 \u0625\u062e\u0628\u0627\u0631\u064a\u0629 \u0645\u062c\u0627\u0646\u064a\u0629 \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0647\u062f\u0627\u064a\u0627 \u0645\u0642\u0627\u0628\u0644 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646\u060c \u0645\u0645\u0627 \u064a\u062d\u0642\u0642 \u0641\u0627\u0626\u062f\u0629 \u0639\u0627\u0644\u064a\u0629 \u0628\u062a\u0643\u0644\u0641\u0629 \u0645\u0646\u062e\u0641\u0636\u0629. (\u0645\u0635\u062f\u0631:\\x3Ca href=\\\"http://everydaycarry.com\\\" rel=\\\"noopener\\\" target=\\\"_blank\\\">http://everydaycarry.com\\x3C/a>)\\x3C/em>\\x3C/p>\\x3C/div>\\n\\x3Cp>\\x3Cb>\\x3Ci>\u0633\u0644\u0637\u0629\\x3C/i>\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u0645\u064a\u0644 \u0627\u0644\u0646\u0627\u0633 \u0625\u0644\u0649 \u0637\u0627\u0639\u0629 \u0627\u0644\u062e\u0628\u0631\u0627\u0621 \u0648\u0627\u0644\u0634\u062e\u0635\u064a\u0627\u062a \u0627\u0644\u0645\u0648\u062b\u0648\u0642\u0629 \u0630\u0627\u062a \u0627\u0644\u0645\u0643\u0627\u0646\u0629 \u0627\u0644\u0639\u0627\u0644\u064a\u0629 \u062d\u064a\u062b \u064a\u064f\u0646\u0638\u0631 \u0625\u0644\u064a\u0647\u0645 \u0639\u0644\u0649 \u0623\u0646\u0647\u0645 \u062c\u062f\u064a\u0631\u0648\u0646 \u0628\u0627\u0644\u062b\u0642\u0629 \u0644\u0644\u063a\u0627\u064a\u0629. \u0639\u0627\u062f\u0629\u064b \u0645\u0627 \u064a\u062a\u0645 \u0627\u0644\u062a\u0639\u0628\u064a\u0631 \u0639\u0646 \u0627\u0644\u0633\u0644\u0637\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0623\u0644\u0642\u0627\u0628 (\u0627\u0644\u062f\u0643\u062a\u0648\u0631 \u0648\u0627\u0644\u0623\u0633\u062a\u0627\u0630 \u0648\u0627\u0644\u0631\u0626\u064a\u0633 \u0627\u0644\u062a\u0646\u0641\u064a\u0630\u064a) \u0648\u0627\u0644\u0645\u0638\u0647\u0631 \u0627\u0644\u0645\u0631\u0626\u064a \u0648\u0646\u062c\u0627\u062d \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u062a\u0633\u0627\u0639\u062f \u0627\u0644\u0623\u0644\u0642\u0627\u0628 \u0627\u0644\u0623\u0643\u0627\u062f\u064a\u0645\u064a\u0629 \u0648\u0627\u0644\u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u0623\u0634\u062e\u0627\u0635 \u0639\u0644\u0649 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0639\u0644\u0649 \u0627\u0644\u0622\u062e\u0631\u064a\u0646 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0646 \u0644\u062f\u064a\u0647\u0645 \u0645\u0639\u0631\u0641\u0629 \u0648\u0627\u0633\u0639\u0629 \u0628\u0627\u0644\u0645\u062c\u0627\u0644. \u063a\u0627\u0644\u0628\u064b\u0627 \u0645\u0627 \u064a\u062a\u0645 \u0630\u0643\u0631 \u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637\u0627\u062a \u0645\u0639 \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0646\u0627\u062c\u062d\u0629 \u0644\u0625\u0646\u0634\u0627\u0621 \u0645\u0633\u062a\u0648\u0649 \u0645\u0639\u064a\u0646 \u0645\u0646 \u0627\u0644\u0627\u062d\u062a\u0631\u0627\u0645 \u0648\u0627\u0644\u0645\u0635\u062f\u0627\u0642\u064a\u0629 \u0644\u0644\u0634\u0631\u0643\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cdiv class=\\\"wp-caption alignnone\\\" id=\\\"attachment_11639\\\" style=\\\"width: 1071px\\\">\\x3Cimg alt=\\\"Law of Authority\\\" aria-describedby=\\\"caption-attachment-11639\\\" class=\\\"size-full wp-image-11639\\\" decoding=\\\"async\\\" height=\\\"273\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 1061px) 100vw, 1061px\\\" src=\\\"/wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.54.34-PM.png\\\" srcset=\\\"/wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.54.34-PM.png 1061w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.54.34-PM-300x77.png 300w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.54.34-PM-768x198.png 768w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.54.34-PM-1024x263.png 1024w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.54.34-PM-330x85.png 330w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.54.34-PM-736x189.png 736w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.54.34-PM-414x107.png 414w\\\" width=\\\"1061\\\"/>\\x3Cp class=\\\"wp-caption-text\\\" id=\\\"caption-attachment-11639\\\">\\x3Cem>(\u0645\u0635\u062f\u0631:\\x3Ca href=\\\"http://www.atomic.io\\\" rel=\\\"noopener\\\" target=\\\"_blank\\\">www.atomic.io\\x3C/a>)\\x3C/em>\\x3C/p>\\x3C/div>\\n\\x3Cdiv class=\\\"wp-caption alignleft\\\" style=\\\"width: 1162px\\\">\\x3Cimg alt=\\\"Law of Authority\\\" class=\\\"wp-image-11640 size-full\\\" decoding=\\\"async\\\" height=\\\"450\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 1152px) 100vw, 1152px\\\" src=\\\"/wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.53.40-PM.png\\\" srcset=\\\"/wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.53.40-PM.png 1152w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.53.40-PM-300x117.png 300w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.53.40-PM-768x300.png 768w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.53.40-PM-1024x400.png 1024w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.53.40-PM-330x129.png 330w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.53.40-PM-736x288.png 736w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-2.53.40-PM-414x162.png 414w\\\" width=\\\"1152\\\"/>\\x3Cp class=\\\"wp-caption-text\\\">\\x3Cem>\u062a\u0633\u062a\u062e\u062f\u0645 \u0643\u0644\u062a\u0627 \u0627\u0644\u0634\u0631\u0643\u062a\u064a\u0646 \u0627\u0644\u0633\u0644\u0637\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 \u062a\u0632\u0648\u064a\u062f \u0639\u0645\u0644\u0627\u0621 \u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0627\u0644\u0631\u0627\u0626\u062f\u0629 \u0628\u062a\u0623\u0633\u064a\u0633 \u0634\u0639\u0648\u0631 \u0628\u0627\u0644\u062b\u0642\u0629 \u0648\u0627\u0644\u0645\u0648\u062b\u0648\u0642\u064a\u0629 \u0641\u064a \u062e\u062f\u0645\u0627\u062a\u0647\u0645. (\u0645\u0635\u062f\u0631:\\x3Ca href=\\\"http://www.principleformac.com\\\" rel=\\\"noopener\\\" target=\\\"_blank\\\">www.principleformac.com\\x3C/a>)\\x3C/em>\\x3C/p>\\x3C/div>\\n\\x3Cp>\\x3Cb>\\x3Ci>\u0627\u0644\u0646\u062f\u0631\u0629\\x3C/i>\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\\x3Cstrong>\u064a\u0639\u0644\u0642 \u0627\u0644\u0646\u0627\u0633 \u0642\u064a\u0645\u0629 \u0623\u0643\u0628\u0631 \u0639\u0644\u0649 \u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u0645\u062d\u062f\u0648\u062f\u0629 \u0627\u0644\u0639\u062f\u062f \u0623\u0648 \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u0644\u0641\u062a\u0631\u0629 \u0645\u062d\u062f\u0648\u062f\u0629.\\x3C/strong> \u064a\u0639\u062f \u0627\u0644\u0634\u0645\u0648\u0644 \u0627\u0644\u0645\u062d\u062f\u0648\u062f\u060c \u0648\u062e\u0644\u0642 \u0634\u0639\u0648\u0631 \u0628\u0627\u0644\u062d\u0635\u0631\u064a\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 \u062c\u0639\u0644 \u0627\u0644\u062e\u062f\u0645\u0629 \\\"\u0644\u0644\u062f\u0639\u0648\u0629 \u0641\u0642\u0637\\\" \u0623\u0648 \u0645\u0639\u0627\u064a\u0646\u0629 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u062d\u062f\u0648\u062f\u0629 \u062f\u0648\u0646 \u062a\u0633\u062c\u064a\u0644\u060c \u062c\u0627\u0646\u0628\u064b\u0627 \u0631\u0626\u064a\u0633\u064a\u064b\u0627 \u0623\u064a\u0636\u064b\u0627 \u0645\u0646 \u0645\u0628\u062f\u0623 \u0627\u0644\u0646\u062f\u0631\u0629. \u0625\u0646\u0647 \u064a\u062b\u064a\u0631 \u0638\u0627\u0647\u0631\u0629 \u0646\u0641\u0633\u064a\u0629 \u062a\u0639\u0631\u0641 \u0628\u0627\u0633\u0645 FOMO\u060c \u0623\u0648 \\\"\u0627\u0644\u062e\u0648\u0641 \u0645\u0646 \u062a\u0641\u0648\u064a\u062a \u0634\u064a\u0621 \u0645\u0627\\\".\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u062a\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u062b\u0627\u0644 \u062c\u064a\u062f \u0639\u0644\u0649 \u0630\u0644\u0643 \u0639\u0644\u0649 Booking.com \u062d\u064a\u062b \u064a\u062a\u0645 \u0639\u0631\u0636 \u0639\u062f\u062f \u0627\u0644\u063a\u0631\u0641 \u0627\u0644\u0645\u062a\u0628\u0642\u064a\u0629 \u0644\u0644\u0632\u0648\u0627\u0631\u060c \u0645\u0645\u0627 \u064a\u062e\u0644\u0642 \u0634\u0639\u0648\u0631\u0627\u064b \u0628\u0627\u0644\u0625\u0644\u062d\u0627\u062d \u0644\u0627\u062a\u062e\u0627\u0630 \u0642\u0631\u0627\u0631 \u0642\u0628\u0644 \u0641\u0648\u0627\u062a \u0627\u0644\u0623\u0648\u0627\u0646. \u062a\u0633\u062a\u062e\u062f\u0645 Groupon \u0648\u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0627\u0644\u0623\u062e\u0631\u0649 \u0639\u0628\u0631 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0623\u064a\u0636\u064b\u0627 \u0645\u0628\u062f\u0623 \u0627\u0644\u0646\u062f\u0631\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 \u062a\u0648\u0641\u064a\u0631 \u0627\u0644\u0639\u062f \u0627\u0644\u062a\u0646\u0627\u0632\u0644\u064a \u0644\u0644\u0645\u0648\u0639\u062f \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0644\u0644\u0639\u0631\u0636.\\x3C/span>\\x3C/p>\\n\\x3Cdiv class=\\\"wp-caption aligncenter\\\" id=\\\"attachment_11641\\\" style=\\\"width: 848px\\\">\\x3Cimg alt=\\\"Booking scarcity\\\" aria-describedby=\\\"caption-attachment-11641\\\" class=\\\"size-full wp-image-11641\\\" decoding=\\\"async\\\" height=\\\"394\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 838px) 100vw, 838px\\\" src=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-46.png\\\" srcset=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-46.png 838w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.33.27-PM-300x141.png 300w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.33.27-PM-768x361.png 768w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.33.27-PM-330x155.png 330w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.33.27-PM-736x346.png 736w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.33.27-PM-414x195.png 414w\\\" width=\\\"838\\\"/>\\x3Cp class=\\\"wp-caption-text\\\" id=\\\"caption-attachment-11641\\\">\\x3Cem>\u064a\u0624\u062f\u064a \u0639\u0631\u0636 \u0627\u0644\u0639\u062f\u062f \u0627\u0644\u0645\u062d\u062f\u0648\u062f \u0645\u0646 \u0627\u0644\u063a\u0631\u0641 \u0627\u0644\u0645\u062a\u0628\u0642\u064a\u0629 \u0625\u0644\u0649 \u0632\u064a\u0627\u062f\u0629 \u0627\u062d\u062a\u0645\u0627\u0644 \u0642\u064a\u0627\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0628\u0627\u062a\u062e\u0627\u0630 \u0625\u062c\u0631\u0627\u0621 \u0642\u0628\u0644 \u0639\u062f\u0645 \u062a\u0631\u0643 \u0623\u064a \u0645\u0646\u0647\u0627. (\u0645\u0635\u062f\u0631:\\x3Ca href=\\\"http://www.booking.com\\\" rel=\\\"noopener\\\" target=\\\"_blank\\\">www.booking.com\\x3C/a>)\\x3C/em>\\x3C/p>\\x3C/div>\\n\\x3Cdiv class=\\\"wp-caption aligncenter\\\" style=\\\"width: 594px\\\">\\x3Cimg alt=\\\"Countdown Timer\\\" class=\\\"wp-image-11642\\\" decoding=\\\"async\\\" height=\\\"426\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 584px) 100vw, 584px\\\" src=\\\"/wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.36.46-PM.png\\\" srcset=\\\"/wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.36.46-PM.png 675w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.36.46-PM-300x219.png 300w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.36.46-PM-330x241.png 330w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.36.46-PM-245x180.png 245w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.36.46-PM-568x414.png 568w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.36.46-PM-414x302.png 414w\\\" width=\\\"584\\\"/>\\x3Cp class=\\\"wp-caption-text\\\">\u064a\u0633\u062a\u062e\u062f\u0645 \u0647\u0630\u0627 \u0627\u0644\u0645\u062a\u062c\u0631 \u0639\u0628\u0631 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0645\u0624\u0642\u062a\u064b\u0627 \u0644\u0644\u0639\u062f \u0627\u0644\u062a\u0646\u0627\u0632\u0644\u064a \u0644\u0644\u0628\u064a\u0639 \u0644\u0641\u062a\u0631\u0629 \u0645\u062d\u062f\u0648\u062f\u0629 \u0644\u062e\u0644\u0642 \u0634\u0639\u0648\u0631 \u0628\u0627\u0644\u0625\u0644\u062d\u0627\u062d \u0644\u062f\u0649 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u0627\u062a\u062e\u0627\u0630 \u0625\u062c\u0631\u0627\u0621 \u0642\u0628\u0644 \u0623\u0646 \u064a\u0641\u0648\u062a\u0643 \u0627\u0644\u062a\u0648\u0641\u064a\u0631. (\u0645\u0635\u062f\u0631:\\x3Ca href=\\\"http://www.extrastores.com\\\" rel=\\\"noopener\\\" target=\\\"_blank\\\">www.extrastores.com\\x3C/a>)\\x3C/p>\\x3C/div>\\n\\x3Cp>\\x3Cb>\\x3Ci>\u062a\u0631\u0648\u0642\\x3C/i>\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\\x3Cstrong>\u0645\u0646 \u0627\u0644\u0645\u0631\u062c\u062d \u0623\u0646 \u062a\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0645\u0646 \u0627\u0644\u0623\u0634\u062e\u0627\u0635 \u0627\u0644\u0630\u064a\u0646 \u062a\u062d\u0628\u0647\u0645.\\x3C/strong> \u0645\u0646 \u0623\u0635\u062f\u0642\u0627\u0626\u0643 \u0627\u0644\u0645\u0642\u0631\u0628\u064a\u0646 \u0625\u0644\u0649 \u0627\u0644\u063a\u0631\u0628\u0627\u0621 \u0627\u0644\u0630\u064a\u0646 \u062a\u0646\u062c\u0630\u0628 \u0625\u0644\u064a\u0647\u0645. \u063a\u0627\u0644\u0628\u064b\u0627 \u0645\u0627 \u062a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0627\u0644\u0643\u0628\u0631\u0649 \u0627\u0644\u0645\u0634\u0627\u0647\u064a\u0631 \u0648\u0627\u0644\u0631\u064a\u0627\u0636\u064a\u064a\u0646 \u0648\u0627\u0644\u0639\u0627\u0631\u0636\u0627\u062a \u0644\u062c\u0639\u0644 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0623\u0643\u062b\u0631 \u0645\u0644\u0627\u0621\u0645\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cdiv class=\\\"wp-caption aligncenter\\\" id=\\\"attachment_11644\\\" style=\\\"width: 636px\\\">\\x3Cimg alt=\\\"Turkish Airlines Celebrity Ad\\\" aria-describedby=\\\"caption-attachment-11644\\\" class=\\\"size-full wp-image-11644\\\" decoding=\\\"async\\\" height=\\\"415\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 626px) 100vw, 626px\\\" src=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-11.jpg\\\" srcset=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-11.jpg 626w, /uploads/articles/ux-psychology-principles-design-ux/inline-57.jpg 300w, /uploads/articles/ux-psychology-principles-design-ux/inline-1.jpg 150w, /uploads/articles/ux-psychology-principles-design-ux/inline-72.jpg 330w, /uploads/articles/ux-psychology-principles-design-ux/inline-61.jpg 624w, /wp-contentuploads/2018/03/turkishairlines-414x274.jpg 414w\\\" width=\\\"626\\\"/>\\x3Cp class=\\\"wp-caption-text\\\" id=\\\"caption-attachment-11644\\\">\u0627\u0633\u062a\u062e\u062f\u0645\u062a \u0627\u0644\u062e\u0637\u0648\u0637 \u0627\u0644\u062c\u0648\u064a\u0629 \u0627\u0644\u062a\u0631\u0643\u064a\u0629 \u0628\u0630\u0643\u0627\u0621 \u0627\u062b\u0646\u064a\u0646 \u0645\u0646 \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u064a\u0646 \u0627\u0644\u0631\u0627\u0626\u0639\u064a\u0646 \u0627\u0644\u0645\u062d\u0628\u0648\u0628\u064a\u0646 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0645\u0644\u0627\u064a\u064a\u0646 \u0644\u0644\u062a\u0631\u0648\u064a\u062c \u0644\u0639\u0644\u0627\u0645\u062a\u0647\u0627 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0648\u062e\u0644\u0642\u062a \u0636\u062c\u0629 \u062d\u0648\u0644 \u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0637\u064a\u0631\u0627\u0646 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0647\u0627. (\u0645\u0635\u062f\u0631:\\x3Ca href=\\\"http://www.turkishairlines.com\\\" rel=\\\"noopener\\\" target=\\\"_blank\\\">www.turkishairlines.com\\x3C/a>)\\x3C/p>\\x3C/div>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u062a\u0641\u0642 \u0627\u0644\u0646\u0627\u0633 \u0648\u064a\u062a\u0628\u0639\u0648\u0646 \u0627\u0644\u0622\u062e\u0631\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0634\u0628\u0647\u0648\u0646\u0647\u0645 \u0645\u0646 \u062d\u064a\u062b \u0627\u0644\u0627\u0647\u062a\u0645\u0627\u0645\u0627\u062a \u0648\u0627\u0644\u0622\u0631\u0627\u0621 \u0648\u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0648\u063a\u064a\u0631\u0647\u0627 \u0645\u0646 \u0627\u0644\u0633\u0645\u0627\u062a. \u0625\u0646 \u0627\u0644\u062a\u0641\u0627\u0639\u0644 \u0645\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0642\u0646\u0648\u0627\u062a \u0645\u062e\u062a\u0644\u0641\u0629 \u0644\u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a \u0648\u0645\u0646\u0634\u0648\u0631\u0627\u062a \u0627\u0644\u0645\u062f\u0648\u0646\u0627\u062a \u0644\u062a\u0643\u0648\u064a\u0646 \u0634\u0639\u0648\u0631 \u0645\u0631\u062a\u0628\u0637 \u0628\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0633\u064a\u0633\u0627\u0639\u062f \u0628\u0627\u0644\u062a\u0623\u0643\u064a\u062f \u0639\u0644\u0649 \u062a\u062d\u0633\u064a\u0646 \u0645\u0631\u0627\u062c\u0639\u0627\u062a\u0643 \u0648\u062a\u0642\u064a\u064a\u0645\u0627\u062a\u0643.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cb>\\x3Ci>\u0625\u062b\u0628\u0627\u062a \u0627\u062c\u062a\u0645\u0627\u0639\u064a\\x3C/i>\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0644\u0627 \u064a\u0639\u0631\u0641 \u0627\u0644\u0646\u0627\u0633 \u062f\u0627\u0626\u0645\u064b\u0627 \u0633\u0628\u0628 \u062a\u0635\u0631\u0641\u0647\u0645 \u0628\u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u064a \u064a\u062a\u0635\u0631\u0641\u0648\u0646 \u0628\u0647\u0627.\\x3C/span>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0646\u062d\u0646 \u0646\u062a\u0637\u0644\u0639 \u0625\u0644\u0649 \u0627\u0644\u0622\u062e\u0631\u064a\u0646 \u0644\u062a\u0648\u062c\u064a\u0647 \u0633\u0644\u0648\u0643\u0646\u0627 \u0648\u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0634\u064a\u0621 \\\"\u0627\u0644\u0635\u062d\u064a\u062d\\\" \u0627\u0644\u0630\u064a \u064a\u062c\u0628 \u0627\u0644\u0642\u064a\u0627\u0645 \u0628\u0647.\\x3Cstrong>\u0646\u062d\u0646 \u0646\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0635\u062d\u0629 \u0623\u0641\u0639\u0627\u0644\u0646\u0627 \u0648\u0642\u0631\u0627\u0631\u0627\u062a\u0646\u0627 \u0645\u0646 \u0627\u0644\u062e\u0628\u0631\u0627\u0621 \u0623\u0648 \u0627\u0644\u0645\u0634\u0627\u0647\u064a\u0631 \u0623\u0648 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0633\u0627\u0628\u0642\u064a\u0646 \u0623\u0648 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0643\u0628\u064a\u0631\u0629 \u0623\u0648 \u0627\u0644\u0623\u0642\u0631\u0627\u0646.\\x3C/strong>\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0641\u064a \u0627\u0644\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629\u060c \u062a\u0633\u062a\u062e\u062f\u0645 \u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u0623\u062f\u0644\u0629 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 \u0645\u062b\u0644 \u0627\u0644\u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0648\u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0627\u062a \u0648\u0627\u0644\u062a\u0648\u0635\u064a\u0627\u062a \u0644\u062c\u0630\u0628 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0622\u062e\u0631\u064a\u0646 \u0648\u0625\u0631\u0634\u0627\u062f\u0647\u0645 \u0641\u064a \u0627\u062a\u062e\u0627\u0630 \u0642\u0631\u0627\u0631\u0627\u062a \u0627\u0644\u0634\u0631\u0627\u0621. \u0644\u062f\u0649 \u0623\u0645\u0627\u0632\u0648\u0646 \u0642\u0633\u0645 \\\"\u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0627\u0644\u0630\u064a\u0646 \u0627\u0634\u062a\u0631\u0648\u0627 \u0647\u0630\u0627 \u0627\u0644\u0639\u0646\u0635\u0631 \u0627\u0634\u062a\u0631\u0648\u0627 \u0623\u064a\u0636\u064b\u0627\\\" \u0644\u062c\u0639\u0644 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0623\u0643\u062b\u0631 \u0627\u0631\u062a\u0628\u0627\u0637\u064b\u0627 \u0628\u0643 \u0648\u062c\u0639\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u0641\u0643\u0631\u0648\u0646 \\\"\u0625\u0630\u0627 \u0643\u0627\u0646\u0648\u0627 \u0641\u064a \u062d\u0627\u062c\u0629 \u0625\u0644\u064a\u0647\u0627\u060c \u0641\u0623\u0646\u0627 \u0628\u062d\u0627\u062c\u0629 \u0625\u0644\u064a\u0647\u0627 \u0623\u064a\u0636\u064b\u0627\\\".\\x3C/span>\\x3C/p>\\n\\x3Cdiv class=\\\"wp-caption aligncenter\\\" id=\\\"attachment_11645\\\" style=\\\"width: 807px\\\">\\x3Cimg alt=\\\"Amazon Recommendations\\\" aria-describedby=\\\"caption-attachment-11645\\\" class=\\\"size-full wp-image-11645\\\" decoding=\\\"async\\\" height=\\\"357\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 797px) 100vw, 797px\\\" src=\\\"/wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.55.48-PM.png\\\" srcset=\\\"/wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.55.48-PM.png 797w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.55.48-PM-300x134.png 300w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.55.48-PM-768x344.png 768w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.55.48-PM-330x148.png 330w, /uploads/articles/ux-psychology-principles-design-ux/inline-30.png 736w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-13-at-3.55.48-PM-414x185.png 414w\\\" width=\\\"797\\\"/>\\x3Cp class=\\\"wp-caption-text\\\" id=\\\"caption-attachment-11645\\\">\\x3Cem>\u062a\u06