onomy:\"category\",parent:0,meta:$R[219]=[]},$R[220]={id:4,count:3,description:\"\",link:\"/category/ecommerce\",name:\"Ecommerce\",slug:\"ecommerce\",taxonomy:\"category\",parent:0,meta:$R[221]=[]},$R[100],$R[102]],tag_objects:$R[222]=[$R[223]={id:180,count:4,description:\"\",link:\"/tag/customer-experience\",name:\"customer experience\",slug:\"customer-experience\",taxonomy:\"post_tag\",meta:$R[224]=[]},$R[225]={id:185,count:2,description:\"\",link:\"/tag/ecommerce\",name:\"ecommerce\",slug:\"ecommerce\",taxonomy:\"post_tag\",meta:$R[226]=[]},$R[227]={id:101,count:8,description:\"\",link:\"/tag/usability-testing\",name:\"Usability Testing\",slug:\"usability-testing\",taxonomy:\"post_tag\",meta:$R[228]=[]},$R[229]={id:106,count:9,description:\"\",link:\"/tag/user-research\",name:\"User Research\",slug:\"user-research\",taxonomy:\"post_tag\",meta:$R[230]=[]},$R[133],$R[231]={id:171,count:2,description:\"\",link:\"/tag/web-design\",name:\"web design\",slug:\"web-design\",taxonomy:\"post_tag\",meta:$R[232]=[]}]},$R[233]={id:10110,date:\"2017-09-27T14:31:15\",date_gmt:\"2017-09-27T14:31:15\",guid:$R[234]={rendered:\"/?p=10110\"},modified:\"2026-02-19T11:23:43\",modified_gmt:\"2026-02-19T11:23:43\",slug:\"why-ux-not-ui\",status:\"publish\",link:\"/why-ux-not-ui\",title:$R[235]={rendered:\"\u0644\u0645\u0627\u0630\u0627 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u064a\u0633\u062a \u0648\u0627\u062c\u0647\u0629 \u0645\u0633\u062a\u062e\u062f\u0645\u061f\"},content:$R[236]={rendered:\"\\x3Cp>\\x3Cb>\u062a\u0635\u0645\u064a\u0645 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 (UX).\\x3C/b>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0648\\x3C/span>\\x3Cb>\u062a\u0635\u0645\u064a\u0645 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 (UI).\\x3C/b>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0647\u064a \u0628\u0639\u0636 \u0645\u0646 \u0623\u0643\u062b\u0631 \u0627\u0644\u0645\u0635\u0637\u0644\u062d\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u0633\u0627\u0621 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0627 \u0641\u064a \u0635\u0646\u0627\u0639\u062a\u0646\u0627.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u063a\u0627\u0644\u0628\u064b\u0627 \u0645\u0627 \u062a\u0643\u062a\u0628 \u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0627\u0644\u0648\u0638\u0627\u0626\u0641 \\\"UI/UX\\\" \u0643\u0645\u0627 \u0644\u0648 \u0643\u0627\u0646\u062a \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u0628\u062f\u064a\u0644.\\x3Ca href=\\\"https://www.jnd.org/\\\">\u062f\u0648\u0646 \u0646\u0648\u0631\u0645\u0627\u0646\\x3C/a>\u0642\u0627\u0644: \\\"\u0644\u0642\u062f \u062f\u062e\u0644\u062a \u0647\u0630\u0647 \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0625\u0644\u0649 \u062d\u062f \u0645\u0627 \u0641\u064a \u0627\u0644\u0645\u0641\u0631\u062f\u0627\u062a \u0648\u0644\u0645 \u064a\u0639\u062f \u0644\u0647\u0627 \u0623\u064a \u0645\u0639\u0646\u0649 \u062e\u0627\u0635. \u064a\u0633\u062a\u062e\u062f\u0645\u0647\u0627 \u0627\u0644\u0646\u0627\u0633 \u0641\u064a \u0643\u062b\u064a\u0631 \u0645\u0646 \u0627\u0644\u0623\u062d\u064a\u0627\u0646 \u062f\u0648\u0646 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0644\u062f\u064a\u0647\u0645 \u0623\u064a \u0641\u0643\u0631\u0629 \u0639\u0646 \u0627\u0644\u0633\u0628\u0628\u060c \u0623\u0648 \u0645\u0627\u0630\u0627 \u062a\u0639\u0646\u064a \u0627\u0644\u0643\u0644\u0645\u0629\u060c \u0623\u0648 \u0623\u0635\u0644\u0647\u0627\u060c \u0623\u0648 \u062a\u0627\u0631\u064a\u062e\u0647\u0627\u060c \u0623\u0648 \u0645\u0627 \u062a\u062a\u062d\u062f\u062b \u0639\u0646\u0647.\\\"\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0625\u0630\u064b\u0627\u060c \u0645\u0627 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u061f \u0645\u0627 \u0627\u0644\u0645\u0642\u0635\u0648\u062f \u0628\u0627\u0644\u0636\u0628\u0637 \u0628\u0640 \\\"\u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062c\u064a\u062f\u0629\\\" \u0623\u0648 \\\"\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0636\u0639\u064a\u0641\u0629\\\"\u061f\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0647\u0646\u0627\u0643 \u0627\u0644\u0643\u062b\u064a\u0631 \u0645\u0646 \u0627\u0644\u0627\u0644\u062a\u0628\u0627\u0633 \u062d\u0648\u0644 \u0647\u0630\u064a\u0646 \u0627\u0644\u0645\u0635\u0637\u0644\u062d\u064a\u0646. \u062f\u0639\u0648\u0646\u0627 \u0623\u0648\u0644\u0627\u064b \u0646\u0644\u0642\u064a \u0646\u0638\u0631\u0629 \u0623\u0639\u0645\u0642 \u0639\u0644\u0649 \u0645\u0627 \u064a\u0639\u0646\u064a\u0647 \u0643\u0644 \u0645\u0646\u0647\u0645.\\x3C/span>\\x3C/p>\\n\\x3Ch2>\\x3Cb>\u062a\u0639\u0631\u064a\u0641 \u062a\u0635\u0645\u064a\u0645 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\\x3C/b>\\x3C/h2>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0623\u0648 UX \u0647\u0648 \u0627\u0644\u0645\u0635\u0637\u0644\u062d \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u064a\u0634\u0645\u0644 \u0643\u0627\u0645\u0644 \u0645\u0627 \u064a\u0634\u0639\u0631 \u0628\u0647 \u0627\u0644\u0634\u062e\u0635 \u0639\u0646\u062f \u0627\u0644\u062a\u0641\u0627\u0639\u0644 \u0645\u0639 \u0646\u0638\u0627\u0645 \u0623\u0648 \u0645\u0646\u062a\u062c. \u0641\u064a \u062d\u064a\u0646 \u0623\u0646 \u0627\u0644\u0646\u0638\u0627\u0645 \u0623\u0648 \u0627\u0644\u0645\u0646\u062a\u062c \u0644\u064a\u0633 \u0645\u0646 \u0627\u0644\u0636\u0631\u0648\u0631\u064a \u0623\u0646 \u064a\u0643\u0648\u0646 \u0631\u0642\u0645\u064a\u064b\u0627\u060c \u0641\u0625\u0646\u0647 \u0641\u064a \u0645\u0639\u0638\u0645 \u0627\u0644\u0633\u064a\u0627\u0642\u0627\u062a \u0627\u0644\u062d\u062f\u064a\u062b\u0629 \u064a\u0634\u064a\u0631 \u0639\u0645\u0648\u0645\u064b\u0627 \u0625\u0644\u0649 \u0623\u064a \u0645\u0646\u062a\u062c \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0634\u0643\u0644 \u0645\u0646 \u0623\u0634\u0643\u0627\u0644 \u0627\u0644\u062a\u0641\u0627\u0639\u0644 \u0628\u064a\u0646 \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0648\u0627\u0644\u062d\u0627\u0633\u0648\u0628 (HCI).\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0639\u0645\u0644\u064a\u0629\\x3Cstrong>\u062a\u0635\u0645\u064a\u0645 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 (UXD)\\x3C/strong> \u064a\u062a\u0639\u0644\u0642 \u0628\u0643\u064a\u0641\u064a\u0629 \u062a\u0642\u064a\u064a\u0645 \u0645\u0635\u0645\u0645\u064a \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u0645\u0627 \u064a\u0634\u0639\u0631 \u0628\u0647 \u0627\u0644\u0634\u062e\u0635 \u0639\u0646\u062f \u0627\u0644\u062a\u0641\u0627\u0639\u0644 \u0645\u0639 \u0627\u0644\u0646\u0638\u0627\u0645 \u0648\u0627\u0644\u0623\u0633\u0627\u0644\u064a\u0628 \u0648\u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u062a\u0628\u0639\u0648\u0646\u0647\u0627 \u0644\u0632\u064a\u0627\u062f\u0629 \u0627\u0644\u0643\u0641\u0627\u0621\u0629 \u0648\u0627\u0644\u0631\u0636\u0627 \u0648\u0627\u0644\u0645\u0646\u0641\u0639\u0629 \u0648\u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0646 \u0633\u0645\u0627\u062a \u0627\u0644\u062c\u0648\u062f\u0629 \u0627\u0644\u0623\u062e\u0631\u0649.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cimg alt=\\\"UXBERT_UX_Process_v2\\\" class=\\\"aligncenter size-full wp-image-11126\\\" decoding=\\\"async\\\" height=\\\"2048\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 1558px) 100vw, 1558px\\\" src=\\\"/uploads/articles/why-ux-not-ui/inline-10.png\\\" srcset=\\\"/uploads/articles/why-ux-not-ui/inline-10.png 1558w, /uploads/articles/why-ux-not-ui/inline-16.png 228w, /uploads/articles/why-ux-not-ui/inline-0.png 768w, /uploads/articles/why-ux-not-ui/inline-19.png 779w, /uploads/articles/why-ux-not-ui/inline-14.png 198w, /uploads/articles/why-ux-not-ui/inline-4.png 974w, /uploads/articles/why-ux-not-ui/inline-13.png 584w, /uploads/articles/why-ux-not-ui/inline-11.png 315w, /uploads/articles/why-ux-not-ui/inline-17.png 1280w, /uploads/articles/why-ux-not-ui/inline-7.png 414w\\\" width=\\\"1558\\\"/>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u062a\u0639\u062f \u0639\u0645\u0644\u064a\u0629 \u062a\u0635\u0645\u064a\u0645 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0645\u0644\u064a\u0629 \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0623\u0648\u062c\u0647 \u0648\u062a\u062a\u0636\u0645\u0646 \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u062e\u0637\u0648\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062a\u0631\u0627\u0648\u062d \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\\x3C/span>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0627\u0644\u0628\u062d\u062b \u0648\u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0623\u0648\u0644\u064a\u0629 \u0644\u0644\u062a\u0637\u0648\u064a\u0631 \u0648\u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645. \u0628\u0627\u062e\u062a\u0635\u0627\u0631 \u0627\u0644\u062a\u0635\u0645\u064a\u0645\\x3C/span>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u062a\u0639\u0644\u0642 UX \u0628\u0627\u0644\u062a\u0635\u0645\u064a\u0645\\x3C/span>\\x3Cb>\u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0628\u0631\u0645\u062a\u0647\u0627.\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0648\u0628\u0635\u0631\u0641 \u0627\u0644\u0646\u0638\u0631 \u0639\u0646 \u0627\u0644\u0628\u062d\u062b \u0648\u0627\u0644\u062a\u0635\u0645\u064a\u0645\u060c \u064a\u0645\u0643\u0646 \u0623\u064a\u0636\u064b\u0627 \u0644\u0645\u0635\u0645\u0645 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0623\u0646 \u064a\u0634\u0627\u0631\u0643 \u0641\u064a \u0645\u062c\u0627\u0644\u0627\u062a \u0645\u062b\u0644 \u0627\u0644\u062a\u0633\u0648\u064a\u0642 \u0648\u0627\u0644\u0627\u062a\u0635\u0627\u0644\u0627\u062a \u0648\u0627\u0644\u062f\u0639\u0645 \u0644\u0636\u0645\u0627\u0646 \u062a\u0645\u0627\u0633\u0643 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0645\u0646 \u0627\u0644\u0628\u062f\u0627\u064a\u0629 \u0625\u0644\u0649 \u0627\u0644\u0646\u0647\u0627\u064a\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u0646\u0637\u0628\u0642 \u062a\u0635\u0645\u064a\u0645 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0644\u0649 \u062a\u0635\u0645\u064a\u0645 \u0623\u064a \u0648\u0633\u064a\u0644\u0629 \u2013 \u0645\u0646\u062a\u062c \u0623\u0648 \u0645\u0648\u0642\u0639 \u0648\u064a\u0628 \u0623\u0648 \u062a\u0637\u0628\u064a\u0642 \u0623\u0648 \u062d\u062f\u062b. \u0648\u0647\u0648 \u0645\u0633\u062a\u0645\u062f \u0645\u0646 \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u062a\u062e\u0635\u0635\u0627\u062a \u0645\u062b\u0644 \u0627\u0644\u0639\u0644\u0648\u0645 \u0627\u0644\u0645\u0639\u0631\u0641\u064a\u0629 \u0648\u0627\u0644\u0623\u0646\u062b\u0631\u0648\u0628\u0648\u0644\u0648\u062c\u064a\u0627 \u0648\u0639\u0644\u0645 \u0627\u0644\u0646\u0641\u0633 \u0648\u0639\u0644\u0648\u0645 \u0627\u0644\u0643\u0645\u0628\u064a\u0648\u062a\u0631 \u0648\u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u062c\u0631\u0627\u0641\u064a\u0643\u064a.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cb>\u062a\u0635\u0645\u064a\u0645 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 (UID)\\x3C/b>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0645\u0646 \u0646\u0627\u062d\u064a\u0629 \u0623\u062e\u0631\u0649\u060c \u062a\u0647\u062a\u0645 \u0641\u0642\u0637 \u0628\u0645\u0638\u0647\u0631 \u0627\u0644\u0645\u0646\u062a\u062c \u0648\u0645\u0644\u0645\u0633\u0647. \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 (UI) \u0647\u064a \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0645\u0631\u0626\u064a\u0629 \u0648\u0627\u0644\u0641\u0646\u064a\u0629 \u0644\u0644\u0648\u0627\u062c\u0647\u0629\u060c \u0645\u062b\u0644 \u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062a\u062d\u0643\u0645 \u0648\u0627\u0644\u0623\u0632\u0631\u0627\u0631 \u0648\u063a\u064a\u0631\u0647\u0627 \u0627\u0644\u062a\u064a \u062a\u0633\u0645\u062d \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0628\u0627\u0644\u062a\u0641\u0627\u0639\u0644 \u0645\u0639 \u0627\u0644\u0645\u0646\u062a\u062c.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0644\u062c\u0639\u0644 \u0627\u0644\u0623\u0645\u0648\u0631 \u0623\u0643\u062b\u0631 \u0628\u0633\u0627\u0637\u0629\u060c \u062f\u0639\u0648\u0646\u0627 \u0646\u0641\u0643\u0631 \u0641\u064a \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a \u0633\u064a\u0627\u0642 \u0627\u0644\u0645\u0637\u0639\u0645. \u0633\u062a\u0643\u0648\u0646 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u0644\u0645\u0637\u0639\u0645 \u0647\u064a \u0627\u0644\u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0645\u0631\u0626\u064a \u0627\u0644\u0645\u062d\u064a\u0637 \u0628\u0647 \u2013 \u0645\u0627 \u0644\u0648\u0646 \u0648\u0631\u0642 \u0627\u0644\u062d\u0627\u0626\u0637\u061f \u0643\u064a\u0641 \u064a\u062a\u0645 \u0645\u062d\u0627\u0630\u0627\u0629 \u0627\u0644\u0643\u0631\u0627\u0633\u064a \u0648\u0627\u0644\u0637\u0627\u0648\u0644\u0627\u062a\u061f \u0645\u0627 \u0645\u062f\u0649 \u0633\u0637\u0648\u0639 \u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0623\u0648 \u062e\u0627\u0641\u062a\u0647\u0627\u061f\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0641\u064a \u0639\u0627\u0644\u0645 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a\u060c \u064a\u0643\u0648\u0646 \u0645\u0635\u0645\u0645 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0633\u0624\u0648\u0644\u0627\u064b \u0639\u0646 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0637\u0628\u0627\u0639\u0629 \u0648\u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0627\u062a \u0648\u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062a\u0641\u0627\u0639\u0644\u064a\u0629 \u0627\u0644\u0623\u062e\u0631\u0649 \u0627\u0644\u062a\u064a \u062a\u062d\u0644 \u0645\u0634\u0643\u0644\u0627\u062a \u0627\u0644\u062a\u0641\u0627\u0639\u0644 \u0627\u0644\u0645\u0628\u0627\u0634\u0631 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645.\\x3C/span>\\x3C/p>\\n\\x3Cdiv class=\\\"wp-caption aligncenter\\\" id=\\\"attachment_10113\\\" style=\\\"width: 760px\\\">\\x3Cimg alt=\\\"UI elements on the Facebook homepage\\\" aria-describedby=\\\"caption-attachment-10113\\\" class=\\\"wp-image-10113\\\" decoding=\\\"async\\\" height=\\\"422\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 750px) 100vw, 750px\\\" src=\\\"/uploads/articles/why-ux-not-ui/inline-5.png\\\" srcset=\\\"/uploads/articles/why-ux-not-ui/inline-5.png 1056w, /uploads/articles/why-ux-not-ui/inline-9.png 300w, /uploads/articles/why-ux-not-ui/inline-8.png 768w, /uploads/articles/why-ux-not-ui/inline-20.png 1024w, /uploads/articles/why-ux-not-ui/inline-12.png 330w, /uploads/articles/why-ux-not-ui/inline-3.png 736w, /uploads/articles/why-ux-not-ui/inline-2.png 414w\\\" width=\\\"750\\\"/>\\x3Cp class=\\\"wp-caption-text\\\" id=\\\"caption-attachment-10113\\\">\\x3Cem>\u0639\u0646\u0627\u0635\u0631 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0644\u0649 \u0635\u0641\u062d\u0629 \u0627\u0644\u0641\u064a\u0633\u0628\u0648\u0643 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629\\x3C/em>\\x3C/p>\\x3C/div>\\n\\x3Ch2>\\x3Cb>\u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\\x3C/b>\\x3C/h2>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0644\u0643\u062b\u064a\u0631 \u0645\u0646 \u0627\u0644\u0623\u0634\u062e\u0627\u0635\u060c \u0641\u0625\u0646 \u0627\u0644\u062e\u0637 \u0627\u0644\u0641\u0627\u0635\u0644 \u0628\u064a\u0646 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u063a\u064a\u0631 \u0648\u0627\u0636\u062d.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0628\u0643\u0644 \u0628\u0633\u0627\u0637\u0629\u060c \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0647\u064a \u0645\u0627 \u064a\u0648\u0627\u062c\u0647 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0646\u062f\u0645\u0627 \u064a\u0646\u0638\u0631 \u0625\u0644\u0649 \u0627\u0644\u0645\u0646\u062a\u062c \u0628\u064a\u0646\u0645\u0627 \u062a\u063a\u0637\u064a \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u062c\u0645\u0644 \u062a\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0639 \u0627\u0644\u0645\u0646\u062a\u062c. \u062a\u062a\u0639\u0644\u0642 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0645\u0648\u0645\u064b\u0627 \u0628\u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0645\u0631\u0626\u064a \u0648\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a\u064a \u062d\u0648\u0644 \u0627\u0644\u0648\u0627\u062c\u0647\u0629. \u0625\u0646 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u062a\u062a\u0639\u0644\u0642 \u0628\u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0643\u0627\u0645\u0644\u0629\u060c \u0648\u0642\u062f \u0644\u0627 \u062a\u062a\u0639\u0644\u0642 \u062d\u062a\u0649 \u0628\u0627\u0644\u0648\u0627\u062c\u0647\u0629. \u0644\u062a\u0642\u062f\u064a\u0645 \u062a\u062c\u0631\u0628\u0629 \u0634\u0627\u0645\u0644\u0629 \u0627\u0633\u062a\u062b\u0646\u0627\u0626\u064a\u0629\u060c \u064a\u062c\u0628 \u0623\u0646 \u064a\u0633\u064a\u0631\u0627 \u062c\u0646\u0628\u064b\u0627 \u0625\u0644\u0649 \u062c\u0646\u0628.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0644\u0641\u0647\u0645 \u0627\u0644\u0623\u0645\u0648\u0631 \u0628\u0633\u0647\u0648\u0644\u0629\u060c \u0641\u0643\u0631 \u0641\u064a \u0623\u0641\u0639\u0648\u0627\u0646\u064a\u0629 \u0641\u064a \u0645\u062f\u064a\u0646\u0629 \u0645\u0644\u0627\u0647\u064a. UX \u0647\u0648 \u0627\u0644\u062a\u0631\u0642\u0628 \u0627\u0644\u0630\u064a \u064a\u0633\u0628\u0642 \u0627\u0644\u0631\u062d\u0644\u0629. \u0625\u0646\u0647 \u0627\u0644\u0634\u0639\u0648\u0631 \u0628\u0627\u0644\u0625\u062b\u0627\u0631\u0629 \u0648\u0627\u0644\u062a\u0634\u0648\u064a\u0642 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0631\u062d\u0644\u0629. \u0625\u0646\u0647 \u0627\u0644\u0634\u0639\u0648\u0631 \u0628\u0627\u0644\u0631\u063a\u0628\u0629 \u0641\u064a \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0623\u0648 UI\u060c \u0647\u064a \u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u064a \u064a\u062a\u0645 \u0628\u0647\u0627 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0631\u062d\u0644\u0629. \u0645\u0648\u0627\u062f \u0627\u0644\u0628\u0646\u0627\u0621 (\u0627\u0644\u0635\u0648\u0627\u0645\u064a\u0644\u060c \u0627\u0644\u0628\u0631\u0627\u063a\u064a\u060c \u0627\u0644\u062e\u0631\u0633\u0627\u0646\u0629\u060c \u0627\u0644\u0641\u0648\u0644\u0627\u0630)\u060c \u062c\u0648\u062f\u0629 \u0627\u0644\u0631\u0643\u0648\u0628 (\u0645\u0627 \u0645\u062f\u0649 \u0645\u062a\u0627\u0646\u062a\u0647\u0627\u061f) \u0648\u0645\u0648\u0636\u0639 \u0627\u0644\u062d\u0644\u0642\u0627\u062a \u0648\u0627\u0644\u0645\u0646\u0639\u0637\u0641\u0627\u062a.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0639\u0644\u0649 \u0627\u0644\u0631\u063a\u0645 \u0645\u0646 \u0623\u0646 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u0627 \u062a\u0634\u0643\u0644 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u062c\u0644\u0648\u0633 \u0641\u064a \u0627\u0644\u0631\u062d\u0644\u0629 \u0628\u0623\u0643\u0645\u0644\u0647\u0627\u060c \u0625\u0644\u0627 \u0623\u0646\u0647\u0627 \u062c\u0632\u0621 \u0645\u0647\u0645 \u062c\u062f\u064b\u0627 \u0645\u0646\u0647\u0627.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0644\u0643\u0646 \u0636\u0639 \u0641\u064a \u0627\u0639\u062a\u0628\u0627\u0631\u0643 \u0623\u0646 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0631\u0627\u0626\u0639\u0629 \u0644\u0627 \u062a\u0639\u0646\u064a \u062a\u062c\u0631\u0628\u0629 \u0645\u0633\u062a\u062e\u062f\u0645 \u0631\u0627\u0626\u0639\u0629. \u0648\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0633\u064a\u0626\u0629 \u0644\u0627 \u062a\u0639\u0646\u064a \u062a\u062c\u0631\u0628\u0629 \u0645\u0633\u062a\u062e\u062f\u0645 \u0633\u064a\u0626\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u062a\u0645 \u062a\u0635\u0645\u064a\u0645 \u0628\u0639\u0636 \u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0644\u062a\u0628\u062f\u0648 \u062c\u0645\u064a\u0644\u0629\u060c \u0648\u0644\u0643\u0646 \u0642\u062f \u064a\u0643\u0648\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0627 \u0645\u062d\u0628\u0637\u064b\u0627 \u0628\u0633\u0628\u0628 \u0623\u0648\u0642\u0627\u062a \u0627\u0644\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0628\u0637\u064a\u0626\u0629 \u0623\u0648 \u0627\u0644\u0623\u0639\u0637\u0627\u0644 \u0627\u0644\u0645\u062a\u0643\u0631\u0631\u0629 \u0623\u0648 \u0627\u0644\u062a\u0646\u0642\u0644 \u063a\u064a\u0631 \u0627\u0644\u062a\u0642\u0644\u064a\u062f\u064a.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0645\u0646 \u0646\u0627\u062d\u064a\u0629 \u0623\u062e\u0631\u0649\u060c \u062a\u062d\u062a\u0648\u064a \u0628\u0639\u0636 \u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0639\u0644\u0649 \u0648\u0627\u062c\u0647\u0629 \u0645\u0633\u062a\u062e\u062f\u0645 \u062a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0627\u0644\u0646\u0635 \u0633\u064a\u0626\u0629 \u0644\u0644\u063a\u0627\u064a\u0629\u060c \u0648\u0644\u0643\u0646\u0647\u0627 \u062a\u062a\u0645\u062a\u0639 \u0628\u062a\u062c\u0631\u0628\u0629 \u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0645\u062a\u0627\u0632\u0629 \u0644\u0623\u0646\u0647\u0627 \u062a\u0641\u0639\u0644 \u0628\u0627\u0644\u0636\u0628\u0637 \u0645\u0627 \u064a\u062a\u0648\u0642\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0645\u0646\u0647\u0645 \u0627\u0644\u0642\u064a\u0627\u0645 \u0628\u0647.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0645\u0648\u0627\u0642\u0639 \u0645\u062b\u0644\\x3Ca href=\\\"https://geo.craigslist.org/iso/us\\\">\u0643\u0631\u064a\u063a\u0633\u0644\u064a\u0633\u062a\\x3C/a>\u0648\\x3Ca href=\\\"https://www.ebay.com/\\\">\u0645\u0648\u0642\u0639 \u0626\u064a \u0628\u0627\u064a\\x3C/a>\u0647\u064a \u0623\u0645\u062b\u0644\u0629 \u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u062a\u064a \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0648\u0627\u062c\u0647\u0629 \u0646\u0635\u064a\u0629 \u0628\u0633\u064a\u0637\u0629 \u0644\u0644\u063a\u0627\u064a\u0629 \u0628\u062f\u0648\u0646 \u0623\u0632\u0631\u0627\u0631 \u0641\u0627\u062e\u0631\u0629. \u0644\u0643\u0646 \u0644\u0627 \u064a\u0632\u0627\u0644 \u0644\u062f\u064a\u0647\u0645 \u0645\u0644\u0627\u064a\u064a\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u0648\u0645\u064a\u064b\u0627. \u064a\u062d\u0628\u0647 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0644\u0623\u0646\u0647 \u064a\u0645\u0643\u0646\u0647\u0645 \u0625\u0646\u062c\u0627\u0632 \u0627\u0644\u0623\u0645\u0648\u0631 \u0628\u0633\u0647\u0648\u0644\u0629 \u0648\u0633\u0631\u0639\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cdiv class=\\\"wp-caption aligncenter\\\" id=\\\"attachment_10112\\\" style=\\\"width: 699px\\\">\\x3Cimg alt=\\\"Craigslist-Step-2\\\" aria-describedby=\\\"caption-attachment-10112\\\" class=\\\"wp-image-10112 size-full\\\" decoding=\\\"async\\\" height=\\\"350\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 689px) 100vw, 689px\\\" src=\\\"/uploads/articles/why-ux-not-ui/inline-1.jpg\\\" srcset=\\\"/uploads/articles/why-ux-not-ui/inline-1.jpg 689w, /uploads/articles/why-ux-not-ui/inline-6.jpg 300w, /uploads/articles/why-ux-not-ui/inline-15.jpg 330w, /uploads/articles/why-ux-not-ui/inline-18.jpg 414w\\\" width=\\\"689\\\"/>\\x3Cp class=\\\"wp-caption-text\\\" id=\\\"caption-attachment-10112\\\">\\x3Cem>\u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0643\u0631\u064a\u063a\u0633\u0644\u064a\u0633\u062a\\x3C/em>\\x3C/p>\\x3C/div>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0647\u0646\u0627\u0643 \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u0639\u0648\u0627\u0645\u0644 \u0627\u0644\u062a\u064a \u062a\u0624\u062b\u0631 \u0639\u0644\u0649 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645. \u064a\u0639\u062f \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0648\u0627\u0644\u062a\u062f\u0642\u064a\u0642 \u0627\u0644\u062f\u0627\u062e\u0644\u064a \u0648\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u062a\u0641\u0627\u0639\u0644 \u062b\u0644\u0627\u062b\u0629 \u0641\u0642\u0637 \u0645\u0646 \u0627\u0644\u062c\u0648\u0627\u0646\u0628 \u0627\u0644\u0639\u062f\u064a\u062f\u0629\u060c \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u062a\u0635\u0645\u064a\u0645 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0627\u0644\u0644\u0627\u0632\u0645\u0629 \u0639\u0646\u062f \u0625\u0646\u0634\u0627\u0621 \u062a\u062c\u0631\u0628\u0629 \u0645\u0633\u062a\u062e\u062f\u0645 \u0631\u0627\u0626\u0639\u0629 \u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0643. \u064a\u062d\u062a\u0648\u064a \u0643\u0644 \u0639\u0627\u0645\u0644 \u0639\u0644\u0649 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0647 \u0648\u064a\u062a\u0637\u0644\u0628 \u0625\u062d\u0633\u0627\u0633\u064b\u0627 \u0628\u0627\u0644\u062a\u0639\u0627\u0637\u0641 \u0645\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0641\u064a \u062d\u064a\u0646 \u0623\u0646 \u0627\u0644\u062c\u0645\u0627\u0644\u064a\u0627\u062a \u0627\u0644\u0645\u0631\u0626\u064a\u0629 \u0648\u062a\u0635\u0645\u064a\u0645 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0636\u0631\u0648\u0631\u064a\u0627\u0646 \u0641\u064a \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0641\u0645\u0646 \u0627\u0644\u0645\u0647\u0645 \u0623\u0646 \u062a\u062a\u0630\u0643\u0631 \u0623\u0646 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u062a\u0634\u0645\u0644 \u062c\u0645\u064a\u0639 \u062c\u0648\u0627\u0646\u0628 \u062a\u0641\u0627\u0639\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0645\u0639 \u0645\u0648\u0642\u0639\u0643 \u0623\u0648 \u0645\u0646\u062a\u062c\u0643.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Ci>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0641\u064a UXBERT Labs\u060c \u0646\u062d\u0646 \u0645\u062a\u062e\u0635\u0635\u0648\u0646 \u0641\u064a \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u0648\u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0648\u0627\u0644\u062a\u0637\u0648\u064a\u0631 \u0644\u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062a\u064a \u062a\u0642\u062f\u0645 \u062a\u062c\u0627\u0631\u0628 \u0639\u0627\u0644\u0645\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u0648\u0649. \u0645\u0646 \u062e\u0644\u0627\u0644 \u0645\u0643\u0627\u062a\u0628\u0646\u0627 \u0641\u064a \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u062f\u0628\u064a\u060c \u064a\u0642\u062f\u0645 \u0641\u0631\u064a\u0642\u0646\u0627 \u0645\u0646 \u0627\u0644\u0628\u0627\u062d\u062b\u064a\u0646 \u0648\u0627\u0644\u0645\u0635\u0645\u0645\u064a\u0646 \u0648\u0627\u0644\u0645\u0637\u0648\u0631\u064a\u0646 \u0641\u064a \u0645\u062c\u0627\u0644 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0628\u0631\u0627\u0645\u062c \u0645\u0635\u0645\u0645\u0629 \u0648\u0645\u064f\u0635\u0645\u0645\u0629 \u062e\u0635\u064a\u0635\u064b\u0627 \u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0646\u062c\u0627\u062d.\\x3C/span>\\x3C/i>\\x3C/p>\\n\\x3Cp>\\x3Cem>\u0647\u0644 \u0623\u0646\u062a \u0645\u0647\u062a\u0645 \u0628\u0627\u0644\u0639\u0645\u0644 \u0645\u0639\u0646\u0627\u061f \u0631\u0627\u0633\u0644\u0646\u0627 \u0639\u0628\u0631 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0639\u0644\u0649\\x3C/em> hello@uxbert.com \\x3Cem>\u0648\u0623\u062e\u0628\u0631\u0646\u0627 \u0628\u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a\u0643 \u0641\u064a \u0627\u0644\u0628\u062d\u062b \u0623\u0648 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0623\u0648 \u0627\u0644\u062a\u0637\u0648\u064a\u0631.\\x3C/em>\\x3C/p>\\n\",protected:!1},excerpt:$R[237]={rendered:\"\\x3Cp>\u064a\u0639\u062f \u062a\u0635\u0645\u064a\u0645 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 (UX) \u0648\u062a\u0635\u0645\u064a\u0645 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 (UI) \u0645\u0646 \u0623\u0643\u062b\u0631 \u0627\u0644\u0645\u0635\u0637\u0644\u062d\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u0633\u0627\u0621 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0627 \u0641\u064a \u0635\u0646\u0627\u0639\u062a\u0646\u0627. \u063a\u0627\u0644\u0628\u064b\u0627 \u0645\u0627 \u062a\u0643\u062a\u0628 \u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0627\u0644\u0648\u0638\u0627\u0626\u0641 \\\"UI/UX\\\" \u0643\u0645\u0627 \u0644\u0648 \u0643\u0627\u0646\u062a \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u0628\u062f\u064a\u0644. \u0648\u0644\u0643\u0646 \u0645\u0627 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 UX \u0648UI\u061f \u0645\u0627 \u0627\u0644\u0645\u0642\u0635\u0648\u062f \u0628\u0627\u0644\u0636\u0628\u0637 \u0628\u0640 \\\"\u062a\u062c\u0631\u0628\u0629 \u0645\u0633\u062a\u062e\u062f\u0645 \u062c\u064a\u062f\u0629\\\" \u0623\u0648 \\\"\u0648\u0627\u062c\u0647\u0629 \u0645\u0633\u062a\u062e\u062f\u0645 \u0633\u064a\u0626\u0629\\\"\u061f \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0645\u0642\u0627\u0644\u0629 \u0633\u0646\u0644\u0642\u064a \u0646\u0638\u0631\u0629 \u0623\u0639\u0645\u0642 \u0639\u0644\u0649 \u0645\u0627 \u064a\u0639\u0646\u064a\u0647 \u0643\u0644 \u0645\u0635\u0637\u0644\u062d.\\x3C/p>\\n\",protected:!1},author:3,featured_media:11088,comment_status:\"closed\",ping_status:\"closed\",sticky:!1,template:\"\",format:\"standard\",meta:$R[238]={_acf_changed:!1,inline_featured_image:!1,_mi_skip_tracking:!1,footnotes:\"\",_vp_format_video_url:\"\",_vp_image_focal_point:$R[239]=[]},categories:$R[240]=[3,148,12],tags:$R[241]=[165,103,107],acf:$R[242]={main:\"/uploads/articles/why-ux-not-ui/main.png\",sec:\"/uploads/articles/why-ux-not-ui/sec.png\"},category_objects:$R[243]=[$R[152],$R[172],$R[102]],tag_objects:$R[244]=[$R[179],$R[245]={id:103,count:11,description:\"\",link:\"/tag/userexperience\",name:\"User Experience\",slug:\"userexperience\",taxonomy:\"post_tag\",meta:$R[246]=[]},$R[133]]},$R[247]={id:10768,date:\"2017-08-09T14:54:15\",date_gmt:\"2017-08-09T14:54:15\",guid:$R[248]={rendered:\"/?p=10768\"},modified:\"2025-09-01T08:15:52\",modified_gmt:\"2025-09-01T08:15:52\",slug:\"usability-engineering-saudi-arabia-ministry-of-interior\",status:\"publish\",link:\"/usability-engineering-saudi-arabia-ministry-of-interior\",title:$R[249]={rendered:\"\u0647\u0646\u062f\u0633\u0629 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629: \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0644\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629\"},content:$R[250]={rendered:\"\\x3Cp>\u0623\u0646\u062a \u0644\u0633\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645.\\x3C/p>\\n\\x3Cp>\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0628\u0631\u0645\u062c\u064a\u0627\u062a \u0648\u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0623\u0648 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0647\u0627\u062a\u0641 \u0627\u0644\u0645\u062d\u0645\u0648\u0644 \u0627\u0644\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u064a\u062a\u0637\u0644\u0628 \u0645\u0646\u0643 \\x3Cstrong>\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u062a\u0635\u0627\u0645\u064a\u0645 \u0645\u0639 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u062d\u0642\u064a\u0642\u064a\u064a\u0646\\x3C/strong> .\\x3C/p>\\n\\x3Cp>\u0641\u064a UXBERT Labs\u060c \u064a\u064f\u0639\u062f\u0651 \u0628\u062d\u062b UX \u062c\u0632\u0621\u0627\u064b \u0623\u0633\u0627\u0633\u064a\u0627\u064b \u0645\u0646 \u0639\u0645\u0644\u064a\u062a\u0646\u0627. \u0633\u0648\u0627\u0621 \u0643\u0627\u0646 \u062a\u0635\u0645\u064a\u0645\u0627\u064b \u062c\u062f\u064a\u062f\u0627\u064b \u062a\u0645\u0627\u0645\u0627\u064b \u0623\u0648 \u0625\u0639\u0627\u062f\u0629 \u062a\u0635\u0645\u064a\u0645 \u0644\u062a\u0635\u0645\u064a\u0645 \u062d\u0627\u0644\u064a\u060c \u0641\u0625\u0646 \u0625\u062c\u0631\u0627\u0621 \u0645\u0642\u0627\u0628\u0644\u0627\u062a \u0645\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0648\u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0623\u0645\u0631 \u0636\u0631\u0648\u0631\u064a. \u0628\u062f\u0621 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0628\u0627\u0644\u0628\u062d\u062b \u064a\u0639\u0646\u064a \u0623\u0646\u0646\u0627 \u0646\u0635\u0645\u0645 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0628\u064a\u0627\u0646\u0627\u062a \u0641\u0639\u0644\u064a\u0629 \u0648\u0644\u064a\u0633 \u0627\u0641\u062a\u0631\u0627\u0636\u0627\u062a.\\x3C/p>\\n\\x3Cp>\\x3Ca href=\\\"/ar/5-reasons-business-needs-usability-testing/\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">\u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645\\x3C/a> \u064a\u064f\u0638\u0647\u0631 \u0644\u0643 \u0628\u0627\u0644\u0636\u0628\u0637 \u0623\u064a\u0646 (\u0648\u0644\u0645\u0627\u0630\u0627) \u064a\u0648\u0627\u062c\u0647 \u0639\u0645\u0644\u0627\u0624\u0643 \u0645\u0634\u0627\u0643\u0644 \u0641\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0646\u062a\u062c\u0643. \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0633\u062a\u062b\u0645\u0631 \u0641\u064a \u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u062d\u0642\u0642 \u0639\u0627\u0626\u062f\u0627\u064b \u0645\u0628\u0627\u0634\u0631\u0627\u064b \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631 (ROI) \u0645\u0646 \u062e\u0644\u0627\u0644 \\x3Ca href=\\\"/ar/the-positive-roi-of-great-ux/\\\">\u0632\u064a\u0627\u062f\u0629 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0648\u0627\u0644\u0625\u064a\u0631\u0627\u062f\u0627\u062a\u060c \u0648\u0627\u0646\u062e\u0641\u0627\u0636 \u062a\u0643\u0627\u0644\u064a\u0641 \u0648\u0648\u0642\u062a \u0627\u0644\u062a\u0637\u0648\u064a\u0631\u060c \u0648\u0627\u0646\u062e\u0641\u0627\u0636 \u062a\u0643\u0627\u0644\u064a\u0641 \u0627\u0644\u062f\u0639\u0645\u060c \u0648\u0632\u064a\u0627\u062f\u0629 \u0627\u0644\u0625\u0646\u062a\u0627\u062c\u064a\u0629 \u0648\u0631\u0636\u0627 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646\\x3C/a>\\x3C/p>\\n\\x3Cp>\u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0633\u0644\u0633\u0644\u0629\u060c \u0633\u0646\u0642\u0648\u0645 \u0628\u0625\u062c\u0631\u0627\u0621 \u062c\u0644\u0633\u0627\u062a \u0628\u062d\u062b \u063a\u064a\u0631 \u0631\u0633\u0645\u064a\u0629 \u0644\u0625\u062b\u0628\u0627\u062a \u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0631\u0624\u0649 \u0627\u0644\u062a\u064a \u064a\u0645\u0643\u0646 \u062c\u0645\u0639\u0647\u0627 \u062d\u062a\u0649 \u0645\u0646 \u0623\u0642\u0644 \u0642\u062f\u0631 \u0645\u0646 \u0627\u0644\u0628\u062d\u062b.\\x3C/p>\\n\\x3Cblockquote>\\x3Cp>\\x3Cstrong>\u064a\u064f\u0638\u0647\u0631 \u0644\u0643 \u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0628\u0627\u0644\u0636\u0628\u0637 \u0623\u064a\u0646 (\u0648\u0644\u0645\u0627\u0630\u0627) \u064a\u0648\u0627\u062c\u0647 \u0639\u0645\u0644\u0627\u0624\u0643 \u0645\u0634\u0627\u0643\u0644 \u0641\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0646\u062a\u062c\u0643.\\x3C/strong>\\x3C/p>\\x3C/blockquote>\\n\\x3Cp>\u0633\u062a\u0634\u0645\u0644 \u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0645\u062e\u062a\u0628\u0631\u0629 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629 \u0648\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0648\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0648\u0627\u0644\u0645\u0632\u064a\u062f.\\x3C/p>\\n\\x3Cp>\u0647\u062f\u0641\u0646\u0627 \u0647\u0648 \u0625\u0638\u0647\u0627\u0631 \u0623\u0646\u0647 \u0628\u063a\u0636 \u0627\u0644\u0646\u0638\u0631 \u0639\u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u063a\u0631\u0636 \u0627\u0644\u0645\u0648\u0642\u0639 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u064a\u0627\u064b \u0623\u0648 \u0645\u0639\u0627\u0645\u0644\u0627\u062a\u064a\u0627\u064b\u060c \u0641\u0625\u0646 \\x3Cstrong>\u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631 \u0645\u0639 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u062d\u0642\u064a\u0642\u064a\u064a\u0646 \u064a\u0648\u0641\u0631 \u0631\u0624\u0649 \u0642\u064a\u0651\u0645\u0629 \u0641\u0648\u0631\u0627\u064b\\x3C/strong> . \u0648\u0639\u0646\u062f\u0645\u0627 \u062a\u064f\u0639\u0627\u062f \u0647\u0630\u0647 \u0627\u0644\u0631\u0624\u0649 \u0625\u0644\u0649 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u0635\u0645\u064a\u0645\u060c \u064a\u0646\u062a\u062c \u0639\u0646\u0647\u0627 \u062a\u062c\u0627\u0631\u0628 \u0645\u0633\u062a\u062e\u062f\u0645 \u0625\u064a\u062c\u0627\u0628\u064a\u0629.\\x3C/p>\\n\\x3Cp>\u0639\u0644\u0649 \u063a\u0631\u0627\u0631 \u0645\u0627 \u0646\u0641\u0639\u0644\u0647 \u0639\u0646\u062f \u0625\u062c\u0631\u0627\u0621 \u0623\u0628\u062d\u0627\u062b \u0647\u0646\u062f\u0633\u0629 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0631\u0633\u0645\u064a\u0629\u060c \u064a\u062a\u0645 \u0627\u0633\u062a\u062e\u0644\u0627\u0635 \u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u0634\u0643\u0644\u0627\u062a \u0627\u0644\u0645\u062d\u062f\u062f\u0629 \u0648\u0627\u0644\u062d\u0644\u0648\u0644 \u0627\u0644\u0645\u0642\u062a\u0631\u062d\u0629 \u0645\u0646 \u0645\u0632\u064a\u062c \u0645\u0646 \\x3Cstrong>\u0625\u0631\u0634\u0627\u062f\u0627\u062a \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0639\u0644\u0649 \u0627\u0644\u0628\u062d\u062b \u0627\u0644\u0639\u0644\u0645\u064a\\x3C/strong> \u0648\u0641\u0647\u0645 \u0623\u0641\u0636\u0644 \u0627\u0644\u0645\u0645\u0627\u0631\u0633\u0627\u062a \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u062e\u0628\u0631\u0629 \u0627\u0644\u0628\u062d\u062b \u0627\u0644\u0645\u062a\u062e\u0635\u0635\u0629.\\x3C/p>\\n\\x3Cp>\u0643\u0645\u0627 \u062a\u064f\u0633\u062a\u062e\u062f\u0645 \u062a\u0642\u0646\u064a\u0629 \u062a\u062a\u0628\u0639 \u0627\u0644\u0639\u064a\u0646 \u0644\u062f\u0639\u0645 \u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u0634\u0643\u0644\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0627\u0644\u062a\u062e\u0637\u064a\u0637 \u0648\u0627\u0644\u062a\u0646\u0642\u0644 \u0648\u0627\u0644\u062a\u0641\u0627\u0639\u0644.\\x3C/p>\\n\\x3Ch2>\\x3Cb>\u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631: \u0645\u0648\u0642\u0639 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\\x3C/b>\\x3C/h2>\\n\\x3Cp>\u0641\u064a \u0645\u062c\u0645\u0648\u0639\u062a\u0646\u0627 \u0627\u0644\u0623\u0648\u0644\u0649 \u0645\u0646 \u0627\u0644\u062c\u0644\u0633\u0627\u062a\u060c \u0637\u0644\u0628\u0646\u0627 \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0625\u0643\u0645\u0627\u0644 \u0645\u0647\u0645\u062a\u064a\u0646 \u0628\u0633\u064a\u0637\u062a\u064a\u0646 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 (\\x3Ca href=\\\"https://www.moi.gov.sa/wps/portal/Home/Home\\\">moi.gov.sa\\x3C/a>).\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u0642\u062f\u0645 \u0645\u0648\u0642\u0639 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u0644\u0644\u0645\u0642\u064a\u0645\u064a\u0646 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0639\u062f\u0629 \u062e\u062f\u0645\u0627\u062a \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0645\u062b\u0644 \u062a\u062c\u062f\u064a\u062f \u0627\u0644\u0625\u0642\u0627\u0645\u0629\u060c \u0648\u062a\u062c\u062f\u064a\u062f \u0631\u062e\u0635\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629\u060c \u0648\u0627\u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645 \u0639\u0646 \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0631\u0648\u0631\u064a\u0629\u060c \u0648\u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u0635\u062d\u064a. \u064a\u062a\u064a\u062d \u0644\u0644\u0646\u0627\u0633 \u0627\u0644\u0648\u0635\u0648\u0644 \u0628\u0633\u0647\u0648\u0644\u0629 \u0625\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629 \u0645\u0639 \u0627\u0644\u0633\u0639\u064a \u0644\u062a\u0642\u0644\u064a\u0644 \u0627\u0644\u0625\u062d\u0628\u0627\u0637\u0627\u062a \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u0628\u064a\u0631\u0648\u0642\u0631\u0627\u0637\u064a\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cp>\u0634\u0627\u0631\u0643 \u0641\u064a \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a 3 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646\u060c \u0637\u064f\u0644\u0628 \u0645\u0646 \u0643\u0644 \u0645\u0646\u0647\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0648\u0642\u0639 \u0644\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0645\u0647\u0627\u0645 \u0627\u0644\u062a\u0627\u0644\u064a\u0629:\\x3C/p>\\n\\x3Cp>\u2022 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0623\u064a \u0645\u062e\u0627\u0644\u0641\u0627\u062a \u0645\u0631\u0648\u0631\u064a\u0629 \u063a\u064a\u0631 \u0645\u062f\u0641\u0648\u0639\u0629\\x3C/p>\\n\\x3Cp>\u2022 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0628\u0635\u0645\u062a\u0647\u0645 \u0642\u062f \u062a\u0645 \u062a\u0633\u062c\u064a\u0644\u0647\u0627 \u0648\u062a\u062d\u062f\u064a\u062b\u0647\u0627 \u0628\u0646\u062c\u0627\u062d \u0641\u064a \u0627\u0644\u0646\u0638\u0627\u0645\\x3C/p>\\n\\x3Ch2>\\x3Cb>\u0631\u062d\u0644\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u062b\u0627\u0644\u064a\u0629 \u0644\u0625\u0646\u062c\u0627\u0632 \u0627\u0644\u0645\u0647\u0645\u0629\\x3C/b>\\x3C/h2>\\n\\x3Cp>\u0641\u064a\u0645\u0627 \u064a\u0644\u064a \u0642\u0627\u0626\u0645\u0629 \u0628\u0627\u0644\u062e\u0637\u0648\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u062c\u0628 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u062a\u062e\u0627\u0630\u0647\u0627 \u0628\u0634\u0643\u0644 \u0645\u062b\u0627\u0644\u064a \u0644\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0625\u0646\u062c\u0627\u0632 \u0627\u0644\u0645\u0647\u0645\u0629 \u0628\u0623\u0633\u0631\u0639 \u0648\u0623\u0643\u0641\u0623 \u0637\u0631\u064a\u0642\u0629.\\x3C/p>\\n\\x3Cp>\\x3Cem>\\x3Cb>\u0627\u0644\u0645\u0647\u0645\u0629 1: \\x3C/b>\\x3C/em>\\x3Cb>\\x3Ci>\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0627\u062a \u063a\u064a\u0631 \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0629\\x3C/i>\\x3C/b>\\x3C/p>\\