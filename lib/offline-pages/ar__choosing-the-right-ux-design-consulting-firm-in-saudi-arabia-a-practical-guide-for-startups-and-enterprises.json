ations\",name:\"Presentations\",slug:\"presentations\",taxonomy:\"post_tag\",meta:$R[178]=[]},$R[179]={id:165,count:4,description:\"\",link:\"/tag/ui\",name:\"UI\",slug:\"ui\",taxonomy:\"post_tag\",meta:$R[180]=[]},$R[133]]},$R[181]={id:11610,date:\"2018-04-30T13:40:22\",date_gmt:\"2018-04-30T13:40:22\",guid:$R[182]={rendered:\"/?p=11610\"},modified:\"2025-12-03T13:39:29\",modified_gmt:\"2025-12-03T13:39:29\",slug:\"ux-psychology-principles-design-ux\",status:\"publish\",link:\"/ux-psychology-principles-design-ux\",title:$R[183]={rendered:\"13 \u0645\u0628\u062f\u0623 \u0641\u064a \u0639\u0644\u0645 \u0627\u0644\u0646\u0641\u0633 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0639\u0631\u0641\u0647\u0627 \u062c\u0645\u064a\u0639 \u0645\u0635\u0645\u0645\u064a \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\"},content:$R[184]={rendered:\"\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u0644\u0639\u0628 \u0639\u0644\u0645 \u0627\u0644\u0646\u0641\u0633 \u062f\u0648\u0631\u064b\u0627 \u0645\u0647\u0645\u064b\u0627 \u0641\u064a \u062a\u0635\u0645\u064a\u0645 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0645\u0646 \u062e\u0644\u0627\u0644 \u0641\u0647\u0645 \u0643\u064a\u0641\u064a\u0629 \u062a\u0623\u062b\u064a\u0631 \u0645\u0628\u0627\u062f\u0626 \u0639\u0644\u0645 \u0627\u0644\u0646\u0641\u0633 \u0627\u0644\u0645\u062e\u062a\u0644\u0641\u0629 \u0639\u0644\u0649 \u0627\u0644\u0633\u0644\u0648\u0643 \u0627\u0644\u0628\u0634\u0631\u064a\u060c \u064a\u0645\u0643\u0646\u0643 \u062a\u0635\u0645\u064a\u0645 \u0645\u0646\u062a\u062c\u0627\u062a\u0643 \u0644\u0627\u0633\u062a\u0646\u0628\u0627\u0637 \u0627\u0633\u062a\u062c\u0627\u0628\u0627\u062a \u0648\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0645\u062d\u062f\u062f\u0629 \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0644\u0644\u0628\u062f\u0621\u060c \u0642\u0645\u0646\u0627 \u0628\u062a\u062c\u0645\u064a\u0639 \u0648\u062a\u0628\u0633\u064a\u0637 13 \u0645\u0628\u062f\u0623 \u0646\u0641\u0633\u064a\u064b\u0627 \u0645\u0646 \u0634\u0623\u0646\u0647\u0627 \u0623\u0646 \u062a\u0633\u0627\u0639\u062f \u0641\u064a \u062a\u062d\u0633\u064a\u0646 \u0633\u0647\u0648\u0644\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0648\u0627\u0644\u062c\u0645\u0627\u0644\u064a\u0627\u062a \u0648\u0641\u0639\u0627\u0644\u064a\u0629 \u062a\u0635\u0645\u064a\u0645\u0627\u062a\u0643.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cb>\\x3Cb>1.\\x3Ca href=\\\"#hicks_law\\\">\u0642\u0627\u0646\u0648\u0646 \u0647\u064a\u0643\\x3C/a>\\x3C/b>\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cb>\\x3Cb>2.\\x3Ca href=\\\"#gestalt_principles_of_visual_perception\\\">\u0645\u0628\u0627\u062f\u0626 \u0627\u0644\u062c\u0634\u0637\u0627\u0644\u062a \u0644\u0644\u0625\u062f\u0631\u0627\u0643 \u0627\u0644\u0628\u0635\u0631\u064a\\x3C/a>\\x3C/b>\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cb>3.\\x3Ca href=\\\"#psychology_of_persuasion\\\">\u0633\u064a\u0643\u0648\u0644\u0648\u062c\u064a\u0629 \u0627\u0644\u0625\u0642\u0646\u0627\u0639\\x3C/a> \\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cb>4.\\x3Ca href=\\\"#Selective_Disregard_and_Change_Blindness\\\">\u0627\u0644\u062a\u062c\u0627\u0647\u0644 \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0626\u064a \u0648\u0639\u0645\u0649 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\\x3C/a>\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cb>5.\\x3Ca href=\\\"#Memory_Limitations\\\">\u0642\u064a\u0648\u062f \u0627\u0644\u0630\u0627\u0643\u0631\u0629\\x3C/a>\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cb>6.\\x3Ca href=\\\"#Mental_Models\\\">\u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0639\u0642\u0644\u064a\u0629\\x3C/a>\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cb>7.\\x3Ca href=\\\"#Psychology_of_Colors\\\">\u0633\u064a\u0643\u0648\u0644\u0648\u062c\u064a\u0629 \u0627\u0644\u0623\u0644\u0648\u0627\u0646\\x3C/a>\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cb>8.\\x3Ca href=\\\"#Von_Restorff_Effect\\\">\u062a\u0623\u062b\u064a\u0631 \u0641\u0648\u0646 \u0631\u064a\u0633\u062a\u0648\u0631\u0641\\x3C/a> \\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cb>9.\\x3Ca href=\\\"#Visceral_Reactions\\\">\u0631\u062f\u0648\u062f \u0627\u0644\u0641\u0639\u0644 \u0627\u0644\u062d\u0634\u0648\u064a\u0629\\x3C/a>\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cb>10.\\x3Ca href=\\\"#Dual_Coding_Theory\\\">\u0646\u0638\u0631\u064a\u0629 \u0627\u0644\u062a\u0631\u0645\u064a\u0632 \u0627\u0644\u0645\u0632\u062f\u0648\u062c\\x3C/a> \\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cb>11.\\x3Ca href=\\\"#Psychology_of_Shapes\\\">\u0633\u064a\u0643\u0648\u0644\u0648\u062c\u064a\u0629 \u0627\u0644\u0623\u0634\u0643\u0627\u0644\\x3C/a>\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cb>12.\\x3Ca href=\\\"#Pareto_Principle\\\">\u0645\u0628\u062f\u0623 \u0628\u0627\u0631\u064a\u062a\u0648 \u0623\u0648 \u0642\u0627\u0639\u062f\u0629 80/20\\x3C/a>\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cb>13.\\x3Ca href=\\\"#fitts_law\\\">\u0642\u0627\u0646\u0648\u0646 \u0641\u064a\u062a\\x3C/a>\\x3C/b>\\x3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp>\\x3Ca name=\\\"hicks_law\\\">\\x3C/a>\\x3Cb>1. \u0642\u0627\u0646\u0648\u0646 \u0647\u064a\u0643\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u062a\u0630\u0647\u0628 \u0625\u0644\u0649 \u0645\u0637\u0639\u0645 \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0623\u0643\u062b\u0631 \u0645\u0646 100 \u0639\u0646\u0635\u0631 \u0641\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629. \u0633\u062a\u0633\u062a\u063a\u0631\u0642 \u0642\u0631\u0627\u0621\u0629 \u062c\u0645\u064a\u0639 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0648\u0627\u062a\u062e\u0627\u0630 \u0627\u0644\u0642\u0631\u0627\u0631 \u0648\u0642\u062a\u064b\u0627 \u0623\u0637\u0648\u0644 \u0628\u0643\u062b\u064a\u0631 \u0645\u0645\u0627 \u0644\u0648 \u0643\u0627\u0646\u062a \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 20 \u0639\u0646\u0635\u0631\u064b\u0627 \u0641\u0642\u0637 \u0644\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0645\u0646 \u0628\u064a\u0646\u0647\u0627. \u0627\u0644\u0623\u0645\u0631 \u0646\u0641\u0633\u0647 \u064a\u0646\u0637\u0628\u0642 \u0639\u0644\u0649 \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0648\u0627\u062c\u0647\u0627\u062a.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\\x3Cstrong>\u064a\u0646\u0635 \u0642\u0627\u0646\u0648\u0646 \u0647\u064a\u0643 \u0639\u0644\u0649 \u0623\u0646 \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0630\u064a \u064a\u0633\u062a\u063a\u0631\u0642\u0647 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0644\u0627\u062a\u062e\u0627\u0630 \u0627\u0644\u0642\u0631\u0627\u0631 \u064a\u0632\u062f\u0627\u062f \u0645\u0639 \u0632\u064a\u0627\u062f\u0629 \u0639\u062f\u062f \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u062d\u0629.\\x3C/strong>\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cimg alt=\\\"Hick's Law Graph\\\" class=\\\"aligncenter size-full wp-image-11627\\\" decoding=\\\"async\\\" height=\\\"300\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 600px) 100vw, 600px\\\" src=\\\"/wp-contentuploads/2018/03/HicksLaw.png\\\" srcset=\\\"/wp-contentuploads/2018/03/HicksLaw.png 600w, /wp-contentuploads/2018/03/HicksLaw-300x150.png 300w, /wp-contentuploads/2018/03/HicksLaw-330x165.png 330w, /wp-contentuploads/2018/03/HicksLaw-414x207.png 414w\\\" width=\\\"600\\\"/>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0633\u0648\u0627\u0621 \u0643\u0646\u062a \u0639\u0644\u0649 \u062f\u0631\u0627\u064a\u0629 \u0628\u0630\u0644\u0643 \u0623\u0645 \u0644\u0627\u060c \u0641\u0625\u0646 \u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062a\u062e\u0630\u0647\u0627 \u062a\u062a\u0623\u062b\u0631 \u0628\u0645\u0627 \u062a\u0639\u062a\u0628\u0631\u0647 \\\"\u064a\u0633\u062a\u062d\u0642 \u0627\u0644\u0639\u0646\u0627\u0621\\\". \u0623\u0646\u062a \u062a\u0632\u0646 \u062f\u0648\u0646 \u0648\u0639\u064a \u062a\u0643\u0627\u0644\u064a\u0641 \u0648\u0641\u0648\u0627\u0626\u062f \u0627\u0644\u0642\u0631\u0627\u0631 \u0642\u0628\u0644 \u0627\u062a\u062e\u0627\u0630\u0647. \u0648\u064a\u0639\u0631\u0641 \u0647\u0630\u0627 \u0628\u0627\u0633\u0645\\x3C/span>\\x3Cem>\\x3Cstrong>\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0648\u0627\u0644\u0639\u0627\u0626\u062f.\\x3C/strong>\\x3C/em>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0623\u0643\u062b\u0631 \u0641\u0639\u0627\u0644\u064a\u0629 \u0644\u062f\u0641\u0639 \u0627\u0644\u0623\u0634\u062e\u0627\u0635 \u0625\u0644\u0649 \u0627\u062a\u062e\u0627\u0630 \u0625\u062c\u0631\u0627\u0621 \u0647\u064a \u062c\u0639\u0644 \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641 \u0628\u0633\u064a\u0637\u064b\u0627 \u0642\u062f\u0631 \u0627\u0644\u0625\u0645\u0643\u0627\u0646 \u0645\u0639 \u0636\u0645\u0627\u0646 \u0623\u0642\u0635\u0649 \u0627\u0633\u062a\u0641\u0627\u062f\u0629 \u0645\u0646\u0647. \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u062a\u0643\u0627\u0644\u064a\u0641 \u062a\u0641\u0648\u0642 \u0627\u0644\u0641\u0648\u0627\u0626\u062f\u060c \u0641\u0644\u0646 \u064a\u062a\u062e\u0630 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0623\u064a \u0625\u062c\u0631\u0627\u0621.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cb>\u0625\u0630\u064b\u0627 \u0643\u064a\u0641 \u064a\u0645\u0643\u0646\u0643 \u062a\u0637\u0628\u064a\u0642 \u0642\u0627\u0646\u0648\u0646 \u0647\u064a\u0643 \u0639\u0644\u0649 \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643\u061f\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0642\u0627\u0639\u062f\u0629 \u0648\u0627\u062d\u062f\u0629 \u0628\u0633\u064a\u0637\u0629. \u0636\u0639 \u0641\u064a \u0627\u0639\u062a\u0628\u0627\u0631\u0643 \u0630\u0644\u0643\\x3C/span>\u064a\u0635\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0625\u0644\u0649 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0628\u0647\u062f\u0641 \u0645\u062d\u062f\u062f\\x3Cspan style=\\\"font-weight: 400;\\\">. \\x3Cstrong>\u0642\u0645 \u0628\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0631\u0648\u0627\u0628\u0637 \u0648\u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0646\u0635\u0648\u0635 \u0648\u0627\u0644\u0623\u0632\u0631\u0627\u0631 \u063a\u064a\u0631 \u0627\u0644\u0636\u0631\u0648\u0631\u064a\u0629 \u0645\u0646 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0644\u0644\u0633\u0645\u0627\u062d \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0628\u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0645\u0627 \u064a\u062d\u062a\u0627\u062c\u0648\u0646 \u0625\u0644\u064a\u0647 \u0648\u0627\u0644\u0642\u064a\u0627\u0645 \u0628\u0645\u0627 \u064a\u0631\u064a\u062f\u0648\u0646 \u0641\u064a \u0623\u0633\u0631\u0639 \u0648\u0642\u062a \u0645\u0645\u0643\u0646\u060c \u062f\u0648\u0646 \u062a\u0634\u062a\u064a\u062a \u0627\u0644\u0627\u0646\u062a\u0628\u0627\u0647.\\x3C/strong>\\x3C/span>\\x3C/p>\\n\\x3Cdiv class=\\\"wp-caption aligncenter\\\" id=\\\"attachment_11619\\\" style=\\\"width: 1214px\\\">\\x3Cimg alt=\\\"This website is cluttered with distractions irrelevant to the purpose of the website, making it probably the most unusable website out there. (Source: www.lingscars.com)\\\" aria-describedby=\\\"caption-attachment-11619\\\" class=\\\"size-full wp-image-11619\\\" decoding=\\\"async\\\" height=\\\"680\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 1204px) 100vw, 1204px\\\" src=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-50.png\\\" srcset=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-50.png 1204w, /wp-contentuploads/2018/03/lingscars-300x169.png 300w, /wp-contentuploads/2018/03/lingsc