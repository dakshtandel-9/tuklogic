3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp>\\x3Ca name=\\\"Pareto_Principle\\\">\\x3C/a>\\x3Cb>12. \u0645\u0628\u062f\u0623 \u0628\u0627\u0631\u064a\u062a\u0648\u060c \u0623\u0648 \u0642\u0627\u0639\u062f\u0629 80/20\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u0646\u0635 \u0645\u0628\u062f\u0623 \u0628\u0627\u0631\u064a\u062a\u0648\u060c \u0627\u0644\u0645\u0639\u0631\u0648\u0641 \u0623\u064a\u0636\u064b\u0627 \u0628\u0627\u0633\u0645 \u0642\u0627\u0639\u062f\u0629 80/20 \u0623\u0648 \u0642\u0627\u0646\u0648\u0646 \u0627\u0644\u0642\u0644\u0629 \u0627\u0644\u062d\u064a\u0648\u064a\u0629\u060c \u0639\u0644\u0649 \u0623\u0646 20% \u0641\u0642\u0637 \u0645\u0646 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0630\u064a \u0642\u0645\u062a \u0628\u0647 \u0644\u062a\u062d\u0642\u064a\u0642 \u0634\u064a\u0621 \u0645\u0627 \u0647\u0648 \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0639\u0646 80% \u0645\u0646 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0627\u0644\u062a\u064a \u062d\u0642\u0642\u062a\u0647\u0627.\\x3Cstrong>\u0628\u0628\u0633\u0627\u0637\u0629\u060c \u0645\u0627 \u0639\u0644\u064a\u0643 \u0633\u0648\u0649 \u0625\u0635\u0644\u0627\u062d \u0627\u0644\u0642\u0644\u064a\u0644 \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u0643\u062b\u064a\u0631 \u0645\u0646 \u0627\u0644\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0625\u064a\u062c\u0627\u0628\u064a.\\x3C/strong>\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cimg alt=\\\"80/20 Rule\\\" class=\\\"aligncenter wp-image-11681\\\" decoding=\\\"async\\\" height=\\\"259\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 355px) 100vw, 355px\\\" src=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-54.jpg\\\" srcset=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-54.jpg 481w, /uploads/articles/ux-psychology-principles-design-ux/inline-37.jpg 300w, /uploads/articles/ux-psychology-principles-design-ux/inline-14.jpg 330w, /uploads/articles/ux-psychology-principles-design-ux/inline-19.jpg 245w, /uploads/articles/ux-psychology-principles-design-ux/inline-20.jpg 414w\\\" width=\\\"355\\\"/>\\x3C/p>\\n\\x3Cp>\u0625\u0646 \u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0639\u0627\u0644\u062c\u0629 \u062c\u0645\u064a\u0639 \u0645\u0634\u0643\u0644\u0627\u062a\u0643 \u0648\u062a\u062d\u0633\u064a\u0646\u0647\u0627 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0623\u0645\u0631 \u0645\u0631\u0647\u0642 \u0648\u064a\u0624\u062f\u064a \u0625\u0644\u0649 \u0646\u062a\u0627\u0626\u062c \u0645\u062a\u0636\u0627\u0626\u0644\u0629. \u0625\u0646 \u062a\u062d\u062f\u064a\u062f \u0623\u0648\u0644\u0648\u064a\u0627\u062a \u062c\u0647\u0648\u062f\u0643 \u0639\u0644\u0649 \u0627\u0644\u062c\u0632\u0621 \u0627\u0644\u0635\u063a\u064a\u0631 \u0627\u0644\u0630\u064a \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0644\u0647 \u0627\u0644\u062a\u0623\u062b\u064a\u0631 \u0627\u0644\u0623\u0643\u0628\u0631 \u0633\u064a\u0633\u0627\u0639\u062f\u0643 \u0628\u0627\u0644\u062a\u0623\u0643\u064a\u062f \u0639\u0644\u0649 \u062a\u062d\u0642\u064a\u0642 \u0646\u062a\u0627\u0626\u062c \u0623\u0641\u0636\u0644.\\x3C/p>\\n\\x3Cp>\u0642\u0645 \u0628\u062a\u062d\u0644\u064a\u0644 \u0623\u062f\u0627\u0621 \u062a\u0635\u0645\u064a\u0645\u0643 \u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u0645\u062a\u0637\u0644\u0628\u0627\u062a\u0643 \u0628\u0646\u0633\u0628\u0629 80/20. \u0645\u0639 \u0648\u062c\u0648\u062f \u0639\u062f\u062f \u0623\u0642\u0644 \u0645\u0646 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062a\u064a \u064a\u062c\u0628 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0644\u064a\u0647\u0627\u060c \u064a\u0645\u0643\u0646\u0643 \u062a\u062d\u0642\u064a\u0642 \u0623\u0642\u0635\u0649 \u0642\u062f\u0631 \u0645\u0646 \u0627\u0644\u062f\u0642\u0629 \u0648\u0627\u0644\u0628\u0631\u0627\u0639\u0629 \u0644\u0632\u064a\u0627\u062f\u0629 \u0645\u0639\u062f\u0644\u0627\u062a \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0645\u0639 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u0645\u0646 \u0627\u0644\u062c\u0647\u0648\u062f \u0627\u0644\u0636\u0627\u0626\u0639\u0629.\\x3C/p>\\n\\x3Cp>\\x3Cstrong>\u0636\u0639 \u0641\u064a \u0627\u0639\u062a\u0628\u0627\u0631\u0643 \u0623\u0646\u0647 \u0639\u0644\u0649 \u0627\u0644\u0631\u063a\u0645 \u0645\u0646 \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0644\u0649 \u0627\u0644\u0640 20 \u0628\u0627\u0644\u0645\u0627\u0626\u0629 \u0641\u064a \u062a\u0635\u0645\u064a\u0645\u0643\u060c \u0625\u0644\u0627 \u0623\u0646 \u0647\u0630\u0627 \u0644\u0627 \u064a\u0639\u0646\u064a \u0623\u0646 \u0627\u0644\u0640 80 \u0628\u0627\u0644\u0645\u0627\u0626\u0629 \u0627\u0644\u0645\u062a\u0628\u0642\u064a\u0629 \u063a\u064a\u0631 \u0630\u0627\u062a \u0635\u0644\u0629.\\x3C/strong> \u062d\u064a\u062b\u0645\u0627 \u064a\u0633\u0645\u062d \u0627\u0644\u0648\u0642\u062a \u0648\u0627\u0644\u0645\u0648\u0627\u0631\u062f\u060c \u0642\u0645 \u0628\u0636\u0628\u0637 \u062c\u0645\u064a\u0639 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0644\u0625\u0646\u0634\u0627\u0621 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629.\\x3C/p>\\n\\x3Cp>\\x3Ca name=\\\"fitts_law\\\">\\x3C/a>\\x3Cb>13. \u0642\u0627\u0646\u0648\u0646 \u0641\u064a\u062a\u0633\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\\x3Cstrong>\u064a\u0642\u062a\u0631\u062d \u0642\u0627\u0646\u0648\u0646 \u0641\u064a\u062a\u0633 \u0623\u0646 \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u0633\u062a\u063a\u0631\u0642 \u0644\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0625\u0644\u0649 \u0645\u0646\u0637\u0642\u0629 \u0645\u0633\u062a\u0647\u062f\u0641\u0629 \u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u062d\u062c\u0645 \u0627\u0644\u0647\u062f\u0641 \u0648\u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u0647\u062f\u0641.\\x3C/strong>\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u0642\u062a\u0631\u062d \u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0648\u0636\u0639 \u0627\u0644\u0623\u0632\u0631\u0627\u0631 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u0629 \u0628\u0627\u0644\u0642\u0631\u0628 \u0645\u0646 \u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0645\u0627\u0648\u0633 \u0627\u0644\u0645\u062a\u0648\u0642\u0639\u0629 \u0648\u062c\u0639\u0644\u0647\u0627 \u0623\u0643\u0628\u0631 \u0644\u062a\u0642\u0644\u064a\u0644 \u0648\u0642\u062a \u0627\u0644\u062a\u0641\u0627\u0639\u0644. \u0647\u0630\u0627 \u0627\u0644\u0645\u0641\u0647\u0648\u0645 \u0645\u0647\u0645 \u0641\u064a \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0648\u064a\u0628 \u0644\u0623\u0646 \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0644\u0627\u0632\u0645 \u0644\u0627\u062a\u062e\u0627\u0630 \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0645\u0637\u0644\u0648\u0628 \u064a\u0624\u062b\u0631 \u0639\u0644\u0649 \u0645\u0639\u062f\u0644\u0627\u062a \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0648\u0623\u064a \u0648\u0642\u062a \u0625\u0636\u0627\u0641\u064a \u064a\u0645\u062b\u0644 \u062e\u0637\u0631 \u0641\u0642\u062f\u0627\u0646 \u0639\u0645\u064a\u0644 \u0645\u062d\u062a\u0645\u0644.\\x3C/span>\\x3C/p>\\n\\x3Cdiv class=\\\"wp-caption aligncenter\\\" id=\\\"attachment_11682\\\" style=\\\"width: 449px\\\">\\x3Ca href=\\\"https://www.interaction-design.org/literature/article/fitts-s-law-the-importance-of-size-and-distance-in-ui-design\\\">\\x3Cimg alt=\\\"Fitts Law\\\" aria-describedby=\\\"caption-attachment-11682\\\" class=\\\"wp-image-11682\\\" decoding=\\\"async\\\" height=\\\"315\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 439px) 100vw, 439px\\\" src=\\\"/wp-contentuploads/2018/03/J6g7az-rSQjCZHQYkZjY4LJhkDTg1Tj1Kl1ObH4a0xCTIiQC-tsWEEBfWLrZfzVIiVE0z9GDhVBVFiS-E-L-QaGtoFOe8oute7VsT0VY0V9QoWiQivvEYNU0JldeejHRse1OD3Hb.png\\\" srcset=\\\"/