ont-weight: 400;\\\">\u0627\u062c\u0639\u0644 \u0645\u0646 \u0627\u0644\u0633\u0647\u0644 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u062a\u0630\u0643\u0631 \u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u0645\u0647\u0645\u0629 \u0645\u0646 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0627\u0633\u062a\u0641\u0627\u062f\u0629 \u0645\u0646 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0631\u0645\u064a\u0632 \u0627\u0644\u0645\u0632\u062f\u0648\u062c. \u062a\u0642\u062a\u0631\u062d \u0646\u0638\u0631\u064a\u0629 \u0627\u0644\u062a\u0634\u0641\u064a\u0631 \u0627\u0644\u0645\u0632\u062f\u0648\u062c \u0623\u0646 \u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0644\u062f\u064a\u0647\u0627 \u0646\u0638\u0627\u0645\u0627\u0646 \u0645\u062a\u0645\u064a\u0632\u0627\u0646 \u0648\u0644\u0643\u0646 \u0645\u062a\u0631\u0627\u0628\u0637\u0627\u0646\u060c \u0623\u062d\u062f\u0647\u0645\u0627 \u0644\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0644\u0641\u0638\u064a\u0629 \u0648\u0627\u0644\u0622\u062e\u0631 \u0644\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u063a\u064a\u0631 \u0627\u0644\u0644\u0641\u0638\u064a\u0629. \u062a\u0624\u062b\u0631 \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0628\u064a\u0646 \u0647\u0627\u062a\u064a\u0646 \u0627\u0644\u0642\u0646\u0627\u062a\u064a\u0646 \u0639\u0644\u0649 \u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0648\u0627\u0644\u062a\u0639\u0644\u0645.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u0645\u0643\u0646\u0643 \u0625\u0646\u0634\u0627\u0621 \u0635\u0648\u0631 \u0645\u0631\u0626\u064a\u0629 \u0644\u0644\u0643\u0644\u0645\u0627\u062a \u0641\u064a \u0639\u0642\u0644\u0643 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u062a\u062c\u0627\u0631\u0628\u0643 \u0648\u062a\u0635\u0648\u0631\u0643 \u0644\u0644\u0639\u0627\u0644\u0645 \u0627\u0644\u062d\u0642\u064a\u0642\u064a. \u0641\u0643\u0631 \u0641\u064a \u0643\u0644\u0645\u0629 \\\"\u0634\u062c\u0631\u0629\\\"\u060c \u062d\u064a\u062b \u064a\u062a\u062e\u064a\u0644 \u062f\u0645\u0627\u063a\u0643 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u062c\u0630\u0639\u064b\u0627 \u0628\u0646\u064a\u064b\u0627 \u0648\u0623\u0648\u0631\u0627\u0642\u064b\u0627 \u062e\u0636\u0631\u0627\u0621\u060c \u0623\u0648 \u0634\u064a\u0626\u064b\u0627 \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u0642\u0628\u064a\u0644. \u0648\u0645\u0646 \u062e\u0644\u0627\u0644 \u0631\u0628\u0637 \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0628\u0627\u0644\u0635\u0648\u0631\u060c \u064a\u0635\u0628\u062d \u0645\u0646 \u0627\u0644\u0623\u0633\u0647\u0644 \u062a\u0630\u0643\u0631\u0647\u0627 \u0639\u0646\u062f \u0630\u0643\u0631\u0647\u0627.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0648\u0646\u062d\u0646 \u0646\u0631\u0649 \u0647\u0630\u0627 \u0641\u064a \u0643\u062a\u0628 \u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u0641\u064a \u0643\u0644 \u0648\u0642\u062a. \u0644\u064a\u0633 \u0641\u0642\u0637 \u0645\u0646 \u0623\u062c\u0644 \u0627\u0644\u062c\u0627\u0630\u0628\u064a\u0629 \u0627\u0644\u0628\u0635\u0631\u064a\u0629\u060c \u0648\u0644\u0643\u0646\u0647 \u064a\u0633\u0627\u0639\u062f \u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u0639\u0644\u0649 \u062a\u0639\u0644\u0645 \u0643\u0644\u0645\u0627\u062a \u062c\u062f\u064a\u062f\u0629 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0637\u0628\u0627\u0639\u0629 \u0627\u0644\u0635\u0648\u0631 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0647\u0627.\\x3C/span>\\x3C/p>\\n\\x3Cdiv class=\\\"wp-caption aligncenter\\\" id=\\\"attachment_11679\\\" style=\\\"width: 571px\\\">\\x3Cimg alt=\\\"Dual-coding \\\" aria-describedby=\\\"caption-attachment-11679\\\" class=\\\"wp-image-11679 size-full\\\" decoding=\\\"async\\\" height=\\\"344\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 561px) 100vw, 561px\\\" src=\\\"/wp-