0627\u0644\u0633\u0644\u0648\u0643\u060c \u0628\u0644 \u0627\u0644\u0645\u0634\u0627\u0639\u0631 \u0648\u0627\u0644\u062a\u062c\u0627\u0631\u0628 \u0623\u064a\u0636\u0627\u064b.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u0645\u0643\u0646\u0643 \u062d\u062a\u0649 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0643\u0627\u0645\u0644\u0629 \u0644\u0644\u062c\u0647\u0627\u0632\u060c \u0648\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u0639\u0643\u0633\u064a\u0629 \u0644\u062a\u0633\u062c\u064a\u0644 \u062a\u0639\u0628\u064a\u0631\u0627\u062a \u0648\u062c\u0647 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a \u0646\u0641\u0633 \u0627\u0644\u0648\u0642\u062a. \u062a\u0638\u0647\u0631 \u0627\u0644\u062a\u0633\u062c\u064a\u0644\u0627\u062a \u0639\u0644\u0649 \u0644\u0648\u062d\u0629 \u062a\u062d\u0643\u0645 Lookback\u060c \u062d\u064a\u062b \u064a\u0645\u0643\u0646 \u0644\u0641\u0631\u064a\u0642 \u0645\u0646 \u0627\u0644\u0623\u0634\u062e\u0627\u0635 \u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0646\u062a\u0627\u0626\u062c.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://www.techsmith.com/screen-capture.html\\\">Snagit\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u062a\u0642\u0627\u0637 \u0634\u0627\u0634\u0629 \u064a\u062a\u064a\u062d \u0644\u0643 \u062a\u062d\u0631\u064a\u0631 \u0644\u0642\u0637\u0627\u062a \u0627\u0644\u0634\u0627\u0634\u0629 \u0648\u0645\u0642\u0627\u0637\u0639 \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://helio.app/\\\">Helio\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">Helio (\u0643\u0627\u0646 \u064a\u064f\u0639\u0631\u0641 \u0633\u0627\u0628\u0642\u0627\u064b \u0628\u0640 Verify) \u0647\u0648 \u0623\u0633\u0647\u0644 \u0637\u0631\u064a\u0642\u0629 \u0644\u062c\u0645\u0639 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u062a\u062d\u0644\u064a\u0644 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0633\u062a\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0635\u0645\u064a\u0645. \u064a\u062a\u064a\u062d \u0644\u0643 Verify \u0631\u0641\u0639 \u0623\u064a \u0644\u0642\u0637\u0629 \u0634\u0627\u0634\u0629 \u0623\u0648 \u0635\u0648\u0631\u0629 \u0628\u0633\u0631\u0639\u0629 \u0644\u062c\u0645\u0639 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0639\u0644\u0649 \u062a\u0635\u0627\u0645\u064a\u0645\u0643.\\x3C/span>\\x3C/p>\\n\\x3Ch2>\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0648\u0627\u0644\u0645\u0644\u0641\u0627\u062a\\x3C/h2>\\n\\x3Ch4>\\x3Ca href=\\\"https://slack.com/\\\">Slack\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">Slack \u0647\u0648 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0645\u0631\u0627\u0633\u0644\u0629 \u0627\u0644\u0623\u0643\u062b\u0631 \u0634\u064a\u0648\u0639\u0627\u064b \u0641\u064a \u0628\u064a\u0626\u0629 \u0627\u0644\u0639\u0645\u0644 \u062d\u0627\u0644\u064a\u0627\u064b. \u064a\u0645\u0646\u062d \u0627\u0644\u062c\u0645\u064a\u0639 \u0645\u0633\u0627\u062d\u0629 \u0639\u0645\u0644 \u0645\u0634\u062a\u0631\u0643\u0629 \u0648\u064a\u062c\u0639\u0644 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0645\u0646\u0638\u0645\u0629 \u0648\u0633\u0647\u0644\u0629 \u0627\u0644\u0648\u0635\u0648\u0644 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0625\u0646\u0634\u0627\u0621 \u0623\u0631\u0634\u064a\u0641 \u0642\u0627\u0628\u0644 \u0644\u0644\u0628\u062d\u062b \u0644\u0645\u0647\u0627\u0645 \u0648\u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0641\u0631\u064a\u0642\u0643.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://basecamp.com/\\\">Basecamp\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">Basecamp \u0647\u064a \u0623\u062f\u0627\u0629 \u0625\u062f\u0627\u0631\u0629 \u0645\u0634\u0627\u0631\u064a\u0639 \u0648\u062a\u0639\u0627\u0648\u0646 \u0642\u0627\u0626\u0645\u0629 \u0639\u0644\u0649 \u0627\u0644\u0648\u064a\u0628.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0645\u0639 Basecamp\u060c \u064a\u0645\u0643\u0646\u0643 \u0625\u062f\u0627\u0631\u0629 \u0645\u0647\u0627\u0645 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0648\u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639 \u0623\u0639\u0636\u0627\u0621 \u0627\u0644\u0641\u0631\u064a\u0642 \u0639\u0628\u0631 \u0627\u0644\u0645\u062f\u0648\u0646\u0627\u062a \u0627\u0644\u0635\u063a\u064a\u0631\u0629 \u0648\u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629 \u0648\u0639\u0631\u0636 \u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0627\u0644\u0645\u0634\u0631\u0648\u0639. \u0625\u0646\u0647\u0627 \u0627\u0644\u0623\u062f\u0627\u0629 \u0627\u0644\u0645\u062b\u0627\u0644\u064a\u0629 \u0644\u0645\u062d\u062a\u0631\u0641\u064a UX \u0644\u0623\u0646\u0647\u0627 \u062a\u062a\u064a\u062d \u0644\u0643 \u0631\u0641\u0639 \u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u0628\u0635\u0631\u064a\u0629 \u0648\u0645\u0634\u0627\u0631\u0643\u062a\u0647\u0627 \u0645\u0639 \u0632\u0645\u0644\u0627\u0626\u0643.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u062d\u062a\u0648\u064a \u0643\u0644 \u0645\u0634\u0631\u0648\u0639 \u0639\u0644\u0649 \u0642\u0648\u0627\u0626\u0645 \u0645\u0647\u0627\u0645 \u0645\u062a\u0639\u062f\u062f\u0629\u060c \u0645\u0645\u0627 \u064a\u062c\u0639\u0644\u0647\u0627 \u0645\u0631\u0634\u062d\u0627\u064b \u0645\u062b\u0627\u0644\u064a\u0627\u064b \u0644\u062f\u0645\u062c \u0641\u0631\u0642 \u0645\u062a\u0639\u062f\u062f\u0629\u060c \u0645\u062b\u0644 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0645\u0639 \u0627\u0644\u062a\u0637\u0648\u064a\u0631.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://trello.com/\\\">Trello\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">Trello \u0647\u064a \u0623\u062f\u0627\u0629 \u0625\u062f\u0627\u0631\u0629 \u0645\u0634\u0627\u0631\u064a\u0639 \u0642\u0627\u0626\u0645\u0629 \u0639\u0644\u0649 \u0627\u0644\u0648\u064a\u0628 \u062a\u0642\u062f\u0645 \u0644\u0648\u062d\u0627\u062a \u0648\u0642\u0648\u0627\u0626\u0645 \u0648\u0628\u0637\u0627\u0642\u0627\u062a \u062a\u0645\u0643\u0646\u0643 \u0645\u0646 \u062a\u0646\u0638\u064a\u0645 \u0645\u0634\u0627\u0631\u064a\u0639\u0643 \u0648\u062a\u0631\u062a\u064a\u0628 \u0623\u0648\u0644\u0648\u064a\u0627\u062a\u0647\u0627.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0645\u0639 Trello \u064a\u0645\u0643\u0646\u0643 \u0625\u0646\u0634\u0627\u0621 \u0644\u0648\u062d\u0627\u062a \u0644\u062a\u0646\u0638\u064a\u0645 \u0623\u064a \u0634\u064a\u0621 \u062a\u0639\u0645\u0644 \u0639\u0644\u064a\u0647. \u064a\u062a\u064a\u062d \u0644\u0643 \u062f\u0639\u0648\u0629 \u0632\u0645\u0644\u0627\u0621 \u0627\u0644\u0639\u0645\u0644 \u0648\u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0644\u0644\u062a\u0639\u0627\u0648\u0646. \u064a\u0645\u0643\u0646\u0643 \u062a\u0639\u064a\u064a\u0646 \u0645\u0647\u0627\u0645 \u0644\u0646\u0641\u0633\u0643 \u0648\u0644\u0632\u0645\u0644\u0627\u0626\u0643 \u0648\u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0639\u0644\u0649 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0645\u0639 \u0623\u0635\u062f\u0642\u0627\u0626\u0643.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://www.atlassian.com/software/jira\\\">JIRA\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">JIRA \u0647\u064a \u0623\u062f\u0627\u0629 \u062a\u0637\u0648\u064a\u0631 \u0628\u0631\u0645\u062c\u064a\u0627\u062a \u062a\u064f\u0633\u062a\u062e\u062f\u0645 \u0628\u0634\u0643\u0644 \u0623\u0633\u0627\u0633\u064a \u0645\u0646 \u0642\u0628\u0644 \u0645\u062d\u062a\u0631\u0641\u064a UX \u0644\u062a\u062e\u0637\u064a\u0637 \u0648\u062a\u062a\u0628\u0639 \u0648\u0625\u0635\u062f\u0627\u0631 \u0645\u0646\u062a\u062c\u0627\u062a\u0647\u0645. \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0644\u0648\u062d\u0629 Scrum \u0627\u0644\u062a\u064a \u062a\u062c\u0639\u0644 \u062a\u0639\u064a\u064a\u0646 \u0627\u0644\u0645\u0647\u0627\u0645 \u0623\u0633\u0647\u0644 \u0628\u0643\u062b\u064a\u0631.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u062a\u062c\u0639\u0644 JIRA \u062a\u062a\u0628\u0639 \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0648\u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0645\u0634\u0643\u0644\u0627\u062a \u0627\u0644\u0645\u0639\u0644\u0642\u0629 \u0648\u0645\u0642\u062f\u0627\u0631 \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u0646\u0642\u0636\u064a \u0639\u0644\u0649 \u0643\u0644 \u0645\u0647\u0645\u0629 \u0623\u0645\u0631\u0627\u064b \u0633\u0647\u0644\u0627\u064b \u062c\u062f\u0627\u064b.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://evernote.com/\\\">Evernote\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">Evernote \u0647\u0648 \u062a\u0637\u0628\u064a\u0642 \u0645\u062a\u0637\u0648\u0631 \u0644\u062a\u062f\u0648\u064a\u0646 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0645\u062a\u0648\u0641\u0631 \u0639\u0628\u0631 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0648\u0628\u062a\u0646\u0633\u064a\u0642 \u062a\u0637\u0628\u064a\u0642 \u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0646 \u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0643\u0645\u0628\u064a\u0648\u062a\u0631 \u0648\u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0645\u062d\u0645\u0648\u0644\u0629. \u064a\u062a\u064a\u062d \u0644\u0643 \u062d\u0641\u0638 \u0648\u062a\u0630\u0643\u0631 \u0648\u0645\u0632\u0627\u0645\u0646\u0629 \u0623\u064a \u0634\u064a\u0621 \u062a\u0642\u0631\u064a\u0628\u0627\u064b\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0631\u062c\u0639\u064a\u0629 \u0648\u0627\u0644\u0635\u0648\u0631 \u0648\u0645\u0642\u0627\u0637\u0639 \u0627\u0644\u0646\u0635.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u062d\u062a\u0648\u064a Evernote \u0623\u064a\u0636\u0627\u064b \u0639\u0644\u0649 \u062e\u0627\u0635\u064a\u0629 \u0627\u0644\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u0646\u0635 \u0639\u0628\u0631 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a\u060c \u0633\u0648\u0627\u0621 \u0643\u0627\u0646\u062a \u0646\u0635\u0648\u0635\u0627\u064b \u0645\u0643\u062a\u0648\u0628\u0629 \u0623\u0648 \u0635\u0648\u0631\u0627\u064b \u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0645\u0643\u062a\u0648\u0628\u0629 \u0628\u062e\u0637 \u0627\u0644\u064a\u062f.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://www.google.com/drive/\\\">Google Drive\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u062a\u062a\u0637\u0644\u0628 \u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0646\u0648\u0639\u0627\u064b \u0645\u0646 \u0627\u0644\u062a\u0648\u062b\u064a\u0642 \u0627\u0644\u0645\u0643\u062a\u0648\u0628\u060c \u0625\u0645\u0627 \u0641\u064a \u0634\u0643\u0644 \u062c\u062f\u0627\u0648\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u0623\u0648 \u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0641\u0639\u0644\u064a\u0629\u061b \u0648\u0639\u0627\u062f\u0629 \u0645\u0627 \u064a\u0643\u0648\u0646 \u0647\u0630\u0627 \u0627\u0644\u062a\u0648\u062b\u064a\u0642 \u0646\u062a\u064a\u062c\u0629 \u062a\u0639\u0627\u0648\u0646 \u0628\u064a\u0646 \u0623\u0639\u0636\u0627\u0621 \u0627\u0644\u0641\u0631\u064a\u0642 \u0648\u0623\u0635\u062d\u0627\u0628 \u0627\u0644\u0645\u0635\u0644\u062d\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u062a\u064a\u062d Google Drive \u0625\u0646\u0634\u0627\u0621 \u062a\u0644\u0643 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0648\u0627\u0644\u062a\u0639\u0627\u0648\u0646 \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0641\u0639\u0644\u064a \u0648\u062a\u062a\u0628\u0639 \u0627\u0644\u0625\u0635\u062f\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u062e\u062a\u0644\u0641\u0629. \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0630\u0644\u0643\u060c \u064a\u0639\u0645\u0644 \u0641\u064a \u0645\u062a\u0635\u0641\u062d\u0643 \u0648\u0647\u0648 \u0645\u062c\u0627\u0646\u064a.\\x3C/span>\\x3C/p>\\n\\x3Ch2>\u0627\u0644\u062a\u062d\u0644\u064a\u0644\u0627\u062a\\x3C/h2>\\n\\x3Ch4>\\x3Ca href=\\\"https://www.kissmetricshq.com/\\\">Kissmetrics\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0623\u062f\u0627\u0629 \u062a\u062d\u0644\u064a\u0644\u0627\u062a \u0631\u0627\u0626\u0639\u0629 \u0633\u0647\u0644\u0629 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0648\u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645. \u062a\u0633\u0627\u0639\u062f\u0643 \u0641\u064a \u0625\u0646\u0634\u0627\u0621 \u0642\u0645\u0639 \u0648\u062a\u0642\u0627\u0631\u064a\u0631 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0633\u0644\u0648\u0643 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://www.crazyegg.com/\\\">CrazyEgg\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">CrazyEgg \u0647\u064a \u0623\u062f\u0627\u0629 \u062e\u0631\u0627\u0626\u0637 \u062d\u0631\u0627\u0631\u064a\u0629 \u062a\u064f\u0638\u0647\u0631 \u0644\u0643 \u0628\u0627\u0644\u0636\u0628\u0637 \u0623\u064a\u0646 \u064a\u0630\u0647\u0628 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643\u060c \u0648\u0623\u064a\u0646 \u064a\u062a\u0648\u0642\u0641\u0648\u0646 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0648\u0644\u0645\u062f\u0629 \u0643\u0645. \u0625\u0646\u0647\u0627 \u0628\u0633\u064a\u0637\u0629 \u0648\u0645\u0639\u0642\u0648\u0644\u0629 \u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0648\u0646\u0639\u0645 \u0647\u0646\u0627\u0643 \u062a\u062c\u0631\u0628\u0629 \u0645\u062c\u0627\u0646\u064a\u0629 \u0623\u064a\u0636\u0627\u064b.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://analytics.google.com/analytics/web/\\\">Google Analytics\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u062e\u0628\u0631\u0643 Google Analytics \u0628\u0643\u0644 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c \u0645\u0639\u0631\u0641\u062a\u0647 \u0639\u0646 \u0623\u062f\u0627\u0621 \u0645\u0648\u0642\u0639\u0643. \u064a\u062d\u0648\u0651\u0644 \u0631\u0624\u0649 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0625\u0644\u0649 \u062d\u0644\u0648\u0644 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u0646\u0641\u064a\u0630 \u0648\u064a\u064f\u0638\u0647\u0631 \u0644\u0643 \u0645\u062f\u0649 \u0641\u0639\u0627\u0644\u064a\u0629 \u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u062a\u0643 \u0627\u0644\u062d\u0627\u0644\u064a\u0629.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://www.optimizely.com/\\\">Optimizely\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">Optimizely\u060c \u0645\u062b\u0644 UserTesting\u060c \u062a\u062c\u0639\u0644 \u0645\u0646 \u0627\u0644\u0633\u0647\u0644 \u0627\u062e\u062a\u0628\u0627\u0631 \u0648\u062a\u062e\u0635\u064a\u0635 \u0645\u0648\u0642\u0639\u0643 \u0648\u062a\u0637\u0628\u064a\u0642 \u0647\u0627\u062a\u0641\u0643 \u0627\u0644\u0645\u062d\u0645\u0648\u0644. \u0648\u0645\u0639 \u0630\u0644\u0643\u060c \u064a\u0631\u0643\u0632 Optimizely \u0639\u0644\u0649 \u0646\u0648\u0639 \u0648\u0627\u062d\u062f \u0645\u062d\u062f\u062f \u0645\u0646 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a\u060c \u0627\u062e\u062a\u0628\u0627\u0631 A/B\u060c \u0628\u062d\u064a\u062b \u064a\u0645\u0643\u0646 \u0644\u0644\u0645\u0635\u0645\u0645\u064a\u0646 \u0631\u0624\u064a\u0629 \u0643\u064a\u0641 \u0633\u064a\u0624\u062b\u0631 \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0648\u0627\u062c\u0647\u0629 \u0639\u0644\u0649 \u0627\u0644\u062a\u062d\u0648\u064a\u0644\u0627\u062a.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://mixpanel.com/\\\">Mixpanel\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">Mixpanel \u0623\u062f\u0627\u0629 \u0634\u0627\u0645\u0644\u0629 \u062a\u062a\u064a\u062d \u062a\u062a\u0628\u0639 \u0631\u062d\u0644\u0629 \u0643\u0644 \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u0631\u062f\u064a\u060c \u0645\u0646 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0639\u0628\u0631 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0625\u0644\u0649 \u0645\u0633\u0627\u0631\u0627\u062a \u0627\u0644\u0642\u0645\u0639.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0648\u0623\u0646\u062a \u062a\u062f\u0641\u0639 \u0641\u0642\u0637 \u0645\u0642\u0627\u0628\u0644 \u0627\u0644\u0645\u0642\u0627\u064a\u064a\u0633 \u0627\u0644\u062a\u064a \u062a\u0633\u062a\u062e\u062f\u0645\u0647\u0627. \u064a\u062c\u0645\u0639 Mixpanel \u0643\u0644 \u0634\u064a\u0621 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0644\u0643\u0646\u0643 \u0633\u062a\u064f\u062d\u0627\u0633\u0628 \u0639\u0644\u0649 \u062a\u0644\u0643 \u0627\u0644\u0645\u0642\u0627\u064a\u064a\u0633 \u0641\u0642\u0637 \u0639\u0646\u062f\u0645\u0627 \u062a\u0628\u062f\u0623 \u0641\u064a \u062a\u062d\u0644\u064a\u0644\u0647\u0627.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://www.hotjar.com/\\\">Hotjar\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u062e\u0631\u0627\u0626\u0637 \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0645\u0627 \u064a\u0647\u0645\u0643\u060c \u064a\u0642\u062f\u0645 Hotjar \u062e\u062f\u0645\u0629 \u0634\u0627\u0645\u0644\u0629\u060c \u0645\u0639 \u0625\u0636\u0627\u0641\u0627\u062a \u0645\u062b\u0644 \u0642\u0645\u0639 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0648\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0648\u0627\u0644\u0627\u0633\u062a\u0637\u0644\u0627\u0639\u0627\u062a \u0648\u0627\u0644\u0645\u0633\u0648\u062d\u0627\u062a.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Ci>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0641\u064a UXBERT Labs \u0646\u062d\u0646 \u0645\u062a\u062e\u0635\u0635\u0648\u0646 \u0641\u064a \u0627\u0633\u062a\u0634\u0627\u0631\u0627\u062a UX \u0648\u0627\u0644\u0627\u0628\u062a\u0643\u0627\u0631 \u0627\u0644\u062a\u0643\u0646\u0648\u0644\u0648\u062c\u064a \u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0639\u0644\u0649 \u062a\u0642\u062f\u064a\u0645 \u062a\u062c\u0627\u0631\u0628 \u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0639\u0627\u0644\u0645\u064a. \u0645\u0639 \u0645\u0643\u0627\u062a\u0628 \u0641\u064a \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u062f\u0628\u064a\u060c \u064a\u0642\u062f\u0645 \u0641\u0631\u064a\u0642\u0646\u0627 \u0645\u0646 \u0628\u0627\u062d\u062b\u064a \u0648\u0645\u0635\u0645\u0645\u064a \u0648\u0645\u0637\u0648\u0631\u064a UX \u0628\u0631\u0645\u062c\u064a\u0627\u062a \u0645\u0635\u0645\u0645\u0629 \u0648\u0645\u0628\u0646\u064a\u0629 \u062e\u0635\u064a\u0635\u0627\u064b \u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0646\u062c\u0627\u062d.\\x3C/span>\\x3C/i>\\x3C/p>\\n\\x3Cp>\\x3Cem>\u0645\u0647\u062a\u0645 \u0628\u0627\u0644\u0639\u0645\u0644 \u0645\u0639\u0646\u0627\u061f \u0631\u0627\u0633\u0644\u0646\u0627 \u0639\u0644\u0649 \\x3C/em>hello@uxbert.com\\x3Cem> \u0648\u0623\u062e\u0628\u0631\u0646\u0627 \u0628\u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a\u0643 \u0641\u064a \u0627\u0644\u0628\u062d\u062b \u0623\u0648 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0623\u0648 \u0627\u0644\u062a\u0637\u0648\u064a\u0631