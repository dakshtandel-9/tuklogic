n style=\\\"font-weight: 400;\\\">\\x3Cstrong>\u0642\u0645 \u0628\u062a\u0642\u0635\u064a\u0631 \u0627\u0644\u0642\u0648\u0627\u0626\u0645 \u0627\u0644\u0637\u0648\u064a\u0644\u0629 \u0648\u062a\u0642\u0644\u064a\u0644 \u0643\u0645\u064a\u0629 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u062d\u064a\u062b\u0645\u0627 \u0623\u0645\u0643\u0646 \u0630\u0644\u0643.\\x3C/strong> \u0641\u064a \u0627\u0644\u062d\u0627\u0644\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0643\u0648\u0646 \u0641\u064a\u0647\u0627 \u0627\u0644\u0642\u0648\u0627\u0626\u0645 \u0627\u0644\u0637\u0648\u064a\u0644\u0629 \u0623\u0645\u0631\u064b\u0627 \u0644\u0627 \u0645\u0641\u0631 \u0645\u0646\u0647\u060c \u0642\u0645 \u0628\u062a\u062d\u062f\u064a\u062f \u0639\u062f\u062f \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u0645\u0643\u0646 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0631\u0636\u0647\u0627 \u0641\u064a \u0627\u0644\u0645\u0631\u0629 \u0627\u0644\u0648\u0627\u062d\u062f\u0629 \u0644\u062c\u0639\u0644 \u0627\u0644\u0645\u0633\u062d \u0623\u0633\u0647\u0644 \u0648\u0623\u0633\u0631\u0639.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cimg alt=\\\"hickslaw\\\" class=\\\"aligncenter size-full wp-image-11613\\\" decoding=\\\"async\\\" height=\\\"359\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 681px) 100vw, 681px\\\" src=\\\"/wp-contentuploads/2018/03/hickslaw.png\\\" srcset=\\\"/wp-contentuploads/2018/03/hickslaw.png 681w, /wp-contentuploads/2018/03/hickslaw-300x158.png 300w, /wp-contentuploads/2018/03/hickslaw-330x174.png 330w, /wp-contentuploads/2018/03/hickslaw-414x218.png 414w\\\" width=\\\"681\\\"/>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0642\u0645 \u0628\u062a\u0642\u0633\u064a\u0645 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0645\u0639\u0642\u062f\u0629\u060c \u0645\u062b\u0644 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0623\u0648 \u0627\u0644\u062e\u0631\u0648\u062c\u060c \u0625\u0644\u0649 \u062e\u0637\u0648\u0627\u062a \u0623\u0643\u062b\u0631 \u0633\u0647\u0648\u0644\u0629 \u0648\u0628\u0633\u0627\u0637\u0629.\\x3C/span>\\x3Cstrong>\u062a\u0642\u062f\u064a\u0645 \u0645\u0633\u0627\u0631\u0627\u062a \u0648\u0627\u0636\u062d\u0629\\x3C/strong>\\x3Cspan style=\\\"font-weight: 400;\\\">\\x3Cstrong>\u0644\u062a\u0642\u0644\u064a\u0644 \u0648\u0642\u062a \u0627\u0644\u062a\u0646\u0642\u0644 \u0648\u0645\u0639\u062f\u0644\u0627\u062a \u0627\u0644\u0627\u0631\u062a\u062f\u0627\u062f\\x3C/strong> \u0645\u0646 \u0623\u062c\u0644 \u062e\u0644\u0642 \u062a\u062c\u0631\u0628\u0629 \u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0645\u062a\u0639\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0647\u062f\u0641\u0643 \u062f\u0627\u0626\u0645\u064b\u0627 \u0647\u0648 \u062a\u0642\u0644\u064a\u0644 \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0630\u064a \u064a\u0633\u062a\u063a\u0631\u0642\u0647 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0644\u0627\u062a\u062e\u0627\u0630 \u0642\u0631\u0627\u0631\u0627\u062a\u0647\u0645\u060c \u062d\u062a\u0649 \u064a\u0646\u062a\u0647\u064a \u0628\u0647\u0645 \u0627\u0644\u0623\u0645\u0631 \u0625\u0644\u0649 \u0627\u062a\u062e\u0627\u0630 \u0627\u0644\u0642\u0631\u0627\u0631.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Ca name=\\\"gestalt_principles_of_visual_perception\\\">\\x3C/a>\\x3Cb>2. \u0645\u0628\u0627\u062f\u0626 \u0627\u0644\u062c\u0634\u0637\u0627\u0644\u062a \u0644\u0644\u0625\u062f\u0631\u0627\u0643 \u0627\u0644\u0628\u0635\u0631\u064a\\x3C/b>\\x3C/p>\\n\\x3Cp>\u064a\u0639\u0627\u0644\u062c \u062f\u0645\u0627\u063a\u0646\u0627 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0628\u0637\u0631\u064a\u0642\u0629 \u0631\u0627\u0626\u0639\u0629.\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0641\u064a \u0643\u062b\u064a\u0631 \u0645\u0646 \u0627\u0644\u0623\u062d\u064a\u0627\u0646 \u064a\u062a\u0645 \u0627\u0644\u062a\u0644\u0627\u0639\u0628 \u0628\u0625\u062f\u0631\u0627\u0643\u0646\u0627 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0643\u064a\u0641\u064a\u0629 \u0631\u0624\u064a\u062a\u0646\u0627 \u0644\u0644\u0623\u0634\u064a\u0627\u0621 \u0648\u0631\u0628\u0637\u0647\u0627 \u0628\u0628\u0639\u0636\u0647\u0627 \u0627\u0644\u0628\u0639\u0636 \u0639\u0644\u0649 \u0623\u0633\u0627\u0633 \u0627\u0644\u062a\u0628\u0627\u0639\u062f. \u064a\u062a\u0645 \u0627\u0644\u062a\u063a\u0627\u0636\u064a \u0639\u0646 \u0627\u0644\u0641\u062c\u0648\u0627\u062a \u0623\u0648 \u0627\u0644\u062a\u0646\u0627\u0642\u0636\u0627\u062a \u0623\u0648 \u0627\u0644\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0645\u0646 \u0642\u0628\u0644 \u062f\u0645\u0627\u063a\u0646\u0627 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0642\u0648\u0627\u0646\u064a\u0646 \u0627\u0644\u062a\u0646\u0638\u064a\u0645.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u062a\u0634\u0631\u062d \u0646\u0638\u0631\u064a\u0629 \u0627\u0644\u062c\u0634\u0637\u0627\u0644\u062a \u0630\u0644\u0643\\x3Cstrong>\u064a\u0642\u0648\u0645 \u0627\u0644\u0645\u0634\u0627\u0647\u062f\u0648\u0646 \u0628\u0634\u0643\u0644 \u0644\u0627 \u0634\u0639\u0648\u0631\u064a \u0628\u062a\u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u0645\u0646\u0641\u0635\u0644\u0629 \u0645\u0639\u064b\u0627 \u0644\u0625\u062f\u0631\u0627\u0643\u0647\u0627 \u0643\u0643\u0644\\x3C/strong> . \\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u062a\u0645 \u062a\u0646\u0638\u064a\u0645 \u0645\u0628\u0627\u062f\u0626 \u0646\u0638\u0631\u064a\u0629 \u0627\u0644\u062c\u0634\u0637\u0627\u0644\u062a \u0641\u064a \u0633\u062a \u0641\u0626\u0627\u062a:\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cimg alt=\\\"Gestalt Principles\\\" class=\\\"aligncenter wp-image-11623\\\" decoding=\\\"async\\\" height=\\\"272\\\" loading=\\\"lazy\\\" src=\\\"/wp-content/uploads/2018/03/gestalt-principles-1024x541.jpg\\\" width=\\\"514\\\"/>\\x3C/p>\\n\\x3Cp>\\x3Cb>\\x3Ci>\u0642\u0627\u0646\u0648\u0646 \u0627\u0644\u062a\u0645\u0627\u062b\u0644:\\x3C/i>\\x3C/b>\u064a\u062c\u062f \u0627\u0644\u0628\u0634\u0631 \u0628\u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u062d\u0627\u0644 \u0623\u0646 \u0627\u0644\u062a\u0646\u0627\u0638\u0631 \u0645\u0645\u062a\u0639 \u0645\u0646 \u0627\u0644\u0646\u0627\u062d\u064a\u0629 \u0627\u0644\u062c\u0645\u0627\u0644\u064a\u0629\u060c \u0644\u0630\u0644\u0643 \u0639\u0646\u062f\u0645\u0627 \u0646\u0646\u0638\u0631 \u0625\u0644\u0649 \u0623\u0634\u064a\u0627\u0621 \u0645\u0639\u064a\u0646\u0629\u060c \u0646\u0631\u0627\u0647\u0627 \u0643\u0623\u0634\u0643\u0627\u0644 \u0645\u062a\u0646\u0627\u0638\u0631\u0629 \u062a\u062a\u0634\u0643\u0644 \u062d\u0648\u0644 \u0645\u0631\u0627\u0643\u0632\u0647\u0627. \u062a\u0639\u062f \u0634\u0639\u0627\u0631\u0627\u062a \u0633\u062a\u0627\u0631\u0628\u0643\u0633 \u0648\u0645\u0627\u0643\u062f\u0648\u0646\u0627\u0644\u062f\u0632 \u0623\u0645\u062b\u0644\u0629 \u0631\u0627\u0626\u0639\u0629 \u0644\u0643\u064a\u0641\u064a\u0629 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0645\u0627\u062b\u0644 \u0641\u064a \u0627\u0644\u062a\u0635\u0645\u064a\u0645.\\x3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp style=\\\"text-align: center;\\\">\\x3Cimg alt=\\\"Starbucks Logo\\\" class=\\\"wp-image-11629\\\" decoding=\\\"async\\\" height=\\\"140\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 140px) 100vw, 140px\\\" src=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-3.jpg\\\" srcset=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-45.jpg 150w, /uploads/articles/ux-psychology-principles-design-ux/inline-10.jpg 300w, /uploads/articles/ux-psychology-principles-design-ux/inline-38.jpg 225w, /uploads/articles/ux-psychology-principles-design-ux/inline-40.jpg 200w, /uploads/articles/ux-psychology-principles-design-ux/inline-69.jpg 260w, /uploads/articles/ux-psychology-principles-design-ux