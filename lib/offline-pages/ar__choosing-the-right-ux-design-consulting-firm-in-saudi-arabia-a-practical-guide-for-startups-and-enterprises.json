e=\\\"font-weight: 400;\\\">\u0634\u0639\u0628\u064a\u0629 \u0627\u0644\u0623\u062f\u0627\u0629 \u062a\u0639\u0646\u064a \u0623\u0646 \u0639\u062f\u062f\u0627\u064b \u0643\u0628\u064a\u0631\u0627\u064b \u0645\u0646 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062c\u0648\u062f\u0629 \u0627\u0644\u0645\u064f\u0639\u062f\u0629 \u0645\u0633\u0628\u0642\u0627\u064b \u0648\u0627\u0644\u0642\u0627\u0628\u0644\u0629 \u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0623\u0635\u0628\u062d\u062a \u0645\u062a\u0627\u062d\u0629 \u0644\u0644\u062a\u062d\u0645\u064a\u0644. \u0647\u0630\u0627 \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0648\u0641\u0631 \u0642\u062f\u0631\u0627\u064b \u0647\u0627\u0626\u0644\u0627\u064b \u0645\u0646 \u0627\u0644\u0648\u0642\u062a \u0648\u0627\u0644\u062c\u0647\u062f.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://www.invisionapp.com/\\\">Invision\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0648\u0627\u062d\u062f\u0629 \u0645\u0646 \u0623\u0641\u0636\u0644 \u0645\u0646\u0635\u0627\u062a \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0623\u0648\u0644\u064a\u0629 \u0648\u0627\u0644\u062a\u0639\u0627\u0648\u0646 \u0627\u0644\u0645\u062a\u0627\u062d\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0628\u0628\u0633\u0627\u0637\u0629 \u0644\u0627 \u064a\u0648\u062c\u062f \u0634\u064a\u0621 \u0622\u062e\u0631 \u064a\u064f\u0639\u0638\u0651\u0645 \u0627\u0644\u0633\u0631\u0639\u0629 \u0645\u0639 \u0627\u0644\u062f\u0642\u0629. \u0627\u0644\u0623\u062f\u0627\u0629 \u0644\u0627 \u062a\u062a\u064a\u062d \u0644\u0643 \u0641\u0642\u0637 \u0625\u0646\u0634\u0627\u0621 \u0646\u0645\u0627\u0630\u062c \u0623\u0648\u0644\u064a\u0629 \u062a\u0641\u0627\u0639\u0644\u064a\u0629 \u0645\u0646 \u062a\u0635\u0627\u0645\u064a\u0645 \u0645\u0633\u062a\u0648\u0631\u062f\u0629\u060c \u0628\u0644 \u0647\u064a \u0645\u0641\u064a\u062f\u0629 \u0623\u064a\u0636\u0627\u064b \u0644\u062c\u0645\u0639 \u0627\u0644\u062a\u063a\u0630\u064a\u0629 \u0627\u0644\u0631\u0627\u062c\u0639\u0629 \u0648\u0644\u0644\u062a\u0639\u0627\u0648\u0646 \u0641\u064a \u0627\u0644\u062a\u0635\u0627\u0645\u064a\u0645 \u0648\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0628\u0634\u0643\u0644 \u0639\u0627\u0645.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0648\u0625\u0630\u0627 \u0644\u0645 \u064a\u0643\u0646 \u0630\u0644\u0643 \u0643\u0627\u0641\u064a\u0627\u064b\u060c \u064a\u062f\u0639\u0645 InVision \u0627\u0644\u0622\u0646 \u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0644\u0649 \u0627\u0644\u0647\u0627\u062a\u0641 \u0627\u0644\u0645\u062d\u0645\u0648\u0644 \u0639\u0646 \u0628\u064f\u0639\u062f.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://www.infragistics.com/products/indigo-design\\\">Indigo\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">Indigo Design \u0645\u062b\u0627\u0644\u064a \u0644\u0625\u0646\u0634\u0627\u0621 \u0646\u0645\u0627\u0630\u062c \u0623\u0648\u0644\u064a\u0629 \u062a\u0641\u0627\u0639\u0644\u064a\u0629 \u0648\u0645\u062a\u062d\u0631\u0643\u0629 \u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0648\u064a\u0628 \u0648\u0633\u0637\u062d \u0627\u0644\u0645\u0643\u062a\u0628 \u0648\u0627\u0644\u0647\u0627\u062a\u0641 \u0627\u0644\u0645\u062d\u0645\u0648\u0644.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0625\u0646\u0647 \u0628\u062f\u064a\u0647\u064a \u062c\u062f\u0627\u064b \u0648\u0633\u0631\u064a\u0639 \u0628\u0634\u0643\u0644 \u0645\u0641\u0627\u062c\u0626 \u0628\u0645\u062c\u0631\u062f \u0625\u0646\u0634\u0627\u0621 \u0628\u0636\u0639\u0629 \u0646\u0645\u0627\u0630\u062c \u0623\u0648\u0644\u064a\u0629. \u064a\u0645\u0643\u0646 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0623\u0648\u0644\u064a\u0629 \u0645\u0646 \u0646\u0645\u0627\u0630\u062c \u0645\u0648\u062c\u0648\u062f\u0629 (\u0628\u0625\u062d\u0636\u0627\u0631\u0647\u0627 \u0643\u0635\u0648\u0631) \u0623\u0648 \u0628\u0628\u0646\u0627\u0621 \u0639\u0646\u0627\u0635\u0631 \u0641\u0631\u062f\u064a\u0629 \u0644\u0643\u0644 \u0634\u0627\u0634\u0629 \u062f\u0627\u062e\u0644 Indigo Studio.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u062a\u062a\u064a\u062d \u0644\u0643 \u0627\u0646\u062a\u0642\u0627\u0644\u0627\u062a \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0645\u062f\u0645\u062c\u0629 \u0648\u0625\u064a\u0645\u0627\u0621\u0627\u062a \u0627\u0644\u0644\u0645\u0633 \u0625\u0646\u0634\u0627\u0621 \u0646\u0645\u0627\u0630\u062c \u0623\u0648\u0644\u064a\u0629 \u062a\u0628\u062f\u0648 \u0648\u062a\u0634\u0639\u0631 \u0648\u062a\u062a\u0635\u0631\u0641 \u0643\u062a\u0637\u0628\u064a\u0642 \u062d\u0642\u064a\u0642\u064a \u0639\u0644\u0649 \u062c\u0647\u0627\u0632\u0643 \u0627\u0644\u0645\u062d\u0645\u0648\u0644.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u062a\u064a\u062d \u0644\u0643 Indigo Studio \u0623\u064a\u0636\u0627\u064b \u062f\u0639\u0648\u0629 \u0627\u0644\u0623\u0639\u0636\u0627\u0621 \u0644\u0646\u0634\u0631 \u0628\u062f\u0627\u0626\u0644 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0623\u0648 \u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0623\u0648\u0644\u064a\u0629 \u0641\u064a \u0645\u0633\u0627\u062d\u0629 \u0639\u0645\u0644 \u062c\u0645\u0627\u0639\u064a\u0629. \u064a\u0623\u062a\u064a \u0645\u0639 \u062a\u0639\u0644\u064a\u0642\u0627\u062a \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0641\u0639\u0644\u064a\u060c \u062d\u064a\u062b \u064a\u0645\u0643\u0646 \u0644\u0644\u0645\u0634\u0627\u0647\u062f\u064a\u0646 \u0625\u0636\u0627\u0641\u0629 \u0639\u0644\u0627\u0645\u0627\u062a \u0648\u062a\u0639\u0644\u064a\u0642\u0627\u062a \u0645\u0628\u0627\u0634\u0631\u0629 \u0639\u0644\u0649 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0623\u0648\u0644\u064a.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://marvelapp.com/\\\">Marvel\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">Marvel \u0647\u0648 \u062a\u0637\u0628\u064a\u0642 \u0642\u0627\u0626\u0645 \u0639\u0644\u0649 \u0627\u0644\u0648\u064a\u0628 \u0648\u0628\u0633\u064a\u0637 \u0648\u0633\u0647\u0644 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062c\u062f\u0627\u064b.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0645\u064a\u0632\u0627\u062a \u0645\u062b\u0644 \u0627\u0644\u0625\u064a\u0645\u0627\u0621\u0627\u062a \u0648\u0637\u0628\u0642\u0627\u062a \u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645. \u0643\u0645\u0627 \u064a\u0642\u062f\u0645 \u0625\u0636\u0627\u0641\u0629 Sketch \u062a\u062a\u064a\u062d \u0644\u0643 \u0627\u0644\u0642\u064a\u0627\u0645 \u0628\u0639\u0645\u0644 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0639\u0644\u0649 Sketch \u0645\u0639 \u0627\u0633\u062a\u0639\u0627\u0631\u0629 \u0628\u0639\u0636 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0631\u0627\u0626\u0639\u0629 \u0645\u0646 Marvel \u0645\u062b\u0644 \u0627\u0644\u0637\u0628\u0642\u0627\u062a \u0648\u0627\u0644\u0625\u064a\u0645\u0627\u0621\u0627\u062a.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u0645\u0643\u0646\u0643 \u062c\u0639\u0644 \u0645\u0634\u0631\u0648\u0639\u0643 \u062a\u0639\u0627\u0648\u0646\u064a\u0627\u064b\u060c \u0644\u0643\u0646 \u0641\u0642\u0637 \u0645\u0639 \u062d\u0633\u0627\u0628 \u0645\u064f\u0631\u0642\u0651\u0649.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://www.adobe.com/uk/products/xd.html?gclid=EAIaIQobChMI-8_QhvSR3QIVQbTtCh0-sg_2EAAYASAAEgLv2_D_BwE&sdid=88X75SKR&mv=search&s_kwcid=AL!3085!3!274003210725!e!!g!!adobe%20xd&ef_id=VEKL0wAAAPNWowEV:20180829090506:s\\\">Adobe XD\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0645\u0639 Adobe XD\u060c \u064a\u0645\u0643\u0646\u0643 \u0628\u0646\u0627\u0621 \u0646\u0645\u0627\u0630\u062c \u0623\u0648\u0644\u064a\u0629 \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062f\u0642\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u062a\u0631\u0643\u0632 \u0627\u0644\u0623\u062f\u0627\u0629 \u062d\u0648\u0644 \u0648\u0638\u064a\u0641\u062a\u064a\u0646: \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0648\u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0623\u0648\u0644\u064a. \u062a\u064f\u0633\u062a\u062e\u062f\u0645 \u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0644\u0625\u0646\u0634\u0627\u0621 \u062a\u0635\u0645\u064a\u0645\u0643 \u0648\u062a\u062a\u0636\u0645\u0646 \u0623\u062f\u0648\u0627\u062a \u0645\u062a\u062c\u0647\u0627\u062a \u0648\u0646\u0635\u0648\u0635 \u0628\u0633\u064a\u0637\u0629. \u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0623\u0648\u0644\u064a \u0647\u064a \u0644\u0644\u0645\u0639\u0627\u064a\u0646\u0629 \u0648\u0645\u0634\u0627\u0631\u0643\u0629 \u062a\u0635\u0645\u064a\u0645\u0643.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://balsamiq.com/?gclid=EAIaIQobChMIh5S8kfSR3QIVzrDtCh29wgf3EAAYAiAAEgLZh_D_BwE\\\">Balsamiq\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0625\u0630\u0627 \u0643\u0646\u062a \u0644\u0627 \u062a\u0631\u064a\u062f \u0642\u0636\u0627\u0621 \u0627\u0644\u0643\u062b\u064a\u0631 \u0645\u0646 \u0627\u0644\u0648\u0642\u062a \u0641\u064a \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0623\u0648\u0644\u064a\u0629\u060c \u064a\u062c\u0628 \u0623\u0646 \u062a\u0633\u062a\u062e\u062f\u0645 Balsamiq.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0644\u064a\u0633 \u0627\u0644\u062e\u064a\u0627\u0631 \u0627\u0644\u0623\u0643\u062b\u0631 \u062c\u0645\u0627\u0644\u064a\u0629\u060c \u0644\u0643\u0646\u0647 \u0628\u0633\u064a\u0637 \u0648\u0641\u0639\u0627\u0644 \u062c\u062f\u0627\u064b \u0639\u0646\u062f\u0645\u0627 \u064a\u062a\u0639\u0644\u0642 \u0627\u0644\u0623\u0645\u0631 \u0628\u0625\u0646\u0634\u0627\u0621 \u0646\u0645\u0648\u0630\u062c \u0623\u0648\u0644\u064a \u0645\u0641\u064a\u062f. \u0625\u0646\u0647 \u0633\u0631\u064a\u0639 \u0648\u0644\u0627 \u064a\u062a\u0637\u0644\u0628 \u0627\u0644\u0643\u062b\u064a\u0631 \u0645\u0646 \u0627\u0644\u062a\u0645\u0631\u064a\u0646 \u0644\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639\u0647.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0633\u064a\u0643\u0648\u0646 \u0644\u062f\u064a\u0643 \u0646\u0633\u062e\u0629 \u0645\u0644\u0645\u0648\u0633\u0629 \u0645\u0646 \u0623\u0641\u0643\u0627\u0631\u0643 \u0627\u0644\u0645\u0628\u0643\u0631\u0629 \u064a\u0645\u0643\u0646\u0643 \u0627\u062e\u062a\u0628\u0627\u0631\u0647\u0627 \u0645\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0648\u0627\u0644\u062a\u0643\u0631\u0627\u0631 \u0642\u0628\u0644 \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0625\u0644\u0649 \u0634\u064a\u0621 \u0623\u0643\u062b\u0631 \u0635\u0642\u0644\u0627\u064b.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://www.uxpin.com/\\\">UX Pin\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0623\u062f\u0627\u0629 \u0642\u0648\u064a\u0629 \u064a\u0645\u0643\u0646\u0647\u0627 \u0625\u0646\u0634\u0627\u0621 \u0646\u0645\u0627\u0630\u062c \u0623\u0648\u0644\u064a\u0629 \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062f\u0642\u0629 \u0648\u0627\u0642\u0639\u064a\u0629 \u0644\u0644\u063a\u0627\u064a\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0639\u0644\u0649 \u0627\u0644\u0631\u063a\u0645 \u0645\u0646 \u0623\u0646\u0647\u0627 \u062a\u0645\u062a\u0644\u0643 \u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u0627\u0633\u0639\u0629 \u0645\u0646 \u0627\u0644\u0645\u064a\u0632\u0627\u062a\u060c \u0625\u0644\u0627 \u0623\u0646 \u0625\u062d\u062f\u0649 \u0648\u0638\u0627\u0626\u0641\u0647\u0627 \u0627\u0644\u0641\u0631\u064a\u062f\u0629 \u0647\u064a \u0623\u0646\u0647\u0627 \u062a\u0633\u0647\u0644 \u0628\u0646\u0627\u0621 \u0646\u0645\u0627\u0630\u062c \u0623\u0648\u0644\u064a\u0629 \u062a\u0641\u0627\u0639\u0644\u064a\u0629 \u0645\u062a\u062c\u0627\u0648\u0628\u0629 \u0645\u0628\u0627\u0634\u0631\u0629 \u0641\u064a \u0645\u062a\u0635\u0641\u062d\u0643.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u062a\u062d\u062a\u0648\u064a \u0627\u0644\u0623\u062f\u0627\u0629 \u0623\u064a\u0636\u0627\u064b \u0639\u0644\u0649 \u0645\u064a\u0632\u0629 \u0627\u0645\u062a\u062f\u0627\u062f Photoshop \u062a\u062a\u064a\u062d \u0644\u0644\u0645\u0635\u0645\u0645\u064a\u0646 \u0645\u0632\u064a\u062f\u0627\u064b \u0645\u0646 \u0627\u0644\u0645\u0631\u0648\u0646\u0629. \u0642\u062f \u064a\u0643\u0648\u0646 \u0644\u0647\u0627 \u0645\u0646\u062d\u0646\u0649 \u062a\u0639\u0644\u0645 \u062d\u0627\u062f\u060c \u0644\u0643\u0646\u0647\u0627 \u0628\u0627\u0644\u062a\u0623\u0643\u064a\u062f \u062a\u0633\u062a\u062d\u0642 \u0627\u0644\u062c\u0647\u062f.\\x3C/span>\\x3C/p>\\n\\x3Ch2>\u0623\u0628\u062d\u0627\u062b \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\\x3C/h2>\\n\\x3Ch4>\\x3Ca href=\\\"https://www.usertesting.com/\\\">UserTesting\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0623\u062f\u0627\u0629 \u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u062a\u064a\u062d \u0644\u0643 \u062a\u0633\u062c\u064a\u0644 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0623\u062b\u0646\u0627\u0621 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0645 \u0644\u0644\u0645\u0646\u062a\u062c.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0641\u064a \u0623\u0642\u0644 \u0645\u0646 \u0633\u0627\u0639\u0629 \u064a\u0645\u0643\u0646\u0643 \u0625\u062c\u0631\u0627\u0621 \u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u063a\u064a\u0631 \u062e\u0627\u0636\u0639 \u0644\u0644\u0625\u0634\u0631\u0627\u0641 \u0644\u0645\u0648\u0642\u0639\u0643 \u0645\u0639 \u0642\u0627\u0639\u062f\u0629 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0645\u062d\u062f\u062f\u0629 \u0645\u0633\u0628\u0642\u0627\u064b. UserTesting \u0645\u0644\u064a\u0621 \u0623\u064a\u0636\u0627\u064b \u0628\u0645\u062d\u062a\u0648\u0649 \u0645\u0641\u064a\u062f \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0631\u063a\u0628 \u0641\u064a \u062a\u0648\u0633\u064a\u0639 \u0645\u0639\u0631\u0641\u062a\u0643 \u0627\u0644\u0628\u062d\u062b\u064a\u0629.\\x3C/span>\\x3C/p>\\n\\x3Ch4>\\x3Ca href=\\\"https://www.techsmith.com/morae.html\\\">TechSmith Morae\\x3C/a>\\x3C/h4>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">Morae \u0647\u064a \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u062e\u062a\u0628\u0627\u0631 \u062a\u062a\u064a\u062d \u0644\u0643 \u0625\u062c\u0631\u0627\u0621 \u062c\u0644\u0633\u0627\u062a \u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0639\u0646 \u0637\u0631\u064a\u0642 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0634\u0627\u0634\u0629 \u0648\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0648\u062f\u0645\u062c \u0627\u0644\u0627\u0633\u062a\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u062a\u062d\u0644\u064a\u0644 \u0648\u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u062a\u064a\u062d \u0644\u0643 Morae \u0645\u0634\u0627\u0631\u0643\u0629 \u0623\u0628\u062d\u0