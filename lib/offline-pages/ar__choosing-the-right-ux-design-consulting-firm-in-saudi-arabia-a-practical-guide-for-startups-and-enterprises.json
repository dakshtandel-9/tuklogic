\u064a\u0632 \u0639\u0646 \u0627\u0644\u0628\u0627\u0642\u064a\u060c \u064a\u062c\u0628 \u0623\u0646 \u062a\u062e\u0644\u0642 \u062a\u0635\u0645\u064a\u0645\u0627\u062a\u0643 \u062a\u062c\u0631\u0628\u0629 \u0644\u0627 \u062a\u064f\u0646\u0633\u0649 \u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0643.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cimg alt=\\\"Von Restorff Effect\\\" class=\\\"aligncenter size-full wp-image-11677\\\" decoding=\\\"async\\\" height=\\\"141\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 358px) 100vw, 358px\\\" src=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-6.jpeg\\\" srcset=\\\"/uploads/articles/ux-psychology-principles-design-ux/inline-6.jpeg 358w, /uploads/articles/ux-psychology-principles-design-ux/inline-4.jpeg 300w, /uploads/articles/ux-psychology-principles-design-ux/inline-39.jpeg 330w\\\" width=\\\"358\\\"/>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0644\u0641\u062a \u0627\u0644\u0627\u0646\u062a\u0628\u0627\u0647 \u0625\u0644\u0649 \u0639\u0646\u0627\u0635\u0631 \u0648\u0645\u0641\u0627\u0647\u064a\u0645 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0645\u0647\u0645\u0629 \u0644\u062a\u0633\u0647\u064a\u0644 \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0648\u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0645\u0627 \u064a\u0631\u0648\u0646\u0647 \u0648\u064a\u0641\u0639\u0644\u0648\u0646\u0647.\\x3Cstrong>\u0623\u0643\u062f \u0639\u0644\u0649 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0647\u0645\u0629 \u0639\u0646 \u0637\u0631\u064a\u0642 \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0636\u0648\u0621 \u0648\u0627\u0644\u0644\u0648\u0646 \u0648\u0627\u0644\u062d\u062c\u0645 \u0648\u0627\u0644\u0635\u0648\u0631\u0629 \u0648\u0627\u0644\u062e\u0637 \u0648\u0627\u0644\u0631\u0633\u0648\u0645 \u0627\u0644\u0645\u062a\u062d\u0631\u0643\u0629 \u0648\u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0648\u0627\u0644\u0623\u0635\u0648\u0627\u062a.\\x3C/strong> \\x3C/span>\\x3C/p>\\n\\x3Cdiv class=\\\"wp-caption alignleft\\\" id=\\\"attachment_11678\\\" style=\\\"width: 1118px\\\">\\x3Cimg alt=\\\"Medium Website\\\" aria-describedby=\\\"caption-attachment-11678\\\" class=\\\"wp-image-11678 size-full\\\" decoding=\\\"async\\\" height=\\\"551\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 1108px) 100vw, 1108px\\\" src=\\\"/wp-contentuploads/2018/03/Screen-Shot-2018-03-14-at-2.07.32-PM.png\\\" srcset=\\\"/wp-contentuploads/2018/03/Screen-Shot-2018-03-14-at-2.07.32-PM.png 1108w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-14-at-2.07.32-PM-300x149.png 300w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-14-at-2.07.32-PM-768x382.png 768w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-14-at-2.07.32-PM-1024x509.png 1024w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-14-at-2.07.32-PM-330x164.png 330w, /uploads/articles/ux-psychology-principles-design-ux/inline-56.png 736w, /wp-contentuploads/2018/03/Screen-Shot-2018-03-14-at-2.07.32-PM-414x206.png 414w\\\" width=\\\"1108\\\"/>\\x3Cp class=\\\"wp-caption-text\\\" id=\\\"caption-attachment-11678\\\">\\x3Cem>\u064a\u0633\u062a\u062e\u062f\u0645 Medium \u0632\u0631 CTA \u0623\u062e\u0636\u0631 \u0627\u0644\u0644\u0648\u0646 \u064a\u062a\u0628\u0627\u064a\u0646 \u0645\u0639 \u0623\u0644\u0648\u0627\u0646 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0644\u062c\u0630\u0628 \u0627\u0644\u0627\u0646\u062a\u0628\u0627\u0647 \u0625\u0644\u064a\u0647. (\u0645\u0635\u062f\u0631:\\x3Ca href=\\\"http://www.medium.com\\\" rel=\\\"noopener\\\" target=\\\"_blank\\\">www.medium.com\\x3C/a>) \\x3C/em>\\x3C/p>\\x3C/div>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0644\u0643\u0646 \u0636\u0639 \u0641\u064a \u0627\u0639\u062a\u0628\u0627\u0631\u0643 \u0623\u0646\u0647 \u064a\u062c\u0628 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0628\u062f\u0623 Von Restorff \u0628\u0627\u0639\u062a\u062f\u0627\u0644. \u0642\u062f \u062a\u0624\u062f\u064a \u0645\u062d\u0627\u0648\u0644\u0629 \u0625\u0628\u0631\u0627\u0632 \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0625\u0644\u0649 \u0625\u0631\u0628\u0627\u0643 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0628\u0643\u0644 \u0645\u0627 \u064a\u062d\u062f\u062b \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629 \u0648\u0641\u0642\u062f\u0627\u0646 \u0627\u0644\u062a\u0631\u0643\u064a\u0632. \u062a\u0630\u0643\u0631 \u0623\u0646 \u0627\u0644\u0623\u0642\u0644 \u0647\u0648 \u0627\u0644\u0623\u0643\u062b\u0631.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Ca name=\\\"Visceral_Reactions\\\">\\x3C/a>\\x3Cb>9. \u0627\u0644\u062a\u0641\u0627\u0639\u0644\u0627\u062a \u0627\u0644\u062d\u0634\u0648\u064a\u0629\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0647\u0644 \u0635\u0627\u062f\u0641\u062a \u064a\u0648\u0645\u064b\u0627 \u0645\u0648\u0642\u0639\u064b\u0627 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u064b\u0627 \u0644\u0627 \u062a\u0631\u063a\u0628 \u0641\u064a \u0645\u063a\u0627\u062f\u0631\u062a\u0647 \u0646\u0638\u0631\u064b\u0627 \u0644\u062c\u0645\u0627\u0644\u0647\u061f\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0647\u0630\u0627 \u0627\u0644\u0634\u0639\u0648\u0631 \u0647\u0648 \u0631\u062f \u0641\u0639\u0644 \u0639\u0645\u064a\u0642. \u0625\u0646\u0647\u0627 \u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u063a\u0631\u064a\u0632\u064a\u0629 \u0644\u0645\u062d\u0641\u0632 \u0623\u0648 \u062a\u062c\u0631\u0628\u0629 \u062a\u0645 \u0625\u0646\u0634\u0627\u0624\u0647\u0627 \u0628\u0648\u0627\u0633\u0637\u0629 \u0631\u0633\u0627\u0626\u0644 \u0643\u064a\u0645\u064a\u0627\u0626\u064a\u0629 \u0641\u064a \u062f\u0645\u0627\u063a\u0646\u0627. \u0625\u0646 \u0625\u062b\u0627\u0631\u0629 \u0631\u062f\u0648\u062f \u0627\u0644\u0641\u0639\u0644 \u0627\u0644\u0639\u0645\u064a\u0642\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0633\u0648\u0641 \u064a\u062c\u0639\u0644 \u0627\u0644\u0632\u0648\u0627\u0631 \u064a\u0639\u0648\u062f\u0648\u0646 \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u0645\u0632\u064a\u062f.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\\x3Cstrong>\u064a\u062a\u062e\u0630 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0642\u0631\u0627\u0631\u064b\u0627 \u0641\u064a \u062c\u0632\u0621 \u0645\u0646 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u062d\u0648\u0644 \u0645\u0627 \u064a\u0634\u0639\u0631\u0648\u0646 \u0628\u0647 \u062a\u062c\u0627\u0647 \u062a\u0635\u0645\u064a\u0645 \u0645\u0639\u064a\u0646 \u0628\u0645\u062c\u0631\u062f \u0631\u0624\u064a\u062a\u0647.\\x3C/strong> \u0625\u0630\u0627 \u062f\u062e\u0644\u0648\u0627 \u0625\u0644\u0649 \u0645\u0648\u0642\u0639 \u0648\u0644\u0645 \u064a\u0643\u0646 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u062c\u0630\u0627\u0628\u064b\u0627 \u0639\u0644\u0649 \u0627\u0644\u0641\u0648\u0631\u060c \u0641\u0642\u062f \u0644\u0627 \u064a\u0628\u0642\u0648\u0646 \u0641\u064a\u0647 \u0644\u0641\u062a\u0631\u0629 \u0637\u0648\u064a\u0644\u0629 \u062c\u062f\u064b\u0627.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0625\u0646 \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0631\u062f \u0641\u0639\u0644 \u0639\u0645\u064a\u0642 \u0645\u0646 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0643 \u0648\u0627\u0644\u0630\u064a \u064a\u0648\u0644\u062f \u0631\u062f \u0641\u0639\u0644 \u0633\u0644\u0648\u0643\u064a \u0625\u064a\u062c\u0627\u0628\u064a \u0641\u064a\u0647\u0645 \u0633\u064a\u0633\u0627\u0639\u062f\u0643 \u0639\u0644\u0649 \u0643\u0633\u0628 \u0648\u0644\u0627\u0626\u0647\u0645 \u0648\u062f\u0639\u0645\u0647\u0645\u060c \u0645\u0645\u0627 \u0633\u064a\u0633\u0627\u0639\u062f \u0628\u062f\u0648\u0631\u0647 \u0641\u064a \u062a\u0637\u0648\u064a\u0631 \u0635\u0648\u0631\u0629 \u0623\u0641\u0636\u0644 \u0644\u0639\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\\x3Cstrong>\u064a\u0645\u0643\u0646 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0628\u0633\u064a\u0637\u0629 \u0645\u062b\u0644 \u0627\u0644\u062e\u0637\u0648\u0637 \u0648\u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0648\u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0627\u062a \u0639\u0648\u0627\u0645\u0644 \u062a\u062d\u062f\u062f \u0627\u0644\u0645\u0638\u0647\u0631 \u0627\u0644\u0639\u0627\u0645 \u0644\u0644\u0645\u0648\u0642\u0639.\\x3C/strong> \u064a\u0634\u0639\u0631 \u0627\u0644\u0623\u0634\u062e\u0627\u0635 \u0628\u0631\u0627\u062d\u0629 \u0623\u0643\u0628\u0631 \u062a\u062c\u0627\u0647 \u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u062a\u064a \u064a\u0645\u0643\u0646\u0647\u0645 \u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637 \u0628\u0647\u0627\u060c \u0644\u0630\u0644\u0643 \u0623\u062b\u0646\u0627\u0621 \u0625\u0646\u0634\u0627\u0621 \u062a\u062c\u0631\u0628\u0629 \u0641\u0631\u064a\u062f\u0629\u060c \u0636\u0639 \u0641\u064a \u0627\u0639\u062a\u0628\u0627\u0631\u0643 \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u0623\u0644\u0641\u0629 \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cdiv class=\\\"wp-caption alignleft\\\" id=\\\"attachment_11680\\\" style=\\\"width: 967px\\\">\\x3Cimg alt=\\\"Airbnb homepage\\\" aria-describedby=\\\"caption-attachment-11680\\\" class=\\\"size-full wp-image-11680\\\" decoding=\\\"async\\\" height=\\\"635\\\" loading=\\\"lazy\\\" sizes=\\\"(max-width: 957px) 100vw, 957px\\\" src=\\\"/wp-contentuploads/2018/03/7f0U8ziDfc5Vgb0ETxArnsw8JpBkB2fNFf86qvkVBdmkmGu86MMs6dDJ_60K57zpSKZAowJRPww0w97Et0ji1i_zJ5VhR_WljFsPkfVz7T5JUeG577MEV2TMfrG44oYUuo0N-sBL.png\\\" srcset=\\\"/wp-contentuplo