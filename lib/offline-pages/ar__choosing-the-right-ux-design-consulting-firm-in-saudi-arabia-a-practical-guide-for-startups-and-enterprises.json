u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0648\u0625\u062d\u0628\u0627\u0637 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cb>\u062e\u0627\u062a\u0645\u0629\\x3C/b>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u064a\u0633\u0627\u0639\u062f \u0623\u062e\u0630 \u0639\u0644\u0645 \u0627\u0644\u0646\u0641\u0633 \u0641\u064a \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643 \u0641\u064a \u062a\u062d\u0642\u064a\u0642 \u0623\u0647\u062f\u0627\u0641 \u0627\u0644\u0639\u0645\u0644 \u0645\u0639 \u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0645\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646. \u064a\u0639\u062f \u0641\u0647\u0645 \u0643\u064a\u0641\u064a\u0629 \u0625\u062f\u0631\u0627\u0643 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0648\u062a\u0641\u0633\u064a\u0631\u0647 \u0623\u062d\u062f \u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u0645\u0647\u0645\u0629 \u0627\u0644\u062a\u064a \u064a\u062c\u0628 \u0623\u0646 \u064a\u0645\u062a\u0644\u0643\u0647\u0627 \u0627\u0644\u0645\u0635\u0645\u0645\u0648\u0646.\\x3C/span>\\x3C/p>\\n\\x3Cp>\u0627\u062a\u0628\u0639 \u0623\u0641\u0636\u0644 \u0645\u0645\u0627\u0631\u0633\u0627\u062a \u0633\u0647\u0648\u0644\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0644\u062a\u0644\u0628\u064a\u0629 \u0645\u0628\u0627\u062f\u0626 \u0633\u0647\u0648\u0644\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645. \u062a\u0645\u0643\u064a\u0646 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u062a\u0639\u0644\u0645 \u0648\u0627\u0644\u0643\u0641\u0627\u0621\u0629 \u0648\u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u062a\u0630\u0643\u0631 \u0644\u0646\u0638\u0627\u0645\u0643. \u0627\u0644\u0627\u0633\u062a\u0641\u0627\u062f\u0629 \u0645\u0646 \u0627\u0644\u0645\u0628\u0627\u062f\u0626 \u0627\u0644\u0646\u0641\u0633\u064a\u0629 \u0644\u062a\u0648\u062c\u064a\u0647 \u0633\u0644\u0648\u0643 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0623\u062e\u0644\u0627\u0642\u064a\u0627. \u0623\u0646\u0634\u0626 \u062a\u062c\u0627\u0631\u0628 \u0633\u0644\u0633\u0629 \u0644\u062a\u0639\u0632\u064a\u0632 \u0645\u0639\u062f\u0644\u0627\u062a \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0648\u0631\u0636\u0627 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646.\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0633\u064a\u062d\u062a\u0627\u062c \u0623\u064a \u062a\u0635\u0645\u064a\u0645 \u0646\u0627\u062c\u062d \u0625\u0644\u0649 \u0627\u0644\u062a\u062d\u062f\u064a\u062b \u0645\u0646 \u0648\u0642\u062a \u0644\u0622\u062e\u0631\u060c \u0648\u0644\u0643\u0646 \u0623\u0641\u0636\u0644 \u062c\u0632\u0621 \u0641\u064a \u0645\u0628\u0627\u062f\u0626 \u0639\u0644\u0645 \u0627\u0644\u0646\u0641\u0633 \u0647\u0648 \u0623\u0646\u0647\u0627 \u062d\u0644\u0648\u0644 \u062e\u0627\u0644\u062f\u0629 \u0644\u062a\u0635\u0645\u064a\u0645\u0627\u062a\u0643.\\x3C/span>\\x3C/p>\\n\\x3Cp> \\x3C/p>\\n\\x3Cp>\\x3Cem>\u0641\u064a UXBERT Labs\u060c \u0646\u062d\u0646 \u0645\u062a\u062e\u0635\u0635\u0648\u0646 \u0641\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0639\u0645\u0644\u064a\u0627\u062a UCD \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0644\u062a\u0635\u0645\u064a\u0645 \u062a\u062c\u0627\u0631\u0628 \u0645\u0628\u062a\u0643\u0631\u0629 \u0648\u062c\u0645\u064a\u0644\u0629 \u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0639\u0627\u0644\u0645\u064a. \u0645\u0639 \u0641\u0631\u0642 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u062a\u062e\u0635\u0635\u0629 \u0641\u064a \u062f\u0628\u064a \u0648\u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0633\u0646\u0642\u0648\u0645 \u0628\u062a\u0635\u0645\u064a\u0645 \u0648\u0628\u0646\u0627\u0621 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u062a\u064a \u0633\u062a\u0633\u0627\u0639\u062f \u0623\u0639\u0645\u0627\u0644\u0643 \u0639\u0644\u0649 \u0627\u0644\u0646\u062c\u0627\u062d. \u0625\u0630\u0627 \u0643\u0627\u0646 \u0644\u062f\u064a\u0643 \u0645\u0634\u0631\u0648\u0639 \u062a\u0631\u063a\u0628 \u0641\u064a \u0627\u0644\u0639\u0645\u0644 \u0645\u0639\u0646\u0627 \u0639\u0644\u064a\u0647\u060c \u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 \u0639\u0644\u0649\\x3C/em> hello@uxbert.com\\x3C/p>\\n\",protected:!1},excerpt:$R[185]={rendered:\"\\x3Cp>\u0646\u062a\u0646\u0627\u0648\u0644 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0645\u0642\u0627\u0644\u0629 \u0628\u0627\u0644\u062a\u0641\u0635\u064a\u0644 13 \u0645\u0628\u062f\u0623 \u0646\u0641\u0633\u064a\u064b\u0627 \u064a\u062c\u0628 \u0639\u0644\u0649 \u0645\u0635\u0645\u0645\u064a \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u0647\u0645\u0647\u0627 \u0648\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0627 \u0639\u0646\u062f \u062a\u0635\u0645\u064a\u0645 \u0623\u064a \u0645\u0646\u062a\u062c.\\x3C/p>\\n\",protected:!1},author:3,featured_media:37597,comment_status:\"closed\",ping_status:\"closed\",sticky:!1,template:\"\",format:\"standard\",meta:$R[186]={_acf_changed:!1,inline_featured_image:!1,_mi_skip_tracking:!1,footnotes:\"\",_vp_format_video_url:\"\",_vp_image_focal_point:$R[187]=[]},categories:$R[188]=[9,203,12,196],tags:$R[189]=[34,199,86,187,100,104],acf:$R[190]={main:\"/uploads/articles/ux-psychology-principles-design-ux/main.png\",sec:\"/uploads/articles/ux-psychology-principles-design-ux/sec.png\"},category_objects:$R[191]=[$R[192]={id:9,count:3,description:\"\",link:\"/category/interaction-design\",name:\"Interaction Design\",slug:\"interaction-design\",taxonomy:\"category\",parent:0,meta:$R[193]=[]},$R[170],$R[102],$R[194]={id:196,count:2,description:\"\",link:\"/category/web-development\",name:\"Web Development\",slug:\"web-development\",taxonomy:\"category\",parent:0,meta:$R[195]=[]}],tag_objects:$R[196]=[$R[175],$R[197]={id:199,count:2,description:\"\",link:\"/tag/emotional-design\",name:\"emotional design\",slug:\"emotional-design\",taxonomy:\"post_tag\",meta:$R[198]=[]},$R[199]={id:86,count:2,description:\"\",link:\"/tag/psychology\",name:\"Psychology\",slug:\"psychology\",taxonomy:\"post_tag\",meta:$R[200]=[]},$R[201]={id:187,count:1,description:\"\",link:\"/tag/ui-design\",name:\"UI Design\",slug:\"ui-design\",taxonomy:\"post_tag\",meta:$R[202]=[]},$R[203]={id:100,count:3,description:\"\",link:\"/tag/usability-guidelines\",name:\"usability guidelines\",slug:\"usability-guidelines\",taxonomy:\"post_tag\",meta:$R[204]=[]},$R[205]={id:104,count:5,description:\"\",link:\"/tag/user-experience-design\",name:\"user experience design\",slug:\"user-experience-design\",taxonomy:\"post_tag\",meta:$R[206]=[]}]},$R[207]={id:10944,date:\"2018-02-07T10:35:50\",date_gmt:\"2018-02-07T10:35:50\",guid:$R[208]={rendered:\"/?p=10944\"},modified:\"2026-02-19T11:33:17\",modified_gmt:\"2026-02-19T11:33:17\",slug:\"usability-engineering-saudi-arabia-e-commerce-website-souq-com\",status:\"publish\",link:\"/usability-engineering-saudi-arabia-e-commerce-website-souq-com\",title:$R[209]={rendered:\"\u0647\u0646\u062f\u0633\u0629 \u0633\u0647\u0648\u0644\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629: \u0645\u0648\u0642\u0639 \u0627\u0644\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0633\u0648\u0642.\u0643\u0648\u0645\"},content:$R[210]={rendered:\"\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0641\u064a \u0627\u0644\u062c\u0632\u0621 \u0627\u0644\u0623\u0648\u0644 \u0645\u0646 \u0633\u0644\u0633\u0644\u0629 \u0647\u0646\u062f\u0633\u0629 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u060c \u0642\u0645\u0646\u0627 \u0628\u0625\u062c\u0631\u0627\u0621 \u0628\u0639\u0636 \u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0633\u0631\u064a\u0639\u0629 \u0639\u0644\u0649 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644\\x3Ca href=\\\"/ar/usability-engineering-saudi-arabia-ministry-of-interior/\\\" rel=\\\"noopener\\\" target=\\\"_blank\\\">\u0645\u0648\u0642\u0639 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\\x3C/a>. \u0643\u0627\u0646 \u0627\u0644\u0647\u062f\u0641 \u0647\u0648 \u0625\u0638\u0647\u0627\u0631 \u0643\u064a\u0641 \u064a\u0645\u0643\u0646 \u0644\u0623\u0628\u0633\u0637 \u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0623\u0646 \u062a\u0633\u0644\u0637 \u0627\u0644\u0636\u0648\u0621 \u0639\u0644\u0649 \u0639\u064a\u0648\u0628 \u0643\u0628\u064a\u0631\u0629 \u0641\u064a \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0641\u064a \u062a\u0635\u0645\u064a\u0645\u0643.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0628\u0627\u0644\u0627\u0628\u062a\u0639\u0627\u062f \u0639\u0646 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629\u060c \u0633\u0646\u062a\u0646\u0627\u0648\u0644 \u0641\u064a \u0645\u0642\u0627\u0644\u062a\u0646\u0627 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0633\u0644\u0633\u0644\u0629 \u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0639\u0644\u0649 \u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u062a\u0639\u062f \u0645\u0648\u0627\u0642\u0639 (\u0648\u062a\u0637\u0628\u064a\u0642\u0627\u062a) \u0627\u0644\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0645\u0631\u0634\u062d\u0629 \u0631\u0627\u0626\u0639\u0629 \u0644\u062a\u0642\u064a\u064a\u0645 \u0633\u0647\u0648\u0644\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u060c \u062d\u064a\u062b \u0623\u0646 \u0623\u0635\u063a\u0631 \u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u0644\u0623\u0641\u0643\u0627\u0631 \u0627\u0644\u062a\u064a \u062a\u0645 \u062c\u0645\u0639\u0647\u0627 \u0645\u0646 \u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u064a\u0645\u0643\u0646 \u0623\u0646 \u062a\u0624\u062f\u064a \u0625\u0644\u0649 \u0632\u064a\u0627\u062f\u0629 \u0643\u0628\u064a\u0631\u0629 \u0641\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a.\\x3C/span>\\x3C/p>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0648\u0623\u0641\u0636\u0644 \u0645\u062b\u0627\u0644 \u0639\u0644\u0649 \u0630\u0644\u0643 \u0647\u0648\\x3Ca href=\\\"https://articles.uie.com/three_hund_million_button/\\\" rel=\\\"noopener\\\" target=\\\"_blank\\\">\u062f\u0631\u0627\u0633\u0629 \u062d\u0627\u0644\u0629 \u0632\u0631 \u0628\u0642\u064a\u0645\u0629 300 \u0645\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631 \u0623\u062c\u0631\u0627\u0647\u0627 \u062c\u0627\u0631\u064a\u062f \u0633\u0628\u0648\u0644 \u0648UIE\\x3C/a>\u062d\u064a\u062b \u0623\u062f\u0649 \u062a\u063a\u064a\u064a\u0631 \u0648\u0627\u062d\u062f \u0641\u064a \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0641\u064a \u0631\u062d\u0644\u0629 \u0627\u0644\u062f\u0641\u0639 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0631\u0624\u0649 \u0645\u0646 \u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0625\u0644\u0649 \u0632\u064a\u0627\u062f\u0629 \u0641\u064a \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0634\u0631\u0627\u0621 \u0628\u0646\u0633\u0628\u0629 45%.\\x3C/span>\\x3C/p>\\n\\x3Ch2>\\x3Cb>\u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631: \u0633\u0648\u0642.\u0643\u0648\u0645\\x3C/b>\\x3C/h2>\\n\\x3Cp>\\x3Cspan style=\\\"font-weight: 400;\\\">\u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0647\u0630\u0647 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0646 \u062c\u0644\u0633\u0627\u062a \u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u060c \u0637\u0644\u0628\u0646\u0627 \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u062a\u0635\u0641\u062d \u0648\u0627\u062e\u062a\u064a\u0627\u0631 \u0648\u0634\u0631\u0627\u0621 \u062c\u0647\u0627\u0632 \u0643\u0645\u0628\u064a\u0648\u062a\u0631 \u0645\u062d\u0645\u0648\u0644 \u0641\u064a \u0633\u0648\u0642 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 (\\x3Ca href=\\\"https://saudi.souq.com/sa-ar/\\\" rel=\\\"noopener\\\" target=\\\"_blank\\\">saudi.souq.com\\x3C/a>) \u0645\u0648\u0642\u0639 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a.\\x3C/span>\\x3C/p>\\n\\x3Cp>\u0633\u0648\u0642.\u0643\u0648\u0645 \u0639\u0628\u0627\u0631\u0629 \u0639\u0646 \u0645\u0646\u0635\u0629 \u0644\u0644\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0628\u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0648\u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u062a\u0628\u064a\u0639 \u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0646 \u0627\u0644\u0645\u