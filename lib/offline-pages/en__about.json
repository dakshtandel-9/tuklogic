,\"name\":\"United Arab Emirates\"},{\"@type\":\"Country\",\"name\":\"United Kingdom\"}],\"sameAs\":[\"https://www.linkedin.com/\",\"https://www.linkedin.com/\",\"https://www.linkedin.com/\",\"https://www.youtube.com/\",\"https://www.linkedin.com/\"],\"founder\":{\"@type\":\"Person\",\"@id\":\"https://uxbert.com/#founder\",\"name\":\"Hussam Al-Khateeb\",\"jobTitle\":\"Founder & CEO\",\"worksFor\":{\"@id\":\"https://uxbert.com/#organization\"}},\"author\":{\"@type\":\"Organization\",\"@id\":\"https://uxbert.com/#organization\",\"name\":\"UXBERT Labs\"}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"@id\":\"https://uxbert.com/#faq\",\"inLanguage\":\"en\",\"isPartOf\":{\"@id\":\"https://uxbert.com/#website\"},\"about\":{\"@id\":\"https://uxbert.com/#organization\"},\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What does UXBERT Labs do?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"UXBERT Labs is an award-winning UX/UI design, research, and development agency. We help enterprise and government clients across Saudi Arabia, the UAE, and the UK design and ship digital products that real people actually want to use — covering user research, customer experience, service design, design systems, web and mobile development, and AI experience design.\"}},{\"@type\":\"Question\",\"name\":\"Where is UXBERT based?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"UXBERT is headquartered in Riyadh, Saudi Arabia, with offices in Dubai (UAE) and London (UK).\"}},{\"@type\":\"Question\",\"name\":\"Which industries does UXBERT work with?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"UXBERT serves enterprise and government clients across banking, fintech, telecom, healthcare, retail, public sector, and high-growth scale-ups in the GCC and beyond.\"}},{\"@type\":\"Question\",\"name\":\"How do I start a project with UXBERT?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Reach the UXBERT team via the contact form at https://uxbert.com/en/contact, by email at hello@uxbert.com, or by phone at +966 55 517 5057. A consultant will respond within one business day to scope your project.\"}},{\"@type\":\"Question\",\"name\":\"Does UXBERT offer training and workshops?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. UXBERT runs UX and usability training, facilitated workshops, and a UX audit and certification programme. Details are at https://uxbert.com/en/training.\"}},{\"@type\":\"Question\",\"name\":\"Does UXBERT work in Arabic?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. The full UXBERT site is bilingual (English and Arabic, RTL) and we routinely deliver research, design, and engineering in both languages for clients across the Arab world.\"}}]}</script><form class=\"sr-only\" inert=\"\" tool-name=\"submit_uxbert_enquiry\" tool-description=\"Submit a project, partnership, or general enquiry to UXBERT Labs. A consultant follows up by email within one business day.\" action=\"/api/contact\" method=\"post\"><label for=\"webmcp-enquiry-name\">Name<input id=\"webmcp-enquiry-name\" type=\"text\" autoComplete=\"name\" tool-param-description=\"Full name of the requester. Supports Latin and Arabic characters.\" name=\"name\"/></label><label for=\"webmcp-enquiry-email\">Email<input id=\"webmcp-enquiry-email\" type=\"email\" autoComplete=\"email\" tool-param-description=\"Reply-to email address.\" name=\"email\"/></label><label for=\"webmcp-enquiry-message\">Message<textarea id=\"webmcp-enquiry-message\" name=\"message\" tool-param-description=\"Free-form description of the project, partnership, or question.\"></textarea></label><label for=\"webmcp-enquiry-company\">Company<input id=\"webmcp-enquiry-company\" type=\"text\" autoComplete=\"organization\" tool-param-description=\"Company or organization name (optional).\" name=\"company\"/></label><label for=\"webmcp-enquiry-phone\">Phone<input id=\"webmcp-enquiry-phone\" type=\"tel\" autoComplete=\"tel\"